/* ═══════════════════════════════════════════════════════════════
   Parseval – Serie de Medio Rango (coseno y seno)
   Requiere: FUNC_INPUT, INTVAR, PERIOD, Coeff_A0, Coeff_An, Coeff_Bn, const_factor
   Coseno despejada: (LHS - a0Term) / K_cos = Σ(summand_cos)
   Seno despejada:   LHS / K_sin = Σ(summand_sin)
   ═══════════════════════════════════════════════════════════════ */

declare(n, integer)$
errcatch(assume(n > 0))$

_An: factor(fullratsimp(Coeff_An))$
_Bn: factor(fullratsimp(Coeff_Bn))$

block(
    [_f2_acum: 0],
    for _i:1 thru length(FUNC_INPUT) do (
        _f2_acum: _f2_acum + integrate(FUNC_INPUT[_i][1]^2, INTVAR,
                                       FUNC_INPUT[_i][2], FUNC_INPUT[_i][3])
    ),
    Parseval_LHS: factor(ratsimp(_f2_acum / PERIOD))
)$

/* Serie coseno */
block(
    [_an2: factor(ratsimp(_An^2)), _cf],
    _cf: const_factor(_an2, n),
    Parseval_Cos_K:       factor(_cf[1] / 2),
    Parseval_Cos_Summand: _cf[2]
)$
Parseval_Cos_A0_term: factor(Coeff_A0^2)$
Parseval_Cos_LHS_final: fullratsimp((Parseval_LHS - Parseval_Cos_A0_term) / fullratsimp(Parseval_Cos_K))$

/* Serie seno */
block(
    [_bn2: factor(ratsimp(_Bn^2)), _cf],
    _cf: const_factor(_bn2, n),
    Parseval_Sin_K:       factor(_cf[1] / 2),
    Parseval_Sin_Summand: _cf[2]
)$
Parseval_Sin_LHS_final: fullratsimp(Parseval_LHS / fullratsimp(Parseval_Sin_K))$

print("__PARSEVAL_LHS_MAXIMA__")$                  print(string(Parseval_LHS))$
print("__PARSEVAL_LHS_TEX__")$                     tex(Parseval_LHS)$
print("__PARSEVAL_COS_A0_TERM_MAXIMA__")$          print(string(Parseval_Cos_A0_term))$
print("__PARSEVAL_COS_A0_TERM_TEX__")$             tex(Parseval_Cos_A0_term)$
print("__PARSEVAL_COS_K_MAXIMA__")$                print(string(Parseval_Cos_K))$
print("__PARSEVAL_COS_K_TEX__")$                   tex(Parseval_Cos_K)$
print("__PARSEVAL_COS_SUMMAND_MAXIMA__")$          print(string(Parseval_Cos_Summand))$
print("__PARSEVAL_COS_SUMMAND_TEX__")$             tex(Parseval_Cos_Summand)$
print("__PARSEVAL_COS_LHS_FINAL_MAXIMA__")$        print(string(Parseval_Cos_LHS_final))$
print("__PARSEVAL_COS_LHS_FINAL_TEX__")$           tex(Parseval_Cos_LHS_final)$
print("__PARSEVAL_SIN_K_MAXIMA__")$                print(string(Parseval_Sin_K))$
print("__PARSEVAL_SIN_K_TEX__")$                   tex(Parseval_Sin_K)$
print("__PARSEVAL_SIN_SUMMAND_MAXIMA__")$          print(string(Parseval_Sin_Summand))$
print("__PARSEVAL_SIN_SUMMAND_TEX__")$             tex(Parseval_Sin_Summand)$
print("__PARSEVAL_SIN_LHS_FINAL_MAXIMA__")$        print(string(Parseval_Sin_LHS_final))$
print("__PARSEVAL_SIN_LHS_FINAL_TEX__")$           tex(Parseval_Sin_LHS_final)$
