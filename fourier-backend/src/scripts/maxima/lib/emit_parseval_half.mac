/* ═══════════════════════════════════════════════════════════════
   Parseval – Serie de Medio Rango (coseno y seno)
   Requiere: FUNC_INPUT, INTVAR, PERIOD, Coeff_A0, Coeff_An, Coeff_Bn, const_factor
   ═══════════════════════════════════════════════════════════════ */

/* ── LHS (no depende de n) ── */
block(
    [_f2_acum: 0],
    for _i:1 thru length(FUNC_INPUT) do (
        _f2_acum: _f2_acum + integrate(FUNC_INPUT[_i][1]^2, INTVAR,
                                       FUNC_INPUT[_i][2], FUNC_INPUT[_i][3])
    ),
    Parseval_LHS: factor(ratsimp(_f2_acum / PERIOD))
)$

Parseval_Cos_A0_term: factor(Coeff_A0^2)$

/* ── Versiones formales (sin declare(n, integer)) ── */
errcatch(assume(n > 0))$

/* Coseno formal */
block(
    [_an2_f: factor(ratsimp(Coeff_An^2)), _cf_f],
    _cf_f: const_factor(_an2_f, n),
    Parseval_Cos_Formal_K:       factor(_cf_f[1] / 2),
    Parseval_Cos_Formal_Summand: _cf_f[2]
)$

Parseval_Cos_Formal_LHS_final: fullratsimp(
    (Parseval_LHS - Parseval_Cos_A0_term) / fullratsimp(Parseval_Cos_Formal_K))$

/* Seno formal */
block(
    [_bn2_f: factor(ratsimp(Coeff_Bn^2)), _cf_f],
    _cf_f: const_factor(_bn2_f, n),
    Parseval_Sin_Formal_K:       factor(_cf_f[1] / 2),
    Parseval_Sin_Formal_Summand: _cf_f[2]
)$

Parseval_Sin_Formal_LHS_final: fullratsimp(
    Parseval_LHS / fullratsimp(Parseval_Sin_Formal_K))$

/* ── Versiones simplificadas (con declare(n, integer)) ── */
declare(n, integer)$

_An: factor(fullratsimp(Coeff_An))$
_Bn: factor(fullratsimp(Coeff_Bn))$

/* Serie coseno */
block(
    [_an2: factor(ratsimp(_An^2)), _cf],
    _cf: const_factor(_an2, n),
    Parseval_Cos_K:       factor(_cf[1] / 2),
    Parseval_Cos_Summand: _cf[2]
)$

block(
    [_denom, _roots_wrap, _roots_raw, _all_sing_vals, _sing_terms, _sing_vals],
    _denom: denom(factor(Parseval_Cos_Summand)),
    _roots_wrap: errcatch(solve(_denom = 0, n)),
    _roots_raw: if _roots_wrap = [] then []
                else block([_r: first(_roots_wrap)],
                    if listp(_r) then _r else []),
    _all_sing_vals: map(rhs,
        sublist(_roots_raw,
            lambda([eq], integerp(rhs(eq)) and is(rhs(eq) >= 1)))),
    _sing_terms: sublist(
        map(lambda([k],
            block([_flim: errcatch(limit(Parseval_Cos_Formal_Summand, n, k)), _v],
                _v: if _flim = [] then 0
                    else fullratsimp(Parseval_Cos_Formal_K * first(_flim) / fullratsimp(Parseval_Cos_K)),
                [k, factor(_v)])),
            _all_sing_vals),
        lambda([t], not is(second(t) = 0))),
    _sing_vals: map(first, _sing_terms),
    Parseval_Cos_sing_vals: _sing_vals,
    Parseval_Cos_has_singular: not is(_sing_vals = []),
    Parseval_Cos_sum_start: if _sing_vals = [] then 1 else lmax(_sing_vals) + 1,
    Parseval_Cos_LHS_final: fullratsimp(
        (Parseval_LHS - Parseval_Cos_A0_term) / fullratsimp(Parseval_Cos_K)),
    Parseval_Cos_sing_terms: _sing_terms
)$

/* Serie seno */
block(
    [_bn2: factor(ratsimp(_Bn^2)), _cf],
    _cf: const_factor(_bn2, n),
    Parseval_Sin_K:       factor(_cf[1] / 2),
    Parseval_Sin_Summand: _cf[2]
)$

block(
    [_denom, _roots_wrap, _roots_raw, _all_sing_vals, _sing_terms, _sing_vals],
    _denom: denom(factor(Parseval_Sin_Summand)),
    _roots_wrap: errcatch(solve(_denom = 0, n)),
    _roots_raw: if _roots_wrap = [] then []
                else block([_r: first(_roots_wrap)],
                    if listp(_r) then _r else []),
    _all_sing_vals: map(rhs,
        sublist(_roots_raw,
            lambda([eq], integerp(rhs(eq)) and is(rhs(eq) >= 1)))),
    _sing_terms: sublist(
        map(lambda([k],
            block([_flim: errcatch(limit(Parseval_Sin_Formal_Summand, n, k)), _v],
                _v: if _flim = [] then 0
                    else fullratsimp(Parseval_Sin_Formal_K * first(_flim) / fullratsimp(Parseval_Sin_K)),
                [k, factor(_v)])),
            _all_sing_vals),
        lambda([t], not is(second(t) = 0))),
    _sing_vals: map(first, _sing_terms),
    Parseval_Sin_sing_vals: _sing_vals,
    Parseval_Sin_has_singular: not is(_sing_vals = []),
    Parseval_Sin_sum_start: if _sing_vals = [] then 1 else lmax(_sing_vals) + 1,
    Parseval_Sin_LHS_final: fullratsimp(Parseval_LHS / fullratsimp(Parseval_Sin_K)),
    Parseval_Sin_sing_terms: _sing_terms
)$

print("__PARSEVAL_COS_SING_TERMS_START__")$
for _t in Parseval_Cos_sing_terms do (
    print("__SING_TERM_N__"),
    print(string(first(_t))),
    print("__SING_TERM_MAXIMA__"),
    print(string(second(_t))),
    print("__SING_TERM_TEX__"),
    tex(second(_t))
)$
print("__PARSEVAL_COS_SING_TERMS_END__")$
print("__PARSEVAL_SIN_SING_TERMS_START__")$
for _t in Parseval_Sin_sing_terms do (
    print("__SING_TERM_N__"),
    print(string(first(_t))),
    print("__SING_TERM_MAXIMA__"),
    print(string(second(_t))),
    print("__SING_TERM_TEX__"),
    tex(second(_t))
)$
print("__PARSEVAL_SIN_SING_TERMS_END__")$
print("__PARSEVAL_LHS_MAXIMA__")$                  print(string(Parseval_LHS))$
print("__PARSEVAL_LHS_TEX__")$                     tex(Parseval_LHS)$
print("__PARSEVAL_COS_A0_TERM_MAXIMA__")$          print(string(Parseval_Cos_A0_term))$
print("__PARSEVAL_COS_A0_TERM_TEX__")$             tex(Parseval_Cos_A0_term)$
print("__PARSEVAL_COS_K_MAXIMA__")$                print(string(Parseval_Cos_K))$
print("__PARSEVAL_COS_K_TEX__")$                   tex(Parseval_Cos_K)$
print("__PARSEVAL_COS_SUMMAND_MAXIMA__")$          print(string(Parseval_Cos_Summand))$
print("__PARSEVAL_COS_SUMMAND_TEX__")$             tex(Parseval_Cos_Summand)$
print("__PARSEVAL_COS_LHS_FINAL_MAXIMA__")$        print(string(Parseval_Cos_LHS_final))$
print("__PARSEVAL_COS_LHS_FINAL_TEX__")$           tex(Parseval_Cos_LHS_final)$
print("__PARSEVAL_COS_SUM_START__")$               print(string(Parseval_Cos_sum_start))$
print("__PARSEVAL_COS_HAS_SINGULAR__")$            print(string(Parseval_Cos_has_singular))$
print("__PARSEVAL_COS_SING_VALS__")$               print(string(Parseval_Cos_sing_vals))$
print("__PARSEVAL_SIN_K_MAXIMA__")$                print(string(Parseval_Sin_K))$
print("__PARSEVAL_SIN_K_TEX__")$                   tex(Parseval_Sin_K)$
print("__PARSEVAL_SIN_SUMMAND_MAXIMA__")$          print(string(Parseval_Sin_Summand))$
print("__PARSEVAL_SIN_SUMMAND_TEX__")$             tex(Parseval_Sin_Summand)$
print("__PARSEVAL_SIN_LHS_FINAL_MAXIMA__")$        print(string(Parseval_Sin_LHS_final))$
print("__PARSEVAL_SIN_LHS_FINAL_TEX__")$           tex(Parseval_Sin_LHS_final)$
print("__PARSEVAL_SIN_SUM_START__")$               print(string(Parseval_Sin_sum_start))$
print("__PARSEVAL_SIN_HAS_SINGULAR__")$            print(string(Parseval_Sin_has_singular))$
print("__PARSEVAL_SIN_SING_VALS__")$               print(string(Parseval_Sin_sing_vals))$
print("__PARSEVAL_COS_FORMAL_K_MAXIMA__")$         print(string(Parseval_Cos_Formal_K))$
print("__PARSEVAL_COS_FORMAL_K_TEX__")$            tex(Parseval_Cos_Formal_K)$
print("__PARSEVAL_COS_FORMAL_SUMMAND_MAXIMA__")$   print(string(Parseval_Cos_Formal_Summand))$
print("__PARSEVAL_COS_FORMAL_SUMMAND_TEX__")$      tex(Parseval_Cos_Formal_Summand)$
print("__PARSEVAL_COS_FORMAL_LHS_FINAL_MAXIMA__")$ print(string(Parseval_Cos_Formal_LHS_final))$
print("__PARSEVAL_COS_FORMAL_LHS_FINAL_TEX__")$    tex(Parseval_Cos_Formal_LHS_final)$
print("__PARSEVAL_SIN_FORMAL_K_MAXIMA__")$         print(string(Parseval_Sin_Formal_K))$
print("__PARSEVAL_SIN_FORMAL_K_TEX__")$            tex(Parseval_Sin_Formal_K)$
print("__PARSEVAL_SIN_FORMAL_SUMMAND_MAXIMA__")$   print(string(Parseval_Sin_Formal_Summand))$
print("__PARSEVAL_SIN_FORMAL_SUMMAND_TEX__")$      tex(Parseval_Sin_Formal_Summand)$
print("__PARSEVAL_SIN_FORMAL_LHS_FINAL_MAXIMA__")$ print(string(Parseval_Sin_Formal_LHS_final))$
print("__PARSEVAL_SIN_FORMAL_LHS_FINAL_TEX__")$    tex(Parseval_Sin_Formal_LHS_final)$
