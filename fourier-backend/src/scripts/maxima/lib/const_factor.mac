/* ═══════════════════════════════════════════════════════════════
   const_factor(expr, n)
   Splits a rational expression into [K, summand] such that
   expr = K * summand, where K is free of n.
   ═══════════════════════════════════════════════════════════════ */

const_factor(expr, n) := block(
    [num_raw, den_raw, sign, num_inner, num_args, den_args,
     const_num, n_num, const_den, n_den, K_raw, _neg],
    if freeof(n, expr) then return([expr, 1]),
    num_raw : num(expr),
    den_raw : denom(expr),
    sign : if atom(num_raw) then 1
           else if op(num_raw) = "-" then -1 else 1,
    num_inner : if (not atom(num_raw)) and op(num_raw) = "-"
                then args(num_raw)[1] else num_raw,
    num_args : if atom(num_inner) then [num_inner]
               else if op(num_inner) = "*" then args(num_inner)
               else [num_inner],
    den_args : if atom(den_raw) then [den_raw]
               else if op(den_raw) = "*" then args(den_raw)
               else [den_raw],
    const_num : apply("*", sublist(num_args, lambda([x], freeof(n, x)))),
    n_num     : apply("*", sublist(num_args, lambda([x], not freeof(n, x)))),
    const_den : apply("*", sublist(den_args, lambda([x], freeof(n, x)))),
    n_den     : apply("*", sublist(den_args, lambda([x], not freeof(n, x)))),
    if n_num = 1 and n_den = 1 then return([expr, 1]),
    K_raw : sign * const_num / const_den,
    /* Keep K positive: if Maxima can prove K < 0, move the sign to the summand.
       errcatch guards against unknown/error so we fall back gracefully. */
    _neg : errcatch(is(K_raw < 0)),
    if _neg = [true] then return([-K_raw, -(n_num / n_den)]),
    [K_raw, n_num / n_den]
)$
