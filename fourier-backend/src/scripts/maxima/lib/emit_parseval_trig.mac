/* ═══════════════════════════════════════════════════════════════
   Parseval – Serie Trigonométrica
   Requiere: FUNC_INPUT, INTVAR, PERIOD, Coeff_A0, Coeff_An, Coeff_Bn, const_factor
   Salida:
     Forma completa:   LHS = a0Term + K·Σ(summand)
     Forma despejada:  LHS_final = Σ(summand)
       donde LHS_final = (LHS - a0Term) / K
   ═══════════════════════════════════════════════════════════════ */

declare(n, integer)$
errcatch(assume(n > 0))$

_An: factor(fullratsimp(Coeff_An))$
_Bn: factor(fullratsimp(Coeff_Bn))$

block(
    [_f2_acum: 0],
    for _i:1 thru length(FUNC_INPUT) do (
        _f2_acum: _f2_acum + integrate(FUNC_INPUT[_i][1]^2, INTVAR,
                                       FUNC_INPUT[_i][2], FUNC_INPUT[_i][3])
    ),
    Parseval_LHS: factor(ratsimp(_f2_acum / PERIOD))
)$

block(
    [_an2bn2: factor(trigsimp(ratsimp(_An^2 + _Bn^2))), _cf],
    _cf: const_factor(_an2bn2, n),
    Parseval_K:       factor(_cf[1] / 2),
    Parseval_Summand: _cf[2]
)$

Parseval_A0_term: factor(Coeff_A0^2)$

/* Forma despejada: (LHS - a0Term) / K = Σ(summand) */
Parseval_LHS_final: fullratsimp((Parseval_LHS - Parseval_A0_term) / fullratsimp(Parseval_K))$

print("__PARSEVAL_LHS_MAXIMA__")$          print(string(Parseval_LHS))$
print("__PARSEVAL_LHS_TEX__")$             tex(Parseval_LHS)$
print("__PARSEVAL_A0_TERM_MAXIMA__")$      print(string(Parseval_A0_term))$
print("__PARSEVAL_A0_TERM_TEX__")$         tex(Parseval_A0_term)$
print("__PARSEVAL_K_MAXIMA__")$            print(string(Parseval_K))$
print("__PARSEVAL_K_TEX__")$               tex(Parseval_K)$
print("__PARSEVAL_SUMMAND_MAXIMA__")$      print(string(Parseval_Summand))$
print("__PARSEVAL_SUMMAND_TEX__")$         tex(Parseval_Summand)$
print("__PARSEVAL_LHS_FINAL_MAXIMA__")$    print(string(Parseval_LHS_final))$
print("__PARSEVAL_LHS_FINAL_TEX__")$       tex(Parseval_LHS_final)$
