/* ═══════════════════════════════════════════════════════════════
   Emite marcadores __AN_K_*__ y __BN_K_*__ para la forma factorizada.
   Requiere: const_factor cargado, Coeff_An y Coeff_Bn definidos.
   ═══════════════════════════════════════════════════════════════ */

block(
    [_cf_an: const_factor(factor(Coeff_An), n),
     _cf_bn: const_factor(factor(Coeff_Bn), n)],
    Coeff_An_K: _cf_an[1],
    Coeff_An_Summand: _cf_an[2],
    Coeff_Bn_K: _cf_bn[1],
    Coeff_Bn_Summand: _cf_bn[2]
)$
print("__AN_K_MAXIMA__")$        print(string(Coeff_An_K))$
print("__AN_K_TEX__")$           tex(Coeff_An_K)$
print("__AN_SUMMAND_MAXIMA__")$  print(string(Coeff_An_Summand))$
print("__AN_SUMMAND_TEX__")$     tex(Coeff_An_Summand)$
print("__BN_K_MAXIMA__")$        print(string(Coeff_Bn_K))$
print("__BN_K_TEX__")$           tex(Coeff_Bn_K)$
print("__BN_SUMMAND_MAXIMA__")$  print(string(Coeff_Bn_Summand))$
print("__BN_SUMMAND_TEX__")$     tex(Coeff_Bn_Summand)$
