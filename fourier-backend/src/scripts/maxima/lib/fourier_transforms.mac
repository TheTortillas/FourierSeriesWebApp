/* ═══════════════════════════════════════════════════════════════════
   fourier_transforms.mac  —  Biblioteca unificada de Transformadas
   Versión backend — cargada por los wrappers de transforms/

   Cambios respecto a versión anterior:
     - ratprint:false  — silencia advertencias de rat()
     - FT_pattern_lookup ampliado:
         k/(a^2+t^2), cos(bt)/(a^2+t^2), sin(bt)/(a^2+t^2)
         k*exp(-at)*u(t)
         k*exp(-at)*cos(bt)*u(t)
         k*exp(-at)*sin(bt)*u(t)
     - IFT_pattern_lookup ampliado:
         k/(iw+a)^n  handler GENERAL  n>=1 (reemplaza handlers n=1,n=2;
           absorbe escalar en denominador para fracciones parciales),
         b/((iw+a)^2+b^2), (iw+a)/((iw+a)^2+b^2),
         (pi/a)*e^{-a|w|},
         k*e^{-iwt0}/(iw+a)^n via time-shift (corregido: F_expr no ratsimp),
         k*sin(c*(w-w0))/(w-w0) -> k*e^{-iw0t}*(u(t+c)-u(t-c))/2,
         fracciones parciales: partfrac(F,w) como último recurso — cubre
           cualquier fraccion racional propia sobre polos (iw+a)^n
     - Loop defensivo en FT() e IFT() ANTES de integracion por tramos
       para que parametros simbolicos esten declarados cuando
       integrate() los necesite — no solo dentro del lookup
     - Loop defensivo en lookups ANTES de rat()/expand()
     - Detectores de racionales usan rat() y coeff() para evitar
       flotantes en sqrt y preservar estructura op="/"
     - sqrt exacto: ratnump() antes de radcan para evitar 1.0/0.5
     - %piexact guarda %pi antes de que rat() lo contamine
     - FT/IFT usan freeof(%i) para Re/Im exactos en patrones reales
     - FT_free_params expone parametros libres al frontend
     - FT_match_u solo acepta coeficientes freeof(t_var) para evitar
       que exp(-at)*u(t) sea capturado como k*u(t) con k no constante

   NOTAS DE IMPLEMENTACION:
     - return() dentro de block() anidado NO escapa de la funcion
       en Maxima. Toda la logica usa variables res sin return.
     - expand() sobre fraccion racional puede cambiar op de "/" a "+"
       (fracciones parciales). Los detectores IFT usan er=rat(F_expr)
       para preservar op="/".
     - rat() sobre denominadores evita flotantes en coeff/sqrt.
     - El loop defensivo debe correr antes de rat() y expand() para
       que Maxima no cuelgue evaluando is(sym > 0) sin contexto.
     - exp(-at) de [0,inf) requiere declare(a,real)+assume(a>0) antes
       de integrate(). El loop en FT()/IFT() garantiza esto para todos
       los tramos, no solo para el lookup.
   ═══════════════════════════════════════════════════════════════════ */

display2d : false$
%iargs    : false$
ratprint  : false$

declare(delta, real)$
declare(u,     real)$
declare(sgn,   real)$
declare(rect,  real)$
declare(tri,   real)$
declare(sinc,  real)$

texput(sgn,  "\\operatorname{sgn}")$
texput(rect, "\\operatorname{rect}")$
texput(tri,  "\\operatorname{tri}")$
texput(sinc, "\\operatorname{sinc}")$

/* ════════════════════════════════════════════════════════════════════
   BLOQUE 2 — Auxiliares de reconocimiento
   ════════════════════════════════════════════════════════════════════ */

/* ── FT_apply_scale: multiply result by a normalization scalar without
   letting ratsimp fuse delta terms with rational terms.
   When delta is present, ratsimp(sc * (delta(t) + f(t))) absorbs f(t)
   into the delta coefficient, producing an unreadable fused fraction.
   Instead we split addends, ratsimp the rational part and the scalar
   separately, then reassemble — preserving the table form. ── */
FT_apply_scale(e, sc) := block([_terms, _dt, _rt, _r],
    if e = false then return(false),
    if freeof('delta, e) then return(ratsimp(sc * e)),
    if sc = 1 then return(e),
    _terms : if atom(e) or not is(op(e) = "+") then [e] else args(e),
    _dt : [], _rt : [],
    for _t in _terms do (
        if freeof('delta, _t) then _rt : cons(_t, _rt)
        else _dt : cons(_t, _dt)
    ),
    _r : if _rt = [] then 0 else ratsimp(sc * apply("+", _rt)),
    _r + ratsimp(sc) * apply("+", _dt)
)$

FT_is_minf(x) := is(x = minf) or is(x = -inf)$
FT_is_inf(x)  := is(x = inf)  or is(x = +inf)$

/* ── FT_normalize_hyp: rewrite sech/csch/coth to their 1/cosh form ──────────
   Maxima does not simplify sech(u) → 1/cosh(u) automatically.  When the user
   inputs sech(bt) the pattern matchers only see cosh, so we normalize first.
     sech(u)  → 1/cosh(u)
     csch(u)  → 1/sinh(u)
     coth(u)  → cosh(u)/sinh(u)
   Called at the top of both FT_pattern_lookup and IFT_pattern_lookup. */
FT_normalize_hyp(e) :=
    /* numberp catches rationals like 1/2 which are not atoms but have no args */
    if atom(e) or numberp(e) then e
    else if is(op(e) = 'sech) then 1 / cosh(FT_normalize_hyp(part(e, 1)))
    else if is(op(e) = 'csch) then 1 / sinh(FT_normalize_hyp(part(e, 1)))
    else if is(op(e) = 'coth) then cosh(FT_normalize_hyp(part(e, 1)))
                                    / sinh(FT_normalize_hyp(part(e, 1)))
    else map(FT_normalize_hyp, e)$

/* ── FT_to_sech: rewrite k/cosh(u) → k*sech(u) throughout an expression ──
   sech is not a Maxima built-in, so results with 1/cosh(…) render as messy
   fractions in TeX.  This traversal rewrites every occurrence to sech(…)
   so that, combined with texput(sech,"\\operatorname{sech}"), the output
   renders cleanly.
   Handles two cases:
     · k/cosh(u)   (op="/", den=cosh)        → k*sech(u)
     · k/(c*cosh(u)) (op="/", den=c*cosh)   → (k/c)*sech(u)
   When k=1 the leading 1* is dropped by Maxima simplification. */
FT_to_sech(e) :=
    if atom(e) then e
    else if is(op(e) = "/")
         and not atom(part(e, 2))
         and is(op(part(e, 2)) = cosh)
    /* k/cosh(u) → k*sech(u) */
    then part(e, 1) * sech(FT_to_sech(part(part(e, 2), 1)))
    else if is(op(e) = "/")
         and not atom(part(e, 2))
         and is(op(part(e, 2)) = "*")
         and not every(lambda([s], freeof(cosh, s) or atom(s)), args(part(e, 2))) then block(
        /* k/(c * cosh(u)) → (k/c)*sech(u);  extract the cosh factor from denominator */
        [_num: part(e, 1), _cosh_arg: false, _rest_den: 1],
        for _df in args(part(e, 2)) do (
            if not atom(_df) and is(op(_df) = 'cosh)
            then _cosh_arg: part(_df, 1)
            else _rest_den: _rest_den * _df
        ),
        if _cosh_arg # false
        then (_num / _rest_den) * sech(FT_to_sech(_cosh_arg))
        else map(FT_to_sech, e)
    )
    else map(FT_to_sech, e)$

/* ── FT_to_tanh_alt: rewrite tanh(u) → sinh(2u)/(cosh(2u)+1) throughout ──
   Uses the half-angle identity: tanh(x) = sinh(2x)/(cosh(2x)+1).
   Applied as an alternative display form for sin(at)/sinh(bt) results,
   mirroring what Wolfram Alpha shows as "alternate form assuming a,w real".
   Only the exact form tanh(u) is replaced; other sub-expressions recurse. */
FT_to_tanh_alt(e) :=
    if atom(e) then e
    else if is(op(e) = 'tanh) then block(
        [u, u2],
        u: FT_to_tanh_alt(part(e, 1)),
        /* Simplify the doubled argument: ratsimp(2 * π(a±w)/(2b)) → π(a±w)/b */
        u2: errcatch(ratsimp(2*u)),
        u2: if u2 # [] then first(u2) else 2*u,
        sinh(u2) / (cosh(u2) + 1)
    )
    else map(FT_to_tanh_alt, e)$

FT_limit_nonneg(x) :=
    if numberp(x) then x >= 0
    else is(x >= 0)$

FT_limit_nonpos(x) :=
    if numberp(x) then x <= 0
    else is(x <= 0)$

/* Devuelve los simbolos libres de expr que no estan en reserved */
FT_free_params(expr, reserved) := block(
    [params: [], _s],
    for sym in listofvars(expr) do (
        _s: string(sym),
        /* exclude reserved vars and internal Maxima symbols (leading underscore) */
        if not member(sym, reserved) and not is(substring(_s, 1, 2) = "_") then
            params: append(params, [sym])
    ),
    params
)$

/* Loop defensivo: declara como real y positivo cualquier parametro
   libre de expr que no sea una de las variables reservadas.
   Llamado tanto en lookups como en FT/IFT antes de integrar. */
FT_declare_params(expr, reserved) := block(
    [],
    for sym in listofvars(expr) do (
        if not member(sym, reserved)
           and not featurep(sym, real) then (
            declare(sym, real),
            assume(sym > 0)
        )
    )
)$

/* Extrae a de delta(t-a). Devuelve 0 si delta(t), false si no es delta */
FT_delta_shift(expr, t_var) := block(
    [arg, res, coef_t, shift],
    res: false,
    if not atom(expr) then (
        if is(op(expr) = 'delta) then (
            arg: part(expr, 1),
            /* extrae coeficiente de t_var y termino independiente */
            coef_t: ratsimp(diff(arg, t_var)),
            shift: ratsimp(subst(t_var=0, arg)),
            if freeof(t_var, coef_t) and freeof(t_var, shift)
               and not equal(coef_t, 0) then
                /* delta(a*t - b) = delta(t - b/a)/|a|
                   devuelve [shift/coef_t, |coef_t|] */
                res: [-shift/coef_t, abs(coef_t)]
        )
    ),
    res
)$

/* Detecta k*delta(t-a). Devuelve [k, a] o false */
FT_match_delta(expr, t_var) := block(
    [e, sh, delta_part, coef, sh2, res, num_e, den_e],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        sh: FT_delta_shift(e, t_var),
        if is(sh # false)
        then res: [1/sh[2], sh[1]]  /* [k=1/|a|, shift=b/a] */
        else if is(op(e) = "*") then (
            delta_part: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'delta)
                then delta_part: s
                else coef: coef * s
            ),
            if is(delta_part # false) then (
                sh2: FT_delta_shift(delta_part, t_var),
                if is(sh2 # false) then res: [coef/sh2[2], sh2[1]]
            )
        )
        else if is(op(e) = "/") or is(op(e) = "-") then (
            num_e: expand(num(e)),
            den_e: expand(denom(e)),
            if not atom(num_e) and is(op(num_e) = "-") then (
                num_e: expand(part(num_e, 1)),
                den_e: -den_e
            ),
            if freeof('delta, den_e) and not freeof('delta, num_e) then (
                sh: FT_delta_shift(num_e, t_var),
                if is(sh # false)
                then res: [1/(den_e*sh[2]), sh[1]]
                else if not atom(num_e) and is(op(num_e) = "*") then (
                    delta_part: false,
                    coef: 1,
                    for s in args(num_e) do (
                        if not atom(s) and is(op(s) = 'delta)
                        then delta_part: s
                        else coef: coef * s
                    ),
                    if is(delta_part # false) then (
                        sh2: FT_delta_shift(delta_part, t_var),
                        if is(sh2 # false) then res: [coef/(den_e*sh2[2]), sh2[1]]
                    )
                )
            )
        )
    ),
    res
)$

/* Detecta k*u(t) con k constante en t_var. Devuelve [k] o false.
   NOTA: freeof(t_var, coef) evita capturar exp(-at)*u(t) como k*u(t) */
FT_match_u(expr, t_var) := block(
    [e, u_part, coef, res, u_arg, u_coef],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        if is(op(e) = 'u) then (
            u_arg: part(e, 1),
            u_coef: ratsimp(u_arg / t_var),
            if freeof(t_var, u_coef) and is(u_coef > 0)
            then res: [1]
        )
        else if is(op(e) = "*") then (
            u_part: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u) then (
                    u_arg: part(s, 1),
                    u_coef: ratsimp(u_arg / t_var),
                    if freeof(t_var, u_coef) and is(u_coef > 0)
                    then u_part: s
                    else coef: coef * s
                )
                else coef: coef * s
            ),
            if is(u_part # false) and freeof(t_var, coef) then res: [coef]
        )
        else if is(op(e) = "/") then (
            if not atom(part(e,1)) and is(op(part(e,1)) = 'u) then (
                u_arg: part(part(e,1), 1),
                u_coef: ratsimp(u_arg / t_var),
                if freeof(t_var, u_coef) and is(u_coef > 0)
                then res: [1/part(e,2)]
            )
            else if not atom(part(e,1)) and is(op(part(e,1)) = "*") then block(
                [num_e],
                num_e: part(e,1),
                u_part: false,
                coef: 1,
                for s in args(num_e) do (
                    if not atom(s) and is(op(s) = 'u) then (
                        u_arg: part(s, 1),
                        u_coef: ratsimp(u_arg / t_var),
                        if freeof(t_var, u_coef) and is(u_coef > 0)
                        then u_part: s
                        else coef: coef * s
                    )
                    else coef: coef * s
                ),
                if is(u_part # false) and freeof(t_var, coef)
                then res: [coef/part(e,2)]
            )
        )
    ),
    res
)$

/* Detecta k*sgn(t). Devuelve [k] o false */
FT_match_sgn(expr, t_var) := block(
    [e, sgn_part, coef, res, sgn_arg, sgn_coef],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        if is(op(e) = 'sgn) then (
            /* detecta sgn(k*t) con k constante en t_var */
            sgn_arg: part(e, 1),
            sgn_coef: ratsimp(sgn_arg / t_var),
            if freeof(t_var, sgn_coef) and sgn_coef # 0 then
                res: [1]
        )
        else if is(op(e) = "*") then (
            sgn_part: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'sgn) then (
                    sgn_arg: part(s, 1),
                    sgn_coef: ratsimp(sgn_arg / t_var),
                    if freeof(t_var, sgn_coef) and sgn_coef # 0
                    then sgn_part: s
                    else coef: coef * s
                )
                else coef: coef * s
            ),
            if is(sgn_part # false) and freeof(t_var, coef) then res: [coef]
        )
        else if is(op(e) = "/") then (
            if not atom(part(e,1)) and is(op(part(e,1)) = 'sgn) then (
                sgn_arg: part(part(e,1), 1),
                sgn_coef: ratsimp(sgn_arg / t_var),
                if freeof(t_var, sgn_coef) and sgn_coef # 0 then
                    res: [1/part(e,2)]
            )
            else if not atom(part(e,1)) and is(op(part(e,1)) = "*") then block(
                [num_e],
                num_e: part(e,1),
                sgn_part: false,
                coef: 1,
                for s in args(num_e) do (
                    if not atom(s) and is(op(s) = 'sgn) then (
                        sgn_arg: part(s, 1),
                        sgn_coef: ratsimp(sgn_arg / t_var),
                        if freeof(t_var, sgn_coef) and sgn_coef # 0
                        then sgn_part: s
                        else coef: coef * s
                    )
                    else coef: coef * s
                ),
                if is(sgn_part # false) and freeof(t_var, coef) then res: [coef/part(e,2)]
            )
        )
    ),
    res
)$

/* Detecta k*rect(a*t+b) con k,a,b constantes en t_var.
   rect(a*t+b) es 1 cuando |a*t+b| < 1/2, es decir, pulso de ancho 1/|a|
   centrado en t0 = -b/a.
   Devuelve [k, a, b] o false. */
FT_match_rect(expr, t_var) := block(
    [e, rect_part, coef, res, rect_arg, aa, bb],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        if is(op(e) = 'rect) then (
            rect_arg: part(e, 1),
            aa: ratsimp(diff(rect_arg, t_var)),
            bb: ratsimp(subst(t_var=0, rect_arg)),
            if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                res: [1, aa, bb]
        )
        else if is(op(e) = "*") then (
            rect_part: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'rect)
                then rect_part: s
                else coef: coef * s
            ),
            if is(rect_part # false) and freeof(t_var, coef) then (
                rect_arg: part(rect_part, 1),
                aa: ratsimp(diff(rect_arg, t_var)),
                bb: ratsimp(subst(t_var=0, rect_arg)),
                if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                    res: [coef, aa, bb]
            )
        )
    ),
    res
)$

/* Detecta k*tri(a*t+b) con k,a,b constantes en t_var.
   tri(a*t+b) es 1-|a*t+b| cuando |a*t+b| < 1, pulso triangular de ancho
   2/|a| centrado en t0 = -b/a.
   Devuelve [k, a, b] o false. */
FT_match_tri(expr, t_var) := block(
    [e, tri_part, coef, res, tri_arg, aa, bb],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        if is(op(e) = 'tri) then (
            tri_arg: part(e, 1),
            aa: ratsimp(diff(tri_arg, t_var)),
            bb: ratsimp(subst(t_var=0, tri_arg)),
            if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                res: [1, aa, bb]
        )
        else if is(op(e) = "*") then (
            tri_part: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'tri)
                then tri_part: s
                else coef: coef * s
            ),
            if is(tri_part # false) and freeof(t_var, coef) then (
                tri_arg: part(tri_part, 1),
                aa: ratsimp(diff(tri_arg, t_var)),
                bb: ratsimp(subst(t_var=0, tri_arg)),
                if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                    res: [coef, aa, bb]
            )
        )
    ),
    res
)$

/* Detecta k*sinc(a*t+b) con k,a,b constantes en t_var.
   sinc(x) = sin(x)/x  (no normalizada).
   sinc(a*t+b): argumento lineal. Devuelve [k, a, b] o false. */
FT_match_sinc(expr, t_var) := block(
    [e, sinc_part, coef, res, sinc_arg, aa, bb],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        if is(op(e) = 'sinc) then (
            sinc_arg: part(e, 1),
            aa: ratsimp(diff(sinc_arg, t_var)),
            bb: ratsimp(subst(t_var=0, sinc_arg)),
            if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                res: [1, aa, bb]
        )
        else if is(op(e) = "*") then (
            sinc_part: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'sinc)
                then sinc_part: s
                else coef: coef * s
            ),
            if is(sinc_part # false) and freeof(t_var, coef) then (
                sinc_arg: part(sinc_part, 1),
                aa: ratsimp(diff(sinc_arg, t_var)),
                bb: ratsimp(subst(t_var=0, sinc_arg)),
                if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                    res: [coef, aa, bb]
            )
        )
    ),
    res
)$

/* Detect k*sinc(a*t+b)^n for integer n >= 2. Returns [k, a, b, n] or false.
   Handles bare sinc(...)^n and k*sinc(...)^n forms. */
FT_match_sinc_pow(expr, t_var) := block(
    [e, sinc_part, nn, coef, res, sinc_arg, aa, bb, base, expn],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        /* bare sinc(...)^n */
        if is(op(e) = "^") then (
            base: part(e, 1),
            expn: part(e, 2),
            if not atom(base) and is(op(base) = 'sinc) and
               integerp(expn) and is(expn >= 2) then (
                sinc_arg: part(base, 1),
                aa: ratsimp(diff(sinc_arg, t_var)),
                bb: ratsimp(subst(t_var=0, sinc_arg)),
                if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                    res: [1, aa, bb, expn]
            )
        )
        /* k * sinc(...)^n */
        else if is(op(e) = "*") then (
            sinc_part: false,
            nn: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = "^") and
                   not atom(part(s,1)) and is(op(part(s,1)) = 'sinc) and
                   integerp(part(s,2)) and is(part(s,2) >= 2)
                then (sinc_part: part(s,1), nn: part(s,2))
                else coef: coef * s
            ),
            if is(sinc_part # false) and freeof(t_var, coef) then (
                sinc_arg: part(sinc_part, 1),
                aa: ratsimp(diff(sinc_arg, t_var)),
                bb: ratsimp(subst(t_var=0, sinc_arg)),
                if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                    res: [coef, aa, bb, nn]
            )
        )
    ),
    res
)$

/* Build FT[sinc(a*t+b)^n](w) using the closed-form B-spline formula:
   FT[sinc^n(at)](w) = (π / (2^n*(n-1)!)) *
       Σ_{k=0}^{n} C(n,k)*(-1)^k*(n-2k-w/a)^(n-1)*sgn(n-2k-w/a)
   Special case n=2 returns the compact tri form instead of the sgn sum.
   Time-shift e^{-i*w*t0} applied when b≠0 (t0 = -b/a). */
FT_sincpow_formula(aa, bb, nn, w_var) := block(
    [t0, wu, coeff, total, k, binom_k, arg, result],
    t0: ratsimp(-bb / aa),
    /* n=2 special case: sinc²(at+b) → (π/|a|)*tri(w/(2a))*e^{-iwt0} */
    if is(nn = 2) then (
        result: %pi / abs(aa) * tri(w_var / (2 * aa)),
        if not equal(t0, 0) then result: result * exp(-%i * w_var * t0),
        return(result)
    ),
    /* General case n≥3: B-spline sgn sum */
    wu: w_var / aa,
    coeff: %pi / (2^nn * (nn-1)!),
    total: 0,
    for k: 0 thru nn do (
        binom_k: nn! / (k! * (nn-k)!),
        arg: nn - 2*k - wu,
        total: total + binom_k * (-1)^k * arg^(nn-1) * sgn(arg)
    ),
    result: coeff / abs(aa) * total,
    if not equal(t0, 0) then result: result * exp(-%i * w_var * t0),
    result
)$

/* ── FT_match_tri_pow: detect k*tri(a*t+b)^n for integer n ≥ 2 ──
   Returns [k, a, b, n] or false.  Same structure as FT_match_sinc_pow. */
FT_match_tri_pow(expr, t_var) := block(
    [e, tri_part, nn, coef, res, tri_arg, aa, bb, base, expn],
    e: expand(expr),
    res: false,
    if not atom(e) then (
        if is(op(e) = "^") then (
            base: part(e, 1),
            expn: part(e, 2),
            if not atom(base) and is(op(base) = 'tri) and
               integerp(expn) and is(expn >= 2) then (
                tri_arg: part(base, 1),
                aa: ratsimp(diff(tri_arg, t_var)),
                bb: ratsimp(subst(t_var=0, tri_arg)),
                if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                    res: [1, aa, bb, expn]
            )
        )
        else if is(op(e) = "*") then (
            tri_part: false,
            nn: false,
            coef: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = "^") and
                   not atom(part(s,1)) and is(op(part(s,1)) = 'tri) and
                   integerp(part(s,2)) and is(part(s,2) >= 2)
                then (tri_part: part(s,1), nn: part(s,2))
                else coef: coef * s
            ),
            if is(tri_part # false) and freeof(t_var, coef) then (
                tri_arg: part(tri_part, 1),
                aa: ratsimp(diff(tri_arg, t_var)),
                bb: ratsimp(subst(t_var=0, tri_arg)),
                if freeof(t_var, aa) and freeof(t_var, bb) and not equal(aa, 0) then
                    res: [coef, aa, bb, nn]
            )
        )
    ),
    res
)$

/* ── FT_tripow_formula: FT[tri(a*t+b)^n](w) for n = 1..4 ──
   Derived from direct integration; all verified analytically.
   General form: P_n(w/a) / (a * w^{n+1}) * e^{-i*w*t0}
   where t0 = -b/a and P_n alternates cos/sin.

   n=1: 2(1-cos u)/u²         (u = w/a, full result: 2(1-cos(w/a))/(a·(w/a)²))
   n=2: 4(u-sin u)/u³
   n=3: 6(u²+2cos u-2)/u⁴    (= 2(3u²+6cos u-6)/u⁴ / 3·... wait, see below)
   n=4: 8(u³+6sin u-6u)/u⁵

   Normalised: let u = a*t+b evaluated at t with shift → simplest to build
   directly in w with aa, bb.

   If a future general formula is found, replace this block with it. */
FT_tripow_formula(aa, bb, nn, w_var) := block(
    [t0, wu, result],
    if not member(nn, [1,2,3,4]) then return(false),
    t0: ratsimp(-bb / aa),
    wu: w_var / aa,     /* normalised frequency variable */
    result: if is(nn = 1) then
                2*(1 - cos(wu)) / (aa * wu^2)
            else if is(nn = 2) then
                4*(wu - sin(wu)) / (aa * wu^3)
            else if is(nn = 3) then
                2*(3*wu^2 + 6*cos(wu) - 6) / (aa * wu^4)
            else /* n=4 */
                8*(wu^3 + 6*sin(wu) - 6*wu) / (aa * wu^5),
    if not equal(t0, 0) then result: result * exp(-%i * w_var * t0),
    result
)$

/* ════════════════════════════════════════════════════════════════════
   BLOQUE 3 — Core: expand_abs, raw, simplify, exists
   ════════════════════════════════════════════════════════════════════ */

FT_expand_abs(trozo, t_var) := block(
    [f_i, ai, bi, f_neg, f_pos, res],
    f_i : trozo[1],
    ai  : trozo[2],
    bi  : trozo[3],

    /* Eliminar u(t_var) cuando el dominio lo hace redundante */
    if not freeof('u, f_i) then (
        if FT_limit_nonneg(ai) then
            f_i: ratsimp(subst(u(t_var) = 1, f_i))
        else if FT_limit_nonpos(bi) then
            f_i: subst(u(t_var) = 0, f_i)
        else if FT_is_minf(ai) and FT_is_inf(bi) then block(
            [fe, u_count],
            u_count: 0,
            fe: expand(f_i),
            if is(op(fe) = 'u) then u_count: 1
            else if is(op(fe) = "*") then (
                for s in args(fe) do
                    if not atom(s) and is(op(s) = 'u) then u_count: u_count + 1
            )
            else if is(op(fe) = "+") then (
                for term in args(fe) do
                    if not freeof('u, term) then u_count: u_count + 1
            ),
            if u_count = 1 then (
                f_i: ratsimp(subst(u(t_var) = 1, f_i)),
                ai: 0
            )
        )
    ),

    if freeof('abs, f_i)
    then res: [[f_i, ai, bi]]
    else (
        if FT_limit_nonneg(ai)
        then res: [[ratsimp(subst(abs(t_var) =  t_var, f_i)), ai, bi]]
        else if FT_limit_nonpos(bi)
        then res: [[ratsimp(subst(abs(t_var) = -t_var, f_i)), ai, bi]]
        else (
            f_neg: ratsimp(subst(abs(t_var) = -t_var, f_i)),
            f_pos: ratsimp(subst(abs(t_var) =  t_var, f_i)),
            res: [[f_neg, ai, 0], [f_pos, 0, bi]]
        ),
        /* Second pass: abs(g) with g ≠ t_var (e.g. abs(sin(t))) still remains */
        block([_still],
            _still: false,
            for _p in res while not _still do
                if not freeof('abs, _p[1]) then _still: true,
            if _still then res: FT_expand_abs_inner(res, t_var)
        )
    ),
    /* Third pass: substitute sgn(g) = ±1 on each piece based on its sign
       at the interval's sample point (works after abs splits at zero) */
    block([_has_sgn],
        _has_sgn: false,
        for _p in res while not _has_sgn do
            if not freeof('sgn, _p[1]) then _has_sgn: true,
        if _has_sgn then res: FT_subst_sgn_per_piece(res, t_var)
    ),
    res
)$

/* ── Helpers for general abs(g(t)) expansion ──────────────────────────── */

/* Recursively find the argument of the first abs() node in expr */
FT_first_abs_arg(expr) := block(
    [_res],
    _res: false,
    if not atom(expr) then (
        if is(op(expr) = 'abs) then _res: first(args(expr))
        else (
            for _fa in args(expr) while is(_res = false) do
                _res: FT_first_abs_arg(_fa)
        )
    ),
    _res
)$

/* Return a finite sample point inside (ai, bi) */
FT_abs_sample_point(ai, bi) := (
    if FT_is_minf(ai) and FT_is_inf(bi) then 0
    else if FT_is_minf(ai) then bi - 1
    else if FT_is_inf(bi)  then ai + 1
    else (ai + bi) / 2
)$

/* Second-pass abs expansion for compound abs(g(intvar)).
   Finds zeros of g in each piece's interval, splits there, sign-fixes.
   Used as a fallback after the abs(intvar) direct substitution. */
/* FT_trig_zeros: return zeros of sin(b*x+c) or cos(b*x+c) in open interval (lo, hi).
   Roots are at x = (n*pi - c + phase) / b, where phase=0 for sin, pi/2 for cos.
   Only works when b and c are free of x and b≠0. Returns [] otherwise so the
   caller can fall back to solve(). Cap at 500 roots to stay finite. */
FT_trig_zeros(g, x, lo, hi) := block(
    [_op, _arg, _b, _c, _phase, _lo_n, _hi_n, _nn, _root, _ci, _zs],
    if atom(g) then return([]),
    _op: op(g),
    if not (is(_op = 'sin) or is(_op = 'cos)) then return([]),
    _arg: first(args(g)),
    _b: ratsimp(diff(_arg, x)),
    _c: ratsimp(subst(x=0, _arg)),
    if not freeof(x, _b) or not freeof(x, _c) or equal(_b, 0) then return([]),
    _phase: if is(_op = 'sin) then 0 else %pi/2,
    /* roots at x = (n*pi - _c - _phase) / _b  (using cos(u)=0 ↔ u=pi/2+n*pi) */
    /* equivalently sin(bt+c)=0 ↔ bt+c = n*pi ↔ t=(n*pi-c)/b */
    _lo_n: errcatch(ceiling(float((lo * _b + _c + _phase) / %pi))),
    _hi_n: errcatch(floor(float((hi * _b + _c + _phase) / %pi))),
    if _lo_n = [] or _hi_n = [] then return([]),
    _lo_n: first(_lo_n),  _hi_n: first(_hi_n),
    if _hi_n - _lo_n > 500 then return([]),
    _zs: [],
    for _nn: _lo_n thru _hi_n do (
        _root: errcatch(ratsimp((_nn * %pi - _c - _phase) / _b)),
        if _root # [] then (
            _root: first(_root),
            _ci: errcatch(is(_root > lo) and is(_root < hi)),
            if _ci # [] and first(_ci) = true then
                _zs: append(_zs, [_root])
        )
    ),
    _zs
)$

FT_expand_abs_inner(pieces, intvar) := block(
    [_res, _pc, _f, _a, _b, _g, _rzs, _zs, _pts, _n, _j,
     _lo, _hi, _tp, _gv, _sv, _fn, _z, _zv, _ir],
    _res: [],
    for _pc in pieces do (
        _f: _pc[1], _a: _pc[2], _b: _pc[3],
        if freeof('abs, _f) then (
            _res: append(_res, [_pc])
        ) else (
            _g: FT_first_abs_arg(_f),
            if _g = false then
                _res: append(_res, [_pc])
            else block(
                /* Try analytic trig roots first; fall back to solve() for others */
                _zs: FT_trig_zeros(_g, intvar, _a, _b),
                if _zs = [] then (
                    _rzs: errcatch(solve(_g = 0, intvar)),
                    if _rzs # [] then
                        for _z in first(_rzs) do (
                            _zv: errcatch(rhs(_z)),
                            if _zv # [] then (
                                _zv: first(_zv),
                                if freeof(intvar, _zv) and freeof(%i, _zv) then (
                                    _ir: errcatch(is(_zv > _a) and is(_zv < _b)),
                                    if _ir # [] and first(_ir) = true then
                                        _zs: append(_zs, [_zv])
                                )
                            )
                        )
                ),
                _pts: append([_a], _zs, [_b]),
                _n: length(_pts) - 1,
                for _j: 1 thru _n do (
                    _lo: _pts[_j], _hi: _pts[_j + 1],
                    _tp: FT_abs_sample_point(_lo, _hi),
                    _gv: errcatch(ratsimp(subst(intvar = _tp, _g))),
                    if _gv = [] then
                        _res: append(_res, [[_f, _lo, _hi]])
                    else (
                        _gv: first(_gv),
                        if is(_gv > 0) then _sv: 1
                        else if is(_gv < 0) then _sv: -1
                        else _sv: 0,
                        if _sv = 1 or _sv = -1 then (
                            _fn: ratsimp(subst(abs(_g) = _sv * _g, _f)),
                            _res: append(_res, [[_fn, _lo, _hi]])
                        ) else
                            _res: append(_res, [[_f, _lo, _hi]])
                    )
                )
            )
        )
    ),
    _res
)$

/* Recursively collect the arguments of every sgn() node in expr */
FT_collect_sgn_args(expr) := block(
    [_res],
    _res: [],
    if not atom(expr) then (
        if is(op(expr) = 'sgn) then
            _res: [first(args(expr))]
        else (
            for _ca in args(expr) do
                _res: append(_res, FT_collect_sgn_args(_ca))
        )
    ),
    _res
)$

/* On each piece, evaluate sgn(g) at a sample point and substitute ±1.
   Handles sgn(t), sgn(k*t), sgn(t-a), etc. without modifying interval bounds. */
FT_subst_sgn_per_piece(pieces, intvar) := block(
    [_res, _pc, _f, _a, _b, _tp, _e, _gargs, _g, _gval, _sv],
    _res: [],
    for _pc in pieces do (
        _f: _pc[1], _a: _pc[2], _b: _pc[3],
        if freeof('sgn, _f) then (
            _res: append(_res, [_pc])
        ) else (
            _tp: FT_abs_sample_point(_a, _b),
            _e: _f,
            _gargs: FT_collect_sgn_args(_e),
            for _g in _gargs do (
                _gval: errcatch(ratsimp(subst(intvar = _tp, _g))),
                if _gval # [] then (
                    _gval: first(_gval),
                    if is(_gval > 0) then _sv: 1
                    else if is(_gval < 0) then _sv: -1
                    else _sv: false,
                    if _sv # false then
                        _e: ratsimp(subst(sgn(_g) = _sv, _e))
                )
            ),
            _res: append(_res, [[_e, _a, _b]])
        )
    ),
    _res
)$

FT_raw(f_expr, t_var, w_var, a, b) := block(
    [kernel, raw, cleaned],
    /* Garantizar contexto antes de integrate */
    if not featurep(w_var, real) then declare(w_var, real),
    for sym in listofvars(f_expr) do (
        if sym # t_var and sym # w_var
           and not numberp(sym)
           and not featurep(sym, real) then (
            declare(sym, real),
            assume(sym > 0)
        )
    ),
    kernel : f_expr * exp(-%i * w_var * t_var),
    raw    : errcatch(integrate(kernel, t_var, a, b)),
    if raw = [] then raw: 'failed
    else (
        raw : first(raw),
        if not freeof('gamma_incomplete, raw) then (
            cleaned : errcatch(clean_integral(raw, t_var)),
            if cleaned # [] then raw : first(cleaned)
        )
    ),
    raw
)$

/* FT_collect_ci_neg_args: returns list of u such that Ci(-u) appears in expr. */
FT_collect_ci_neg_args(expr) := block(
    [_a, _sub, _rest],
    if atom(expr) then return([]),
    if is(op(expr) = 'expintegral_ci) then (
        _a: first(args(expr)),
        if not atom(_a) and is(op(_a) = "-") and length(args(_a)) = 1 then
            [- first(args(_a))]
        else []
    ) else (
        _rest: [],
        for _sub in args(expr) do
            _rest: append(_rest, FT_collect_ci_neg_args(_sub)),
        _rest
    )
)$

/* FT_rewrite_ci_neg: apply Ci(-u) → Ci(u) + i·π (branch-cut identity, u > 0).
   Maxima's integrator produces Ci(-u) when limits are fractional (e.g. a/2).
   Only applied when no delta is present, to avoid disturbing rational+delta forms. */
FT_rewrite_ci_neg(expr) := block(
    [_negs, _subs, _u],
    if freeof('expintegral_ci, expr) then return(expr),
    _negs: FT_collect_ci_neg_args(expr),
    if _negs = [] then return(expr),
    _subs: [],
    for _u in _negs do
        _subs: append(_subs, [expintegral_ci(-_u) = expintegral_ci(_u) + %i*%pi]),
    subst(_subs, expr)
)$

FT_simplify(expr) := block(
    [e, ef],
    /* When delta is present, ratsimp merges addends into one fraction,
       destroying the readable "rational + delta" form. Leave as-is. */
    if not freeof('delta, expr) then return(expr),
    e  : ratsimp(rectform(FT_rewrite_ci_neg(expr))),
    ef : errcatch(factor(e)),
    if ef # [] then first(ef) else e
)$

FT_exists(expr) :=
    freeof('integrate,        expr) and
    freeof('limit,            expr) and
    freeof('gamma_incomplete, expr)$

/* IFT_extract_u_window: detect F(w) = k * G(w) * (u(w+a) - u(w-b))
   Returns [G_core, lo, hi, k] where the integral runs from lo=-a to hi=b,
   or false if the expression is not of this form.
   Strategy: expand F_i, then scan terms for exactly one u(w+a) with positive
   net coefficient and one -u(w-b) with negative net coefficient.
   The scalar k is extracted as the ratio of the net coefficient to ±1,
   avoiding is(expr > 0) checks on symbolic scalars. */
IFT_extract_u_window(F_i, w_var) := block(
    [_fe, _terms, _u_pos_shift, _u_neg_shift, _k_pos, _k_neg,
     _t, _sign, _base, _uk, _uf, _sh, _r],
    if freeof('u, F_i) then return(false),
    _fe: expand(F_i),
    if atom(_fe) or not is(op(_fe) = "+") then return(false),
    _u_pos_shift: false, _u_neg_shift: false, _k_pos: false, _k_neg: false,
    _terms: args(_fe),
    for _t in _terms do block(
        [_sign2, _base2, _uk2, _uf2, _sh2, _r2],
        _sign2: 1, _base2: _t,
        /* unary minus */
        if not atom(_t) and is(op(_t) = "-") then (
            _sign2: -1, _base2: first(args(_t))
        ),
        _uk2: 1, _uf2: false,
        if not atom(_base2) and is(op(_base2) = 'u) then (
            _uf2: _base2
        ) else if not atom(_base2) and is(op(_base2) = "*") then (
            for _f2 in args(_base2) do (
                if not atom(_f2) and is(op(_f2) = 'u) then _uf2: _f2
                else if freeof(w_var, _f2) then _uk2: _uk2 * _f2
            )
        ),
        if is(_uf2 # false) then (
            _sh2: errcatch(ratsimp(part(_uf2, 1) - w_var)),
            if _sh2 # [] and freeof(w_var, first(_sh2)) then (
                _r2: _sign2 * _uk2,         /* net coefficient — may be symbolic */
                _sh2: first(_sh2),          /* shift: w+sh -> sh */
                /* Classify by shift sign: positive shift = u(w+a), a>0 */
                if freeof(w_var, _sh2) then (
                    if is(_sh2 > 0) then (
                        /* This is the +u(w+a) family */
                        if is(_r2 > 0) then (
                            _u_pos_shift: _sh2, _k_pos: _r2
                        ) else if is(_r2 < 0) then (
                            _u_neg_shift: _sh2, _k_neg: -_r2
                        ) else (
                            /* symbolic coefficient: store and decide by index */
                            _u_pos_shift: _sh2, _k_pos: _r2
                        )
                    ) else if is(_sh2 < 0) then (
                        /* This is the -u(w-b) family, shift = -b < 0 */
                        if is(_r2 < 0) then (
                            _u_neg_shift: -_sh2, _k_neg: -_r2
                        ) else if is(_r2 > 0) then (
                            _u_pos_shift: -_sh2, _k_pos: _r2
                        ) else (
                            _u_neg_shift: -_sh2, _k_neg: ratsimp(-_r2)
                        )
                    )
                )
            )
        )
    ),
    /* Both limits found and free of w_var */
    if is(_u_pos_shift # false) and is(_u_neg_shift # false)
       and freeof(w_var, _u_pos_shift) and freeof(w_var, _u_neg_shift) then block(
        [_k],
        /* k is the common scalar: take from whichever side was found */
        _k: if is(_k_pos # false) then ratsimp(_k_pos) else ratsimp(_k_neg),
        [1, -_u_pos_shift, _u_neg_shift, _k]
    ) else false
)$

IFT_expand_abs(trozo, w_var) := block(
    [F_i, ai, bi, F_neg, F_pos, res, _uw],
    F_i : trozo[1],
    ai  : trozo[2],
    bi  : trozo[3],

    /* ── expand u(w±c) window into finite integration limits ──
       F(w)*(u(w+a)-u(w-b)) on (-inf,inf) → integrate F_core from -a to b.
       This mirrors FT_expand_abs handling of abs(t).                    */
    if not freeof('u, F_i) and FT_is_minf(ai) and FT_is_inf(bi) then (
        _uw: IFT_extract_u_window(F_i, w_var),
        if is(_uw # false) then
            return([[_uw[4] * _uw[1], _uw[2], _uw[3]]])
    ),

    if freeof('abs, F_i)
    then res: [trozo]
    else (
        if FT_limit_nonneg(ai)
        then res: [[ratsimp(subst(abs(w_var) =  w_var, F_i)), ai, bi]]
        else if FT_limit_nonpos(bi)
        then res: [[ratsimp(subst(abs(w_var) = -w_var, F_i)), ai, bi]]
        else (
            F_neg: ratsimp(subst(abs(w_var) = -w_var, F_i)),
            F_pos: ratsimp(subst(abs(w_var) =  w_var, F_i)),
            res: [[F_neg, ai, 0], [F_pos, 0, bi]]
        ),
        /* Second pass: abs(g) with g ≠ w_var still remains */
        block([_still],
            _still: false,
            for _p in res while not _still do
                if not freeof('abs, _p[1]) then _still: true,
            if _still then res: FT_expand_abs_inner(res, w_var)
        )
    ),
    /* Third pass: substitute sgn(g) = ±1 per piece */
    block([_has_sgn],
        _has_sgn: false,
        for _p in res while not _has_sgn do
            if not freeof('sgn, _p[1]) then _has_sgn: true,
        if _has_sgn then res: FT_subst_sgn_per_piece(res, w_var)
    ),
    res
)$

IFT_raw(F_expr, w_var, t_var, a, b) := block(
    [kernel, raw, cleaned],
    /* Garantizar contexto antes de integrate */
    if not featurep(t_var, real) then declare(t_var, real),
    for sym in listofvars(F_expr) do (
        if sym # w_var and sym # t_var
           and not numberp(sym)
           and not featurep(sym, real) then (
            declare(sym, real),
            assume(sym > 0)
        )
    ),
    kernel : (1/(2*%pi)) * F_expr * exp(%i * w_var * t_var),
    raw    : errcatch(integrate(kernel, w_var, a, b)),
    if raw = [] then raw: 'failed
    else (
        raw : first(raw),
        if not freeof('gamma_incomplete, raw) then (
            cleaned : errcatch(clean_integral(raw, w_var)),
            if cleaned # [] then raw : first(cleaned)
        )
    ),
    raw
)$

IFT_simplify(expr) := block(
    [e, ef],
    e  : ratsimp(rectform(expr)),
    ef : errcatch(factor(e)),
    if ef # [] then first(ef) else e
)$

/*
  Display normalization for frequency-domain expressions F(w).

  Rules:
  - Never rectform: expands e^{iθ} → cos+i*sin, losing compact polar form.
  - Never fullratsimp when delta is present: merges distributional and rational
    terms over a common denominator, producing ugly combined fractions.
  - Otherwise a light ratsimp pass to cancel obvious algebraic factors.
*/
FT_pick_display_expr(expr) := block(
    [tmp, tmp2],
    if expr = false then return(false),
    if not freeof('delta, expr) then return(expr),
    /* Apply sech rewrite BEFORE ratsimp: ratsimp merges 1/cosh(a)+1/cosh(b)
       into (cosh(a)+cosh(b))/(cosh(a)*cosh(b)), destroying the 1/cosh pattern.
       We rewrite first while the sum-of-fractions structure is still intact. */
    if not freeof(cosh, expr) then (
        tmp2 : errcatch(FT_to_sech(expr)),
        if tmp2 # [] then return(first(tmp2))
    ),
    tmp : errcatch(ratsimp(expr)),
    if tmp # [] then return(first(tmp)),
    expr
)$

/*
  Display normalization for time-domain expressions (f(t)).
  One fullratsimp pass; fallback to original if Maxima errors.
*/
FT_pick_display_expr_algebraic(expr) := block(
        [tmp],
        if expr = false then return(false),
        tmp : errcatch(fullratsimp(expr)),
        if tmp # [] then return(first(tmp)),
        expr
)$

IFT_exists(expr) :=
    freeof('integrate,        expr) and
    freeof('limit,            expr) and
    freeof('gamma_incomplete, expr)$

/* FT_sinpow_to_sinc: rewrite k*(sin(b*t+c))^n / (d*t+e)^n → k/b^n * sinc(b*t+c)^n
   when (d*t+e) is proportional to the argument of sin (d/b = e/c or e=0,c=0).
   This allows FT_match_sinc and FT_match_sinc_pow to handle the common form
   (sin(at)/t)^n = sinc(at)^n without calling integrate().
   Returns the rewritten expression or false if pattern does not match. */
FT_sinpow_to_sinc(expr, t_var) := block(
    [_e, _num, _den, _sin_part, _sin_arg, _coef,
     _den_base, _den_exp, _b, _c, _d, _e2, _ratio],
    _e: expr,
    /* Must be a ratio: num/den */
    if atom(_e) or not is(op(_e) = "/") then return(false),
    _num: part(_e, 1),
    _den: part(_e, 2),
    /* Den must be (linear in t)^n — factor to expose */
    block([_fden],
        _fden: errcatch(factor(_den)),
        if _fden # [] then _den: first(_fden)
    ),
    /* Extract den = (d*t+e)^n or d*t+e (n=1).
       Also handle expand'd form c^n*t^n (product of same-power factors)
       by reconstructing (c*t)^n. */
    if not atom(_den) and is(op(_den) = "^") then (
        _den_base: part(_den, 1),
        _den_exp:  part(_den, 2)
    ) else if not atom(_den) and is(op(_den) = "*") then block(
        /* Check if all factors share the same integer exponent n */
        [_facs, _exp_candidate, _all_same, _bases],
        _facs: args(_den),
        _exp_candidate: false,
        _all_same: true,
        _bases: [],
        for _ff in _facs do (
            if not atom(_ff) and is(op(_ff) = "^") and integerp(part(_ff,2)) then (
                if is(_exp_candidate = false)
                then _exp_candidate: part(_ff, 2)
                else if not is(_exp_candidate = part(_ff,2)) then _all_same: false,
                _bases: append(_bases, [part(_ff,1)])
            ) else (
                /* bare factor: treat as factor^1 */
                if is(_exp_candidate = false) then _exp_candidate: 1
                else if not is(_exp_candidate = 1) then _all_same: false,
                _bases: append(_bases, [_ff])
            )
        ),
        if _all_same and is(_exp_candidate # false) and is(_exp_candidate >= 1) then (
            _den_base: apply("*", _bases),
            _den_exp:  _exp_candidate
        ) else (
            _den_base: _den,
            _den_exp:  1
        )
    ) else (
        _den_base: _den,
        _den_exp:  1
    ),
    if not (integerp(_den_exp) and is(_den_exp >= 1)) then return(false),
    _d: ratsimp(diff(_den_base, t_var)),
    _e2: ratsimp(subst(t_var=0, _den_base)),
    if not freeof(t_var, _d) or not freeof(t_var, _e2) or equal(_d, 0) then return(false),
    /* Num must be k*sin(b*t+c)^n with the same n */
    _sin_part: false,
    _coef: 1,
    block([_nn, _base2, _expn2],
        _e: expand(_num),
        if not atom(_e) and is(op(_e) = "^") then (
            _base2: part(_e, 1),
            _expn2: part(_e, 2),
            if not atom(_base2) and is(op(_base2) = 'sin) and
               integerp(_expn2) and is(_expn2 = _den_exp) then
                _sin_part: _base2
        ) else if not atom(_e) and is(op(_e) = "*") then (
            for _s in args(_e) do (
                if not atom(_s) and is(op(_s) = "^") and
                   not atom(part(_s,1)) and is(op(part(_s,1)) = 'sin) and
                   integerp(part(_s,2)) and is(part(_s,2) = _den_exp)
                then _sin_part: part(_s,1)
                else _coef: _coef * _s
            )
        ) else if not atom(_e) and is(op(_e) = 'sin) and is(_den_exp = 1) then (
            _sin_part: _e, _coef: 1
        )
    ),
    if is(_sin_part = false) or not freeof(t_var, _coef) then return(false),
    /* sin arg must be proportional to den base: sin(b*t+c), den=(d*t+e) with b/d = c/e */
    _sin_arg: first(args(_sin_part)),
    _b: ratsimp(diff(_sin_arg, t_var)),
    _c: ratsimp(subst(t_var=0, _sin_arg)),
    if not freeof(t_var, _b) or not freeof(t_var, _c) or equal(_b, 0) then return(false),
    /* Check proportionality: sin(b*t+c) / (d*t+e) = (b/d)*sinc(b*t+c)
       requires b/d = c/e (same ratio), i.e. b*e = c*d */
    _ratio: errcatch(ratsimp(_b * _e2 - _c * _d)),
    if _ratio = [] or not equal(first(_ratio), 0) then return(false),
    /* Only normalize for n≥2 — sin(at)/(π·t) (n=1) has its own dedicated matcher
       that returns u(w+a)-u(w-a) instead of rect, which is the canonical form. */
    if is(_den_exp < 2) then return(false),
    /* Rewrite: k*(sin(bt+c))^n/(dt+e)^n = k*(b/d)^n * sinc(bt+c)^n */
    _coef * (_b / _d)^_den_exp * sinc(_sin_arg)^_den_exp
)$

/* ════════════════════════════════════════════════════════════════════
   BLOQUE 4 — Pattern lookups
   ════════════════════════════════════════════════════════════════════ */

/* ────────────────────────────────────────────────────────────────
   FT_PATTERN_LOOKUP
   Patrones cubiertos:
     delta(t-a), constante, e^{iw0t}
     cos(w0t), sin(w0t), u(t), sgn(t)
     k*exp(-at)*u(t)         -> k/(iw+a)
     k*exp(-at)*cos(bt)*u(t) -> k*(iw+a)/((iw+a)^2+b^2)
     k*exp(-at)*sin(bt)*u(t) -> k*b/((iw+a)^2+b^2)
     k/(a^2+t^2)
     cos(bt)/(a^2+t^2)  — detecta op="/" y op="*"
     sin(bt)/(a^2+t^2)  — detecta op="/" y op="*"
   ──────────────────────────────────────────────────────────────── */
FT_pattern_lookup(f_expr, t_var, w_var) := block(
    [e, dm, um, sm, k, a, w0, arg, %piexact, res],

    /* ── loop defensivo PRIMERO, antes de expand/rat ── */
    FT_declare_params(f_expr, [t_var, w_var]),

    /* Normalize sech/csch/coth → 1/cosh, 1/sinh, cosh/sinh so pattern matchers work */
    f_expr: FT_normalize_hyp(f_expr),

    %piexact: %pi,
    e: expand(f_expr),
    res: false,

    /* ── (sin(bt+c))^n / (dt+e)^n → sinc(bt+c)^n — normalize before matchers ── */
    block([_sinc_rewrite],
        _sinc_rewrite: FT_sinpow_to_sinc(e, t_var),
        if is(_sinc_rewrite # false) then e: expand(_sinc_rewrite)
    ),

    /* ── delta(t-a) ── */
    dm: FT_match_delta(e, t_var),
    if is(dm # false) then (
        k: dm[1],  a: dm[2],
        if a = 0
        then res: [k * 1,                "delta(t) -> 1"]
        else res: [k * exp(-%i*w_var*a), concat("delta(t-a) -> e^{-iwa}, a=", string(a))]
    ),

    /* ── constante ── */
    if is(res = false) then (
        if freeof(t_var, e) and e # 0 then
            res: [2*%piexact*e*delta(w_var), concat("c -> 2pi*c*delta(w), c=", string(e))]
    ),

    /* ── e^{iw0t} — op es "^" en Maxima, no 'exp ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "^") then (
            arg: part(e, 2),
            if not freeof(%i, arg) then (
                w0: ratsimp(arg / (%i * t_var)),
                if freeof(t_var, w0) then
                    res: [2*%piexact*delta(w_var - w0),
                          concat("e^{iw0t} -> 2pi*delta(w-w0), w0=", string(w0))]
            )
        )
    ),

    /* ── cos(w0t + theta) — incluye k*cos(w0t+theta) y -cos(...) ──
       Cuando Maxima pre-simplifica cos(t-pi) -> -cos(t) o similares,
       el op es "-" (negación) o "*" con escalar constante (freeof t_var).
       IMPORTANTE: el caso "*" solo actúa si TODOS los factores no-cos
       son libres de t_var — así no captura exp(-at)*cos(bt)*u(t). */
    if is(res = false) then block(
        [_k, _trig, _arg, _w0, _theta],
        _k: false,  _trig: false,
        if not atom(e) and is(op(e) = 'cos) then (
            _k: 1,  _trig: e
        ) else if not atom(e) and is(op(e) = "-") and
                  not atom(part(e,1)) and is(op(part(e,1)) = 'cos) then (
            _k: -1,  _trig: part(e, 1)
        ) else if not atom(e) and is(op(e) = "-") and
                  not atom(part(e,1)) and is(op(part(e,1)) = "*") then block(
            /* -(k*cos(...)): unary minus wrapping a product */
            [_inner, _sc2, _tp2, _ac2],
            _inner: part(e,1),
            _sc2: 1,  _tp2: false,  _ac2: true,
            for _f2 in args(_inner) do (
                if not atom(_f2) and is(op(_f2) = 'cos) then _tp2: _f2
                else if freeof(t_var, _f2) then _sc2: _sc2 * _f2
                else _ac2: false
            ),
            if is(_tp2 # false) and _ac2 then (_k: -_sc2,  _trig: _tp2)
        ) else if not atom(e) and is(op(e) = "*") then block(
            [_factors, _scalar, _trigpart, _all_const],
            _factors: args(e),
            _scalar: 1,  _trigpart: false,  _all_const: true,
            for _f in _factors do (
                if not atom(_f) and is(op(_f) = 'cos) then _trigpart: _f
                else if freeof(t_var, _f) then _scalar: _scalar * _f
                else _all_const: false   /* factor with t_var that is not cos */
            ),
            if is(_trigpart # false) and _all_const then (_k: _scalar,  _trig: _trigpart)
        ),
        if is(_k # false) then (
            _arg: part(_trig, 1),
            _w0: ratsimp(diff(_arg, t_var)),
            _theta: ratsimp(subst(t_var=0, _arg)),
            if freeof(t_var, _w0) and freeof(t_var, _theta)
            and not equal(_w0, 0) then
                res: [_k * %piexact * (exp(%i*_theta)*delta(w_var-_w0)
                                     + exp(-%i*_theta)*delta(w_var+_w0)),
                    concat("k*cos(w0t+theta) -> k*pi[...], k=", string(_k),
                           ", w0=", string(_w0), ", theta=", string(_theta))]
        )
    ),

    /* ── sin(w0t + theta) — incluye k*sin(w0t+theta) y -sin(...) ── */
    if is(res = false) then block(
        [_k, _trig, _arg, _w0, _theta],
        _k: false,  _trig: false,
        if not atom(e) and is(op(e) = 'sin) then (
            _k: 1,  _trig: e
        ) else if not atom(e) and is(op(e) = "-") and
                  not atom(part(e,1)) and is(op(part(e,1)) = 'sin) then (
            _k: -1,  _trig: part(e, 1)
        ) else if not atom(e) and is(op(e) = "-") and
                  not atom(part(e,1)) and is(op(part(e,1)) = "*") then block(
            /* -(k*sin(...)): unary minus wrapping a product */
            [_inner, _sc2, _tp2, _ac2],
            _inner: part(e,1),
            _sc2: 1,  _tp2: false,  _ac2: true,
            for _f2 in args(_inner) do (
                if not atom(_f2) and is(op(_f2) = 'sin) then _tp2: _f2
                else if freeof(t_var, _f2) then _sc2: _sc2 * _f2
                else _ac2: false
            ),
            if is(_tp2 # false) and _ac2 then (_k: -_sc2,  _trig: _tp2)
        ) else if not atom(e) and is(op(e) = "*") then block(
            [_factors, _scalar, _trigpart, _all_const],
            _factors: args(e),
            _scalar: 1,  _trigpart: false,  _all_const: true,
            for _f in _factors do (
                if not atom(_f) and is(op(_f) = 'sin) then _trigpart: _f
                else if freeof(t_var, _f) then _scalar: _scalar * _f
                else _all_const: false   /* factor with t_var that is not sin */
            ),
            if is(_trigpart # false) and _all_const then (_k: _scalar,  _trig: _trigpart)
        ),
        if is(_k # false) then (
            _arg: part(_trig, 1),
            _w0: ratsimp(diff(_arg, t_var)),
            _theta: ratsimp(subst(t_var=0, _arg)),
            if freeof(t_var, _w0) and freeof(t_var, _theta)
            and not equal(_w0, 0) then
                res: [_k * (-%i*%piexact) * (exp(%i*_theta)*delta(w_var-_w0)
                                            - exp(-%i*_theta)*delta(w_var+_w0)),
                    concat("k*sin(w0t+theta) -> k*(-i*pi)[...], k=", string(_k),
                           ", w0=", string(_w0), ", theta=", string(_theta))]
        )
    ),

    /* ── u(t) con coeficiente constante ── */
    if is(res = false) then (
        um: FT_match_u(e, t_var),
        if is(um # false) then (
            k: um[1],
            res: [k * (%piexact*delta(w_var) + 1/(%i*w_var)), "u(t) -> pi*delta(w) + 1/(iw)"]
        )
    ),

    /* ── k*u(t-t0) -> k*(pi*delta(w) + 1/(iw))*exp(-i*w*t0)  (t0 real) ── */
    if is(res = false) then block(
        [u_part, coef_k, u_arg, t0],
        u_part: false,
        coef_k: 1,
        /* detecta u(t-t0) directo */
        if not atom(e) and is(op(e) = 'u) then (
            u_arg: part(e, 1),
            t0: ratsimp(t_var - u_arg),
            if freeof(t_var, t0) and not equal(t0, 0) then
                res: [%piexact*delta(w_var) + exp(-%i*w_var*t0)/(%i*w_var),
                    concat("u(t-t0) -> (pi*delta(w)+1/(iw))*exp(-i*w*t0), t0=", string(t0))]
        ),
        /* detecta k*u(t-t0) — k DEBE ser constante en t */
        if is(res = false) and not atom(e) and is(op(e) = "*") then (
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u)
                then u_part: s
                else coef_k: coef_k * s
            ),
            if is(u_part # false) and freeof(t_var, coef_k) then (
                u_arg: part(u_part, 1),
                t0: ratsimp(t_var - u_arg),
                if freeof(t_var, t0) and not equal(t0, 0) then
                    res: [coef_k * (%piexact*delta(w_var) + exp(-%i*w_var*t0)/(%i*w_var)),
                        concat("k*u(t-t0) -> k*(pi*delta(w)+1/(iw))*exp(-i*w*t0), t0=",
                                string(t0))]
            )
        )
    ),

    /* ── sgn(t) ── */
    if is(res = false) then (
        sm: FT_match_sgn(e, t_var),
        if is(sm # false) then (
            k: sm[1],
            res: [k * 2/(%i*w_var), "sgn(t) -> 2/(iw)"]
        )
    ),

    /* ── k*sgn(t-t0) -> 2k*exp(-iw*t0)/(iw)  (t0 ≠ 0)
       Uses sgn(t-t0) = 2u(t-t0)-1, so FT = 2(pi*delta+e^{-iwt0}/(iw)) - 2pi*delta
       = 2*e^{-iwt0}/(iw). Handles displacement + arbitrary constant scalar. ── */
    if is(res = false) then block(
        [_sg_part, _sg_coef, _sg_arg, _sg_t0],
        _sg_part: false, _sg_coef: 1,
        /* detect sgn(t-t0) directly */
        if not atom(e) and is(op(e) = 'sgn) then (
            _sg_arg: part(e, 1),
            _sg_t0: ratsimp(t_var - _sg_arg),
            if freeof(t_var, _sg_t0) and not equal(_sg_t0, 0) then
                res: [2*exp(-%i*w_var*_sg_t0)/(%i*w_var),
                    concat("sgn(t-t0) -> 2*exp(-iwt0)/(iw), t0=", string(_sg_t0))]
        ),
        /* detect k*sgn(t-t0) */
        if is(res = false) and not atom(e) and is(op(e) = "*") then (
            for _sf in args(e) do (
                if not atom(_sf) and is(op(_sf) = 'sgn)
                then _sg_part: _sf
                else _sg_coef: _sg_coef * _sf
            ),
            if is(_sg_part # false) and freeof(t_var, _sg_coef) then (
                _sg_arg: part(_sg_part, 1),
                _sg_t0: ratsimp(t_var - _sg_arg),
                if freeof(t_var, _sg_t0) and not equal(_sg_t0, 0) then
                    res: [2*_sg_coef*exp(-%i*w_var*_sg_t0)/(%i*w_var),
                        concat("k*sgn(t-t0) -> 2k*exp(-iwt0)/(iw), k=", string(_sg_coef),
                               ", t0=", string(_sg_t0))]
            )
        )
    ),

    /* ── k*rect(a*t+b) -> k*2*sin(w*T/2)/w * exp(-i*w*t0)  (t0=-b/a, T=1/|a|) ──
       FT[rect((t-t0)/T)](w) = integral_{t0-T/2}^{t0+T/2} e^{-iwt} dt
                             = (2/w)*sin(w*T/2)*exp(-i*w*t0).
       rect se trata como función simbólica (no expandida con if/else) para que
       el pattern matcher pueda detectarla antes de intentar la integración. */
    if is(res = false) then block(
        [_rm, _rk, _ra, _rb, _rt0, _rT],
        _rm: FT_match_rect(e, t_var),
        if is(_rm # false) then (
            _rk: _rm[1],
            _ra: _rm[2],
            _rb: _rm[3],
            _rt0: ratsimp(-_rb / _ra),
            _rT:  ratsimp(1 / abs(_ra)),
            res: [_rk * 2 * sin(w_var * _rT / 2) / w_var * exp(-%i * w_var * _rt0),
                  concat("k*rect(a*t+b)->2k*sin(wT/2)/w*exp(-iwt0), T=", string(_rT),
                         ", t0=", string(_rt0))]
        )
    ),

    /* ── k*sinc(a*t+b) -> k*(π/|a|)*rect(ω/(2a)) * exp(-i*ω*t0)  (t0=-b/a) ──
       FT[sinc(a*t)](ω) = FT[sin(at)/(at)](ω) = (π/|a|)*rect(ω/(2a)).
       Convención: sinc(x)=sin(x)/x (no norm.). El rect resultante tiene
       ancho 2|a| en ω centrado en 0; con desplazamiento t0 = -b/a,
       se multiplica por e^{-iωt0} (time-shift). */
    if is(res = false) then block(
        [_sm, _sk, _sa, _sb, _st0, _raw_sinc],
        _sm: FT_match_sinc(e, t_var),
        if is(_sm # false) then (
            _sk: _sm[1],
            _sa: _sm[2],
            _sb: _sm[3],
            _st0: ratsimp(-_sb / _sa),
            /* resultado: k*(pi/|a|)*rect(w/(2*a)) — rect simbólica en w */
            _raw_sinc: _sk * %pi / abs(_sa) * rect(w_var / (2 * _sa)),
            if not equal(ratsimp(_st0), 0) then
                _raw_sinc: _raw_sinc * exp(-%i * w_var * _st0),
            res: [_raw_sinc,
                  concat("k*sinc(a*t+b)->(k*pi/|a|)*rect(w/(2a))*exp(-iwt0), t0=",
                         string(_st0))]
        )
    ),

    /* ── k*sinc(a*t+b)^n (n≥2) — closed-form B-spline via sgn sums ──
       FT[sinc^n(at)](w) = (π/(2^n*(n-1)!)) * Σ C(n,k)*(-1)^k*(n-2k-w/a)^(n-1)*sgn(n-2k-w/a)
       Special case n=2 recovers the tri result. Includes time-shift for b≠0. */
    if is(res = false) then block(
        [_spm, _spk, _spa, _spb, _spn, _raw_sp],
        _spm: FT_match_sinc_pow(e, t_var),
        if is(_spm # false) then (
            _spk: _spm[1],
            _spa: _spm[2],
            _spb: _spm[3],
            _spn: _spm[4],
            _raw_sp: _spk * FT_sincpow_formula(_spa, _spb, _spn, w_var),
            res: [_raw_sp,
                  concat("k*sinc^n(a*t+b) B-spline formula, n=", string(_spn),
                         ", a=", string(_spa), ", t0=", string(ratsimp(-_spb/_spa)))]
        )
    ),

    /* ── k*tri(a*t+b)^n (n=2..4) — closed-form table ──
       FT[tri(at)^n](w) = k * FT_tripow_formula(a, b, n, w).
       Must run BEFORE the n=1 tri matcher below. */
    if is(res = false) then block(
        [_tpm, _tpk, _tpa, _tpb, _tpn, _raw_tp],
        _tpm: FT_match_tri_pow(e, t_var),
        if is(_tpm # false) then (
            _tpk: _tpm[1],
            _tpa: _tpm[2],
            _tpb: _tpm[3],
            _tpn: _tpm[4],
            _raw_tp: errcatch(_tpk * FT_tripow_formula(_tpa, _tpb, _tpn, w_var)),
            if _raw_tp # [] and first(_raw_tp) # false then
                res: [first(_raw_tp),
                      concat("k*tri^n(a*t+b) table formula, n=", string(_tpn),
                             ", a=", string(_tpa), ", t0=", string(ratsimp(-_tpb/_tpa)))]
        )
    ),

    /* ── k*tri(a*t+b) -> k*(2/T)*sin²(w*T/2)/w²  * exp(-i*w*t0)  (T=1/|a|, t0=-b/a) ──
       FT[tri(t/T)](w) = integral_{-T}^{T} (1-|t|/T) e^{-iwt} dt = T*sinc²(wT/(2π))
       Con sinc normalizado: T*(sin(wT/2)/(wT/2))² = 4*sin²(wT/2)/(w²*T).
       Para k*tri((t-t0)/T): multiplicar por e^{-i*w*t0} (time-shift).
       tri se trata simbólicamente — FT_match_tri detecta a y b. */
    if is(res = false) then block(
        [_tm, _tk, _ta, _tb, _tt0, _tT, _raw_tri],
        _tm: FT_match_tri(e, t_var),
        if is(_tm # false) then (
            _tk: _tm[1],
            _ta: _tm[2],
            _tb: _tm[3],
            _tt0: ratsimp(-_tb / _ta),
            _tT:  ratsimp(1 / abs(_ta)),
            _raw_tri: _tk * 4 * sin(w_var * _tT / 2)^2 / (w_var^2 * _tT),
            /* si hay desplazamiento, aplicar time-shift */
            if not equal(ratsimp(_tt0), 0) then
                _raw_tri: _raw_tri * exp(-%i * w_var * _tt0),
            res: [_raw_tri,
                  concat("k*tri(a*t+b)->4k*sin²(wT/2)/(w²T)*exp(-iwt0), T=", string(_tT),
                         ", t0=", string(_tt0))]
        )
    ),

    /* ── k/(t-a)^n -> e^{-iwa}*k*(-iw)^(n-1)/((n-1)!)*(-i*pi*sgn(w))  (a ≠ 0) ──
       Time-shift property: FT[f(t-a)](w) = e^{-iwa} * FT[f(t)](w).
       Combined with FT[1/t^n] = (-iw)^(n-1)/((n-1)!)*(-i*pi*sgn(w)).
       Also handles k/(c*(t-a)^n) — constant c folded into k.
       A denominator const_part = 0 (i.e. no shift) is left to k/t^n below. */
    if is(res = false) then block(
        [_ts_num, _ts_den, _ts_inner, _ts_c, _ts_n, _ts_a, _ts_k,
         _ts_lc, _ts_la, _facs_ts, _tdep_ts, _ok_ts, _f_ts],
        _ts_n: false, _ts_k: false, _ts_a: false,
        if not atom(e) and is(op(e) = "/") then (
            _ts_num: part(e, 1),
            _ts_den: part(e, 2),
            /* Try to factor the denominator: expand() may have opened (t-a)^n
               into a polynomial (e.g. 1/(t-2)^2 → 1/(t^2-4t+4)).
               factor() recovers the compact form when possible. */
            block([_ts_fac],
                _ts_fac: errcatch(factor(_ts_den)),
                if _ts_fac # [] and string(first(_ts_fac)) # string(_ts_den)
                then _ts_den: first(_ts_fac)
            ),
            _ts_inner: _ts_den,
            _ts_c: 1,
            /* Step 1: extract constant coefficient if denominator is a product */
            if not atom(_ts_den) and is(op(_ts_den) = "*") then (
                _facs_ts: args(_ts_den),
                _tdep_ts: false, _ok_ts: true,
                for _f_ts in _facs_ts while _ok_ts do (
                    if freeof(t_var, _f_ts) then _ts_c: _ts_c * _f_ts
                    else if is(_tdep_ts = false) then _tdep_ts: _f_ts
                    else _ok_ts: false    /* >1 t-dependent factor — bail */
                ),
                if _ok_ts and is(_tdep_ts # false) then _ts_inner: _tdep_ts
                else _ts_c: false         /* couldn't factor cleanly */
            ),
            if is(_ts_c # false) then (
                /* Step 2: _ts_inner is (t-a) or (t-a)^n */
                if not atom(_ts_inner) and is(op(_ts_inner) = "^")
                   and integerp(part(_ts_inner, 2)) and is(part(_ts_inner, 2) >= 2) then (
                    _ts_n: part(_ts_inner, 2),
                    _ts_inner: part(_ts_inner, 1)
                ) else _ts_n: 1,
                /* Step 3: _ts_inner must be linear in t_var with nonzero constant term.
                   coef_t = derivative; const_term = value at t=0.
                   const_term = 0 means denominator is plain t^n — skip (handled below). */
                _ts_lc: errcatch(ratsimp(diff(_ts_inner, t_var))),
                _ts_la: errcatch(ratsimp(subst(t_var = 0, _ts_inner))),
                if _ts_lc # [] and _ts_la # []
                   and freeof(t_var, first(_ts_lc)) and not equal(first(_ts_lc), 0)
                   and freeof(t_var, first(_ts_la)) and not equal(first(_ts_la), 0)
                   and ratsimp(_ts_inner - first(_ts_lc)*t_var - first(_ts_la)) = 0 then (
                    /* _ts_inner = coef_t*(t - a),  a = -const/coef_t */
                    _ts_a: ratsimp(-first(_ts_la) / first(_ts_lc)),
                    _ts_k: ratsimp(_ts_num / (_ts_c * first(_ts_lc)^_ts_n)),
                    if freeof(t_var, _ts_k) and freeof(t_var, _ts_a) then
                        res: [_ts_k * exp(-%i*w_var*_ts_a)
                                   * (-%i*w_var)^(_ts_n-1) / factorial(_ts_n-1)
                                   * (-%i*%pi*sgn(w_var)),
                              concat("k/(t-a)^n->e^{-iwa}*k*(-iw)^(n-1)/((n-1)!)*(-i*pi*sgn(w)), n=",
                                     string(_ts_n), ", a=", string(_ts_a), ", k=", string(_ts_k))]
                )
            )
        )
    ),

    /* ── k*abs(t)^m  y  k*abs(t)^m*sgn(t)  ->  FT distribucional, dual de IFT[1/w^n] ──
       Dual exacto del patrón IFT k/w^n (§36 FOURIER_TABLES). Estrategia:
       para m=1..12 intentar dividir e entre abs(t)^m y entre abs(t)^m*sgn(t_var);
       si el cociente es libre de t_var, aplicar la fórmula:
         FT[k*|t|^m]        = k * 2*m! * (-i)^(m+1) / w^(m+1)  (m impar, n=m+1 par)
         FT[k*|t|^m*sgn(t)] = k * 2*m! * (-i)^(m+1) / w^(m+1)  (m par,   n=m+1 impar)
       Solo aplica para abs(t_var) exacto — sin desplazamiento. */
    if is(res = false) then block(
        [_ab_m, _ab_k, _ab_has_sgn, _ab_n, _ab_prod, _ab_quot],
        _ab_m: false, _ab_k: false, _ab_has_sgn: false,
        /* Try m=1..12. Test with sgn first (covers even m), then without (odd m). */
        for _ab_try: 1 thru 12 while is(_ab_m = false) do (
            /* Test: e / (abs(t_var)^_ab_try * sgn(t_var)) — m even, n odd */
            if evenp(_ab_try) then (
                _ab_prod: errcatch(ratsimp(e / (abs(t_var)^_ab_try * sgn(t_var)))),
                if _ab_prod # [] then (
                    _ab_quot: first(_ab_prod),
                    if freeof(t_var, _ab_quot) and not equal(_ab_quot, 0)
                       and freeof('abs, _ab_quot) and freeof('sgn, _ab_quot) then (
                        _ab_m: _ab_try, _ab_k: _ab_quot, _ab_has_sgn: true
                    )
                )
            ),
            /* Test: e / abs(t_var)^_ab_try — m odd, n even */
            if is(_ab_m = false) and oddp(_ab_try) then (
                _ab_prod: errcatch(ratsimp(e / abs(t_var)^_ab_try)),
                if _ab_prod # [] then (
                    _ab_quot: first(_ab_prod),
                    if freeof(t_var, _ab_quot) and not equal(_ab_quot, 0)
                       and freeof('abs, _ab_quot) and freeof('sgn, _ab_quot) then (
                        _ab_m: _ab_try, _ab_k: _ab_quot, _ab_has_sgn: false
                    )
                )
            )
        ),
        if is(_ab_m # false) then (
            _ab_n: _ab_m + 1,
            res: [ratsimp(_ab_k * 2 * factorial(_ab_m) * (-%i)^_ab_n / w_var^_ab_n),
                  concat("k*abs(t)^m[*sgn(t)]->2m!*(-i)^n/w^n, m=",
                         string(_ab_m), ", sgn=", string(_ab_has_sgn),
                         ", k=", string(_ab_k))]
        )
    ),

    /* ── k/t^n -> k*(-iw)^(n-1)/((n-1)!)*(-i*pi*sgn(w))  (n >= 1, entero) ──
       Transformada distribucional (valor principal de Cauchy).
       n=1: k/t -> -i*pi*k*sgn(w)
       n≥2: FT[k/t^n] = k*(-iw)^(n-1)/((n-1)!)*(-i*pi*sgn(w))
       Extended to handle k/(c*t^n) — constant c extracted from product denominator. */
    if is(res = false) then block(
        [_tn_num, _tn_den, _tn_k, _tn_n, _facs_d, _c_part, _t_dep, _ok_d, _f_d],
        _tn_n: false, _tn_k: false,
        if not atom(e) and is(op(e) = "/") then (
            _tn_num: part(e, 1),
            _tn_den: part(e, 2),
            /* Case A: denominator is exactly t_var or t_var^n */
            if is(_tn_den = t_var) then (
                _tn_n: 1, _tn_k: _tn_num
            ) else if not atom(_tn_den) and is(op(_tn_den) = "^")
                      and is(part(_tn_den, 1) = t_var)
                      and integerp(part(_tn_den, 2))
                      and is(part(_tn_den, 2) >= 2) then (
                _tn_n: part(_tn_den, 2), _tn_k: _tn_num
            ),
            /* Case B: denominator is c*t_var^n — extract constant coefficient */
            if is(_tn_n = false) and not atom(_tn_den) and is(op(_tn_den) = "*") then (
                _facs_d: args(_tn_den), _c_part: 1, _t_dep: false, _ok_d: true,
                for _f_d in _facs_d while _ok_d do (
                    if freeof(t_var, _f_d) then _c_part: _c_part * _f_d
                    else if is(_t_dep = false) then (
                        if _f_d = t_var then (_t_dep: _f_d, _tn_n: 1)
                        else if not atom(_f_d) and is(op(_f_d) = "^")
                                and is(part(_f_d, 1) = t_var)
                                and integerp(part(_f_d, 2)) and is(part(_f_d, 2) >= 2)
                        then (_t_dep: _f_d, _tn_n: part(_f_d, 2))
                        else _ok_d: false
                    ) else _ok_d: false    /* >1 t-dependent factor */
                ),
                if _ok_d and is(_t_dep # false) and freeof(t_var, _c_part)
                then _tn_k: ratsimp(_tn_num / _c_part)
                else _tn_n: false
            ),
            if is(_tn_n # false) and freeof(t_var, _tn_k) then
                res: [_tn_k * (-%i*w_var)^(_tn_n-1) / factorial(_tn_n-1)
                             * (-%i*%pi*sgn(w_var)),
                      concat("k/t^n -> k*(-iw)^(n-1)/((n-1)!)*(-i*pi*sgn(w)), n=",
                             string(_tn_n), ", k=", string(_tn_k))]
        )
    ),

    /* ── k*exp(-a*abs(t)) -> 2*a*k/(a^2+w^2)  (a > 0) ──
       Transformada bilateral del decaimiento exponencial simétrico.
       Inversa de: IFT[k/(a^2+w^2)] = k*exp(-a|t|)/(2a). */
    if is(res = false) then block(
        [_ea_exp, _ea_k, _ea_arg, _ea_cn, _ea_a],
        _ea_exp: false, _ea_k: 1,
        if not atom(e) then (
            if is(op(e) = "^") and is(part(e, 1) = %e) then
                _ea_exp: e
            else if is(op(e) = "*") then
                for _s in args(e) do (
                    if is(_ea_exp = false) and not atom(_s)
                       and is(op(_s) = "^") and is(part(_s, 1) = %e)
                       and not freeof('abs, _s)
                    then _ea_exp: _s
                    else _ea_k: _ea_k * _s
                )
        ),
        if is(_ea_exp # false) then (
            _ea_arg: part(_ea_exp, 2),
            if not freeof('abs, _ea_arg) then (
                _ea_cn: errcatch(ratsimp(_ea_arg / abs(t_var))),
                if _ea_cn # [] and freeof(t_var, first(_ea_cn))
                   and is(first(_ea_cn) < 0)
                   and ratsimp(_ea_arg - first(_ea_cn)*abs(t_var)) = 0
                   and freeof(t_var, _ea_k) then (
                    _ea_a: -first(_ea_cn),
                    res: [2*_ea_a*_ea_k / (_ea_a^2 + w_var^2),
                          concat("k*exp(-a|t|)->2ak/(a^2+w^2), a=", string(_ea_a))]
                )
            )
        )
    ),

    /* ── k*sin(at)/(pi*t) -> k*(u(w+a)-u(w-a))  (a > 0) ── */
    if is(res = false) then block(
        [num_s, den_s, sin_part, kk2, sin_arg, aa, den_coef],

        if not atom(e) and is(op(e) = "/") then (
            num_s: expand(part(e, 1)),
            den_s: expand(part(e, 2)),
            /* denominador debe ser k*pi*t — extraer coeficiente */
            den_coef: ratsimp(den_s / (%pi * t_var)),
            if freeof(t_var, den_coef) and is(den_coef > 0) then (
                /* numerador: sin(at) o k*sin(at) */
                if not atom(num_s) and is(op(num_s) = 'sin) then (
                    sin_arg: part(num_s, 1),
                    aa: ratsimp(sin_arg / t_var),
                    if freeof(t_var, aa) and is(aa > 0) then
                        res: [(1/den_coef) * (u(w_var + aa) - u(w_var - aa)),
                            concat("sin(at)/(k*pi*t) -> (1/k)*(u(w+a)-u(w-a)), a=",
                                    string(aa), ", k=", string(den_coef))]
                ) else if not atom(num_s) and is(op(num_s) = "*") then block(
                    [sin_part2, kk3],
                    sin_part2: false,
                    kk3: 1,
                    for s in args(num_s) do (
                        if not atom(s) and is(op(s) = 'sin)
                        then sin_part2: s
                        else kk3: kk3 * s
                    ),
                    if is(sin_part2 # false) then (
                        sin_arg: part(sin_part2, 1),
                        aa: ratsimp(sin_arg / t_var),
                        if freeof(t_var, aa) and is(aa > 0) then
                            res: [(kk3/den_coef) * (u(w_var + aa) - u(w_var - aa)),
                                concat("k*sin(at)/(n*pi*t) -> (k/n)*(u(w+a)-u(w-a)), a=",
                                        string(aa))]
                    )
                )
            )
        )
    ),

    /* ── k*exp(-at)*u(t) -> k/(iw+a)  (a > 0) ──
       Detecta producto con factor u(t_var) y factor exp con t_var.
       Solo activa si NO hay factor trigonometrico (sin/cos) — esos
       casos los manejan los dos patrones siguientes.
       NOTA: exp_part requiere part(s,1)=%e para no confundir t^n con exp. */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [u_part, exp_part, trig_part, coef_k, exp_arg, aa],
            u_part: false,
            exp_part: false,
            trig_part: false,
            coef_k: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u) and part(s,1) = t_var
                then u_part: s
                else if not atom(s) and is(op(s) = "^")
                     and is(part(s, 1) = %e)
                     and not freeof(t_var, s)
                then exp_part: s
                else if not atom(s) and (is(op(s) = 'sin) or is(op(s) = 'cos))
                then trig_part: s
                else coef_k: coef_k * s
            ),
            if is(u_part # false) and is(exp_part # false)
               and is(trig_part = false) then (
                exp_arg: part(exp_part, 2),
                aa: ratsimp(exp_arg / (-t_var)),
                if freeof(t_var, coef_k) and freeof(t_var, aa) and is(aa > 0) then
                    res: [coef_k / (%i*w_var + aa),
                          concat("k*exp(-at)*u(t) -> k/(iw+a), a=", string(aa))]
            )
        )
    ),

    /* ── k*exp(-a*t)*u(t-t0) -> k*exp(-a*t0)*e^{-iwt0}/(iw+a)  (a>0, t0>=0) ──
       Cubre el caso desplazado: exp(-at) = exp(-a*(t-t0)) * exp(-at0).
       El patrón anterior k*exp(-at)*u(t) requiere u(t) no desplazado;
       este cubre u(t-t0) con t0 != 0. Prioridad: va despues del no-desplazado. */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [_u_part, _exp_part, _coef_k, _u_arg, _t0, _exp_arg, _aa],
            _u_part: false,
            _exp_part: false,
            _coef_k: 1,
            for _s in args(e) do (
                if not atom(_s) and is(op(_s) = 'u)
                then _u_part: _s
                else if not atom(_s) and is(op(_s) = "^")
                     and is(part(_s, 1) = %e)
                     and not freeof(t_var, _s)
                then _exp_part: _s
                else _coef_k: _coef_k * _s
            ),
            if is(_u_part # false) and is(_exp_part # false)
               and freeof(t_var, _coef_k) then (
                _u_arg: part(_u_part, 1),
                _t0: ratsimp(t_var - _u_arg),
                _exp_arg: part(_exp_part, 2),
                _aa: ratsimp(_exp_arg / (-t_var)),
                if freeof(t_var, _t0) and freeof(t_var, _aa)
                   and is(_aa > 0) and not equal(_t0, 0) then
                    res: [_coef_k * exp(-_aa*_t0) * exp(-%i*w_var*_t0) / (%i*w_var + _aa),
                          concat("k*exp(-at)*u(t-t0) -> k*exp(-at0)*e^{-iwt0}/(iw+a), a=",
                                 string(_aa), ", t0=", string(_t0))]
            )
        )
    ),

    /* ── k*t^n*exp(-at)*u(t-t0) -> k*exp(-at0)*e^{-iwt0}*S  (a>0, n>=1) ──
       S = sum_{j=0}^{n} C(n,j)*t0^{n-j}*j! / (iw+a)^{j+1}
       Derivado de: FT[t^n*exp(-at)*u(t-t0)] = exp(-(a+iw)*t0) * integral de
       (s+t0)^n*exp(-as)*ds sobre [0,inf), expandiendo con binomio de Newton.
       Casos cubiertos directamente:
         n=1, t0=0: t*exp(-at)*u(t)    -> 1/(iw+a)^2
         n=2, t0=0: t^2*exp(-at)*u(t)  -> 2/(iw+a)^3  [corrige resultado incorrecto anterior]
         n=1, t0≠0: t*exp(-at)*u(t-t0) -> componente al combinar via linealidad
       Via expand()+linealidad cubre (t-t0)^n*exp(-at)*u(t-t0) completo. */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [_u_part, _exp_part, _const_k, _t_mono, _u_arg, _t0, _exp_arg,
             _aa, _n, _c_mono, _sum, _j],
            _u_part: false,
            _exp_part: false,
            _const_k: 1,
            _t_mono: 1,
            for _s in args(e) do (
                if not atom(_s) and is(op(_s) = 'u)
                then _u_part: _s
                else if not atom(_s) and is(op(_s) = "^")
                     and is(part(_s, 1) = %e)
                     and not freeof(t_var, _s)
                then _exp_part: _s
                else if freeof(t_var, _s)
                then _const_k: _const_k * _s
                else _t_mono: _t_mono * _s
            ),
            if is(_u_part # false) and is(_exp_part # false)
               and not freeof(t_var, _t_mono) then (
                _u_arg: part(_u_part, 1),
                _t0: ratsimp(t_var - _u_arg),
                _exp_arg: part(_exp_part, 2),
                _aa: ratsimp(_exp_arg / (-t_var)),
                if freeof(t_var, _t0) and freeof(t_var, _aa) and is(_aa > 0) then (
                    /* _t_mono debe ser monomio puro: _c_mono * t_var^n */
                    _n: hipow(rat(_t_mono), t_var),
                    _c_mono: ratsimp(_t_mono / t_var^_n),
                    if is(_n >= 1) and freeof(t_var, _c_mono)
                       and ratsimp(_t_mono - _c_mono * t_var^_n) = 0 then (
                        _sum: 0,
                        for _j: 0 thru _n do
                            _sum: _sum + binomial(_n, _j)
                                       * (if _n - _j = 0 then 1 else _t0^(_n - _j))
                                       * factorial(_j) / (%i*w_var + _aa)^(_j+1),
                        res: [_const_k * _c_mono
                              * exp(-_aa * _t0) * exp(-%i*w_var*_t0) * _sum,
                              concat("k*t^n*exp(-at)*u(t-t0) n=", string(_n),
                                     " a=", string(_aa), " t0=", string(_t0))]
                    )
                )
            )
        )
    ),

    /* ── k*exp(-at)*cos(bt)*u(t) -> k*(iw+a)/((iw+a)^2+b^2)  (a,b > 0) ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [u_part, exp_part, cos_part, coef_k, exp_arg, cos_arg, aa, bb],
            u_part: false,
            exp_part: false,
            cos_part: false,
            coef_k: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u) and part(s,1) = t_var
                then u_part: s
                else if not atom(s) and is(op(s) = 'cos)
                then cos_part: s
                else if not atom(s) and is(op(s) = "^")
                     and is(part(s, 1) = %e)
                     and not freeof(t_var, s)
                then exp_part: s
                else coef_k: coef_k * s
            ),
            if is(u_part # false) and is(exp_part # false)
               and is(cos_part # false) then (
                exp_arg: part(exp_part, 2),
                aa: ratsimp(exp_arg / (-t_var)),
                cos_arg: part(cos_part, 1),
                bb: ratsimp(cos_arg / t_var),
                if freeof(t_var, coef_k) and freeof(t_var, aa) and freeof(t_var, bb)
                   and is(aa > 0) and is(bb > 0) then
                    res: [coef_k * (%i*w_var + aa) / ((%i*w_var + aa)^2 + bb^2),
                          concat("k*exp(-at)*cos(bt)*u(t) -> k*(iw+a)/((iw+a)^2+b^2), a=",
                                 string(aa), ", b=", string(bb))]
            )
        )
    ),

    /* ── k*exp(-at)*sin(bt)*u(t) -> k*b/((iw+a)^2+b^2)  (a,b > 0) ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [u_part, exp_part, sin_part, coef_k, exp_arg, sin_arg, aa, bb],
            u_part: false,
            exp_part: false,
            sin_part: false,
            coef_k: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u) and part(s,1) = t_var
                then u_part: s
                else if not atom(s) and is(op(s) = 'sin)
                then sin_part: s
                else if not atom(s) and is(op(s) = "^")
                     and is(part(s, 1) = %e)
                     and not freeof(t_var, s)
                then exp_part: s
                else coef_k: coef_k * s
            ),
            if is(u_part # false) and is(exp_part # false)
               and is(sin_part # false) then (
                exp_arg: part(exp_part, 2),
                aa: ratsimp(exp_arg / (-t_var)),
                sin_arg: part(sin_part, 1),
                bb: ratsimp(sin_arg / t_var),
                if freeof(t_var, coef_k) and freeof(t_var, aa) and freeof(t_var, bb)
                   and is(aa > 0) and is(bb > 0) then
                    res: [coef_k * bb / ((%i*w_var + aa)^2 + bb^2),
                          concat("k*exp(-at)*sin(bt)*u(t) -> k*b/((iw+a)^2+b^2), a=",
                                 string(aa), ", b=", string(bb))]
            )
        )
    ),

    /* ── ANTI-CAUSAL family: k*exp(at)*u(-t) -> k/(a-iw)  (a > 0) ──
       Also handles cos/sin modulated variants. */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [u_part, exp_part, cos_part, sin_part, coef_k,
             exp_arg, u_arg, aa, bb],
            u_part: false,
            exp_part: false,
            cos_part: false,
            sin_part: false,
            coef_k: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u)
                then u_part: s
                else if not atom(s) and is(op(s) = "^")
                     and is(part(s, 1) = %e)
                     and not freeof(t_var, s)
                then exp_part: s
                else if not atom(s) and is(op(s) = 'cos)
                then cos_part: s
                else if not atom(s) and is(op(s) = 'sin)
                then sin_part: s
                else coef_k: coef_k * s
            ),
            if is(u_part # false) and is(exp_part # false) then (
                u_arg: part(u_part, 1),
                /* Gate must be u(-t), i.e. u_arg = -t_var */
                if ratsimp(u_arg + t_var) = 0 then (
                    exp_arg: part(exp_part, 2),
                    /* exp(at)*u(-t): exp_arg / t_var = a > 0 */
                    aa: ratsimp(exp_arg / t_var),
                    if freeof(t_var, aa) and freeof(t_var, coef_k)
                       and is(aa > 0) then (
                        if is(cos_part = false) and is(sin_part = false) then (
                            /* k*exp(at)*u(-t) -> k/(a - iw) */
                            res: [coef_k / (aa - %i*w_var),
                                  concat("k*exp(at)*u(-t) -> k/(a-iw), a=",
                                         string(aa))]
                        ) else if is(cos_part # false) and is(sin_part = false) then (
                            /* k*exp(at)*cos(bt)*u(-t) -> k*(a-iw)/((a-iw)^2+b^2) */
                            bb: ratsimp(part(cos_part, 1) / t_var),
                            if freeof(t_var, bb) and is(bb > 0) then
                                res: [coef_k * (aa - %i*w_var)
                                          / ((aa - %i*w_var)^2 + bb^2),
                                      concat("k*exp(at)*cos(bt)*u(-t) -> k*(a-iw)/((a-iw)^2+b^2), a=",
                                             string(aa), ", b=", string(bb))]
                        ) else if is(sin_part # false) and is(cos_part = false) then (
                            /* k*exp(at)*sin(bt)*u(-t) -> -k*b/((a-iw)^2+b^2) */
                            bb: ratsimp(part(sin_part, 1) / t_var),
                            if freeof(t_var, bb) and is(bb > 0) then
                                res: [- coef_k * bb
                                          / ((aa - %i*w_var)^2 + bb^2),
                                      concat("k*exp(at)*sin(bt)*u(-t) -> -k*b/((a-iw)^2+b^2), a=",
                                             string(aa), ", b=", string(bb))]
                        )
                    )
                )
            )
        )
    ),

    /* ── sin(w0*t)*u(t) -> w0/(w0^2-w^2) + pi/(2i)*[delta(w-w0)-delta(w+w0)] ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [u_part, sin_part, coef_k, sin_arg, w0],
            u_part: false,
            sin_part: false,
            coef_k: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u) and part(s,1) = t_var
                then u_part: s
                else if not atom(s) and is(op(s) = 'sin)
                then sin_part: s
                else coef_k: coef_k * s
            ),
            if is(u_part # false) and is(sin_part # false) then (
                sin_arg: part(sin_part, 1),
                w0: ratsimp(sin_arg / t_var),
                if freeof(t_var, w0) and is(w0 > 0) then
                    res: [coef_k * (w0/(w0^2 - w_var^2)
                        + %piexact/(2*%i) * (delta(w_var-w0) - delta(w_var+w0))),
                        concat("sin(w0t)*u(t) -> w0/(w0^2-w^2)+pi/2i*[delta(w-w0)-delta(w+w0)], w0=",
                                string(w0))]
            )
        )
    ),

    /* ── cos(w0*t)*u(t) -> i*w/(w0^2-w^2) + pi/2*[delta(w-w0)+delta(w+w0)] ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [u_part, cos_part, coef_k, cos_arg, w0],
            u_part: false,
            cos_part: false,
            coef_k: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'u) and part(s,1) = t_var
                then u_part: s
                else if not atom(s) and is(op(s) = 'cos)
                then cos_part: s
                else coef_k: coef_k * s
            ),
            if is(u_part # false) and is(cos_part # false) then (
                cos_arg: part(cos_part, 1),
                w0: ratsimp(cos_arg / t_var),
                if freeof(t_var, w0) and is(w0 > 0) then
                    res: [coef_k * (%i*w_var/(w0^2 - w_var^2)
                        + %piexact/2 * (delta(w_var-w0) + delta(w_var+w0))),
                        concat("cos(w0t)*u(t) -> i*w/(w0^2-w^2)+pi/2*[delta(w-w0)+delta(w+w0)], w0=",
                                string(w0))]
            )
        )
    ),

    /* ── k/(A*t^2+B*t+C) — Lorentziana generalizada  (discriminante < 0) ──
       Completa el cuadrado: A*(t-t0)^2 + a^2  donde t0=-B/(2A), a^2=(4AC-B^2)/(4A)
       FT = (kπ/(A*a)) * e^{-a|w|}                    si t0 = 0
          = (kπ/(A*a)) * e^{-a|w|} * e^{-i*w*t0}      si t0 ≠ 0
       Cubre casos simples (t0=0) y desplazados (e.g. 1/(t^2-4t+13)).
       ratdisrep() antes de sqrt() evita flotantes (ver nota en beg. file). */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "/") then block(
            [_numer, _denom, _A, _B, _C, _disc, _t0, _asq, _acand, _k],
            _numer: part(e, 1),
            _denom: rat(rationalize(expand(part(e, 2)))),
            if freeof(t_var, _numer) and not freeof(t_var, _denom) then (
                _A: ratdisrep(rat(coeff(_denom, t_var, 2))),
                _B: ratdisrep(rat(coeff(_denom, t_var, 1))),
                _C: ratdisrep(ratsimp(subst(t_var=0, _denom))),
                if freeof(t_var, _A) and freeof(t_var, _B) and freeof(t_var, _C)
                   and is(_A > 0)
                   and ratsimp(_denom - (_A*t_var^2 + _B*t_var + _C)) = 0 then (
                    _disc: ratsimp(_B^2 - 4*_A*_C),
                    /* Accept when disc is numerically negative OR symbolically
                       free of t_var (assume user supplies a valid function) */
                    if errcatch(is(_disc < 0)) = [true]
                       or (not numberp(_disc) and freeof(t_var, _disc)) then (
                        _t0: ratsimp(-_B / (2*_A)),
                        _asq: ratsimp(-_disc / (4*_A)),
                        _acand: sqrt(ratdisrep(rat(_asq))),
                        /* For symbolic _acand skip positivity check — assume valid */
                        if freeof(t_var, _acand)
                           and (errcatch(is(_acand > 0)) = [true] or not numberp(_acand)) then (
                            _k: ratsimp(_numer / _A),
                            if freeof(t_var, _k) then (
                                if ratsimp(_t0) = 0 then
                                    res: [_k * (%piexact/_acand) * exp(-_acand*abs(w_var)),
                                          concat("k/(a^2+t^2) -> (kπ/a)*e^{-a|w|}, a=",
                                                 string(_acand))]
                                else
                                    res: [_k * (%piexact/_acand) * exp(-_acand*abs(w_var))
                                              * exp(-%i*w_var*_t0),
                                          concat("k/(A(t-t0)^2+a^2) -> (kπ/Aa)*e^{-a|w|}*e^{-iwt0}, t0=",
                                                 string(_t0), ", a=", string(_acand))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── cos(bt)/(a^2+t^2) -> (pi/2a)*[e^{-a|w-b|}+e^{-a|w+b|}] ── */
    if is(res = false) then block(
        [enum, eden, cos_arg, bb, sqt, dct, ac, kk, _q2,
         cos_part, rest, denom2, sq2, dc2, aa2, _q3],

        if not atom(e) and is(op(e) = "/") then (
            enum: expand(part(e, 1)),
            eden: rat(rationalize(expand(part(e, 2)))),
            if not atom(enum) and is(op(enum) = 'cos)
               and not freeof(t_var, eden) then (
                cos_arg: part(enum, 1),
                bb: ratsimp(cos_arg / t_var),
                if freeof(t_var, bb) then (
                    sqt: rat(coeff(eden, t_var, 2)),
                    dct: ratsimp(subst(t_var=0, eden)),
                    if freeof(t_var, sqt) and freeof(t_var, dct)
                       and is(sqt > 0) and is(dct > 0) then (
                        _q2: rat(dct / sqt),
                        ac: sqrt(ratdisrep(_q2)),
                        if freeof(t_var, ac) and is(ac > 0) then (
                            kk: ratsimp(1 / sqt),
                            res: [kk * (%piexact/(2*ac)) *
                                  (exp(-ac*abs(w_var-bb)) + exp(-ac*abs(w_var+bb))),
                                  concat("cos(bt)/(a^2+t^2) -> (pi/2a)[e^{-a|w-b|}+e^{-a|w+b|}], a=",
                                         string(ac), ", b=", string(bb))]
                        )
                    )
                )
            )
        ),

        if is(res = false) and not atom(e) and is(op(e) = "*") then (
            cos_part: false,
            rest: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'cos)
                then cos_part: s
                else rest: rest * s
            ),
            if is(cos_part # false) then (
                cos_arg: part(cos_part, 1),
                bb: ratsimp(cos_arg / t_var),
                if freeof(t_var, bb) then (
                    if not atom(rest) and is(op(rest) = "/") then (
                        denom2: rat(rationalize(expand(part(rest, 2)))),
                        sq2: rat(coeff(denom2, t_var, 2)),
                        dc2: ratsimp(subst(t_var=0, denom2)),
                        if freeof(t_var, sq2) and freeof(t_var, dc2)
                           and is(sq2 > 0) and is(dc2 > 0) then (
                            _q3: rat(dc2 / sq2),
                            aa2: sqrt(ratdisrep(_q3)),
                            if freeof(t_var, aa2) and is(aa2 > 0) then (
                                kk: ratsimp(part(rest,1) / sq2),
                                res: [kk * (%piexact/(2*aa2)) *
                                      (exp(-aa2*abs(w_var-bb)) + exp(-aa2*abs(w_var+bb))),
                                      concat("cos(bt)/(a^2+t^2) -> (pi/2a)[e^{-a|w-b|}+e^{-a|w+b|}], a=",
                                             string(aa2), ", b=", string(bb))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── sin(bt)/(a^2+t^2) -> (pi/2ai)*[e^{-a|w-b|}-e^{-a|w+b|}] ── */
    if is(res = false) then block(
        [enum2, eden2, sin_arg, bb2, sqt2, dct2, ac2, kk2, _q4,
         sin_part, rest3, denom3, sq3, dc3, aa3, _q5],

        if not atom(e) and is(op(e) = "/") then (
            enum2: expand(part(e, 1)),
            eden2: rat(rationalize(expand(part(e, 2)))),
            if not atom(enum2) and is(op(enum2) = 'sin)
               and not freeof(t_var, eden2) then (
                sin_arg: part(enum2, 1),
                bb2: ratsimp(sin_arg / t_var),
                if freeof(t_var, bb2) then (
                    sqt2: rat(coeff(eden2, t_var, 2)),
                    dct2: ratsimp(subst(t_var=0, eden2)),
                    if freeof(t_var, sqt2) and freeof(t_var, dct2)
                       and is(sqt2 > 0) and is(dct2 > 0) then (
                        _q4: rat(dct2 / sqt2),
                        ac2: sqrt(ratdisrep(_q4)),
                        if freeof(t_var, ac2) and is(ac2 > 0) then (
                            kk2: ratsimp(1 / sqt2),
                            res: [kk2 * (%piexact/(2*ac2*%i)) *
                                  (exp(-ac2*abs(w_var-bb2)) - exp(-ac2*abs(w_var+bb2))),
                                  concat("sin(bt)/(a^2+t^2) -> (pi/2ai)[e^{-a|w-b|}-e^{-a|w+b|}], a=",
                                         string(ac2), ", b=", string(bb2))]
                        )
                    )
                )
            )
        ),

        if is(res = false) and not atom(e) and is(op(e) = "*") then (
            sin_part: false,
            rest3: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = 'sin)
                then sin_part: s
                else rest3: rest3 * s
            ),
            if is(sin_part # false) then (
                sin_arg: part(sin_part, 1),
                bb2: ratsimp(sin_arg / t_var),
                if freeof(t_var, bb2) then (
                    if not atom(rest3) and is(op(rest3) = "/") then (
                        denom3: rat(rationalize(expand(part(rest3, 2)))),
                        sq3: rat(coeff(denom3, t_var, 2)),
                        dc3: ratsimp(subst(t_var=0, denom3)),
                        if freeof(t_var, sq3) and freeof(t_var, dc3)
                           and is(sq3 > 0) and is(dc3 > 0) then (
                            _q5: rat(dc3 / sq3),
                            aa3: sqrt(ratdisrep(_q5)),
                            if freeof(t_var, aa3) and is(aa3 > 0) then (
                                kk2: ratsimp(part(rest3,1) / sq3),
                                res: [kk2 * (%piexact/(2*aa3*%i)) *
                                      (exp(-aa3*abs(w_var-bb2)) - exp(-aa3*abs(w_var+bb2))),
                                      concat("sin(bt)/(a^2+t^2) -> (pi/2ai)[e^{-a|w-b|}-e^{-a|w+b|}], a=",
                                             string(aa3), ", b=", string(bb2))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── c*t/(a^2+t^2) -> -i*c*pi*sgn(w)*e^{-a|w|}  (a > 0) ──
       Par: FT[t/(a^2+t^2)] = -i*pi*sgn(w)*e^{-a|w|}
       Detecta numerador proporcional a t_var, denominador tipo a^2+t^2. */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "/") then block(
            [_num_t, _den_t, _cc, _sqt, _dct, _ac, _q],
            _num_t: expand(part(e, 1)),
            _den_t: rat(rationalize(expand(part(e, 2)))),
            /* numerador: c*t (lineal en t, sin termino independiente) */
            _cc: ratsimp(_num_t / t_var),
            if freeof(t_var, _cc) and not equal(_cc, 0)
               and ratsimp(_num_t - _cc*t_var) = 0 then (
                /* denominador: a^2 + t^2 */
                _sqt: rat(coeff(_den_t, t_var, 2)),
                _dct: ratsimp(subst(t_var=0, _den_t)),
                if freeof(t_var, _sqt) and freeof(t_var, _dct)
                   and is(_sqt > 0) and is(_dct > 0) then (
                    _q: rat(_dct / _sqt),
                    _ac: sqrt(ratdisrep(_q)),
                    if freeof(t_var, _ac) and is(_ac > 0) then (
                        _cc: ratsimp(_cc / _sqt),
                        res: [-%i * _cc * %piexact * sgn(w_var) * exp(-_ac*abs(w_var)),
                              concat("c*t/(a^2+t^2) -> -i*c*pi*sgn(w)*e^{-a|w|}, a=",
                                     string(_ac), ", c=", string(_cc))]
                    )
                )
            )
        )
    ),

    /* ── k/cosh(bt) -> (kπ/b) * sech(πω/(2b))  [= (kπ/b)/cosh(πω/(2b))]
       FT[sech(bt)](ω) = (π/b) · sech(πω/(2b))
       Derived from the even kernel K(λ) = ∫ e^{iλt}/cosh(πt/2) dt = 2/cosh(λ),
       or equivalently from cos(at)/cosh(bt) with a=0.
       The result is returned as 1/cosh() for plotter compatibility; FT_to_sech
       rewrites it to sech() notation in the TeX display stream.
       Matches: k/cosh(b*t) or k*(1/cosh(b*t)), b>0.
       ── */
    if is(res = false) then block(
        [_se_cosh, _se_coef, _se_b],
        _se_cosh: false,
        _se_coef: 1,
        /* Case 1: e = 1/cosh(b*t)  →  op="/", part(e,1)=1, part(e,2)=cosh(...) */
        if not atom(e) and is(op(e) = "/") and is(part(e, 1) = 1)
           and not atom(part(e, 2)) and is(op(part(e, 2)) = 'cosh)
        then _se_cosh: part(e, 2)
        /* Case 2: e = k/cosh(b*t)  →  op="/", part(e,1)=k (atom or expr free of t), part(e,2)=cosh(...) */
        else if not atom(e) and is(op(e) = "/")
           and freeof(t_var, part(e, 1))
           and not atom(part(e, 2)) and is(op(part(e, 2)) = 'cosh)
        then (_se_coef: part(e, 1), _se_cosh: part(e, 2))
        /* Case 2b: e = k/(c*cosh(b*t))  →  op="/", denominator is a product containing cosh.
           expand() turns 1/(2*cosh(πt/2)) into 1/(2*cosh(πt/2)) with op="/" and den=2*cosh(...).
           Mirrors the same extraction already used in the IFT single-sech handler. */
        else if not atom(e) and is(op(e) = "/")
           and freeof(t_var, part(e, 1))
           and not atom(part(e, 2)) and is(op(part(e, 2)) = "*") then (
            _se_coef: part(e, 1),
            for _s in args(part(e, 2)) do (
                if not atom(_s) and is(op(_s) = 'cosh) then _se_cosh: _s
                else if freeof(t_var, _s) then _se_coef: _se_coef / _s
            )
        )
        /* Case 3: e = k * (1/cosh(b*t))  →  op="*", one factor is 1/cosh */
        else if not atom(e) and is(op(e) = "*") then (
            for _s in args(e) do (
                if not atom(_s) and is(op(_s) = "/")
                   and is(part(_s, 1) = 1)
                   and not atom(part(_s, 2)) and is(op(part(_s, 2)) = 'cosh)
                then _se_cosh: part(_s, 2)
                else if freeof(t_var, _s) then _se_coef: _se_coef * _s
            )
        ),
        if is(_se_cosh # false) then (
            _se_b: ratsimp(part(_se_cosh, 1) / t_var),
            if freeof(t_var, _se_b) and freeof(t_var, _se_coef)
               and is(_se_b > 0) then
                res: [_se_coef * (%piexact / _se_b)
                        * (1/cosh(%piexact * w_var / (2 * _se_b))),
                      concat("k/cosh(bt) -> (kπ/b)*sech(πω/(2b)), b=",
                             string(_se_b))]
        )
    ),

    /* ── k*sin(at)/sinh(bt) -> k*(pi/(2b))*(tanh(pi(a-w)/(2b)) + tanh(pi(a+w)/(2b)))
       Derived via K(λ) = ∫ e^{iλt}/sinh(t) dt = πi·tanh(λπ/2).
       For sin(at)/sinh(bt): substitute t→t/b, use linearity + odd symmetry.
       Handles both op="/" (direct ratio) and op="*" (with 1/sinh factor).
       Matches: k * sin(a*t) / sinh(b*t), a>0, b>0.
       ── */
    if is(res = false) then block(
        [_sh_sin, _sh_sinh, _sh_coef, _sh_a, _sh_b, _sh_e],
        _sh_sin: false,
        _sh_sinh: false,
        _sh_coef: 1,
        /* Handle e = k*sin(...)/sinh(...) with op="/" */
        if not atom(e) and is(op(e) = "/") then (
            _sh_e: part(e, 1),  /* numerator */
            /* numerator may be k*sin(...) or just sin(...) */
            if not atom(_sh_e) and is(op(_sh_e) = 'sin) then (
                _sh_sin: _sh_e,
                _sh_sinh: errcatch(part(e, 2)),
                if _sh_sinh # [] then _sh_sinh: first(_sh_sinh) else _sh_sinh: false,
                if not atom(_sh_sinh) and is(op(_sh_sinh) = 'sinh)
                then _sh_coef: 1
                else _sh_sinh: false
            ) else if not atom(_sh_e) and is(op(_sh_e) = "*") then (
                for _s in args(_sh_e) do (
                    if not atom(_s) and is(op(_s) = 'sin) then _sh_sin: _s
                    else _sh_coef: _sh_coef * _s
                ),
                _sh_sinh: errcatch(part(e, 2)),
                if _sh_sinh # [] then _sh_sinh: first(_sh_sinh) else _sh_sinh: false,
                if not (not atom(_sh_sinh) and is(op(_sh_sinh) = 'sinh))
                then _sh_sinh: false
            )
        ),
        if is(_sh_sin # false) and is(_sh_sinh # false) then (
            _sh_a: ratsimp(part(_sh_sin, 1) / t_var),
            _sh_b: ratsimp(part(_sh_sinh, 1) / t_var),
            if freeof(t_var, _sh_a) and freeof(t_var, _sh_b)
               and freeof(t_var, _sh_coef)
               and is(_sh_a > 0) and is(_sh_b > 0) then
                res: [_sh_coef * (%piexact / (2*_sh_b))
                        * (tanh(%piexact*(_sh_a - w_var) / (2*_sh_b))
                           + tanh(%piexact*(_sh_a + w_var) / (2*_sh_b))),
                      concat("k*sin(at)/sinh(bt) -> k*pi/(2b)*(tanh(pi(a-w)/(2b))+tanh(pi(a+w)/(2b))), a=",
                             string(_sh_a), ", b=", string(_sh_b))]
        )
    ),

    /* ── k*cos(at)/cosh(bt) -> k*(pi/(2b))*(sech(pi(w-a)/(2b)) + sech(pi(w+a)/(2b)))
       FT[cos(at)/cosh(bt)](w) = (π/(2b)) * (1/cosh(π(w-a)/(2b)) + 1/cosh(π(w+a)/(2b)))
       Derived from K_even(λ) = ∫ e^{iλt}/cosh(t) dt = π/cosh(λπ/2).
       Substituting t → t/b gives the scaled form. Note: sech not a Maxima builtin,
       use 1/cosh() instead.
       Handles op="/" form: k*cos(at)/cosh(bt).
       ── */
    if is(res = false) then block(
        [_ch_cos, _ch_cosh, _ch_coef, _ch_a, _ch_b, _ch_e],
        _ch_cos: false,
        _ch_cosh: false,
        _ch_coef: 1,
        if not atom(e) and is(op(e) = "/") then (
            _ch_e: part(e, 1),
            if not atom(_ch_e) and is(op(_ch_e) = 'cos) then (
                _ch_cos: _ch_e,
                _ch_cosh: errcatch(part(e, 2)),
                if _ch_cosh # [] then _ch_cosh: first(_ch_cosh) else _ch_cosh: false,
                if not (not atom(_ch_cosh) and is(op(_ch_cosh) = 'cosh))
                then _ch_cosh: false
            ) else if not atom(_ch_e) and is(op(_ch_e) = "*") then (
                for _s in args(_ch_e) do (
                    if not atom(_s) and is(op(_s) = 'cos) then _ch_cos: _s
                    else _ch_coef: _ch_coef * _s
                ),
                _ch_cosh: errcatch(part(e, 2)),
                if _ch_cosh # [] then _ch_cosh: first(_ch_cosh) else _ch_cosh: false,
                if not (not atom(_ch_cosh) and is(op(_ch_cosh) = 'cosh))
                then _ch_cosh: false
            )
        ),
        if is(_ch_cos # false) and is(_ch_cosh # false) then (
            _ch_a: ratsimp(part(_ch_cos, 1) / t_var),
            _ch_b: ratsimp(part(_ch_cosh, 1) / t_var),
            if freeof(t_var, _ch_a) and freeof(t_var, _ch_b)
               and freeof(t_var, _ch_coef)
               and is(_ch_a >= 0) and is(_ch_b > 0) then
                /* Return 1/cosh form (numerically evaluable by the plotter).
                   FT_pick_display_expr will rewrite it to sech for TeX display. */
                res: [_ch_coef * (%piexact / (2*_ch_b))
                        * (1/cosh(%piexact*(w_var - _ch_a) / (2*_ch_b))
                           + 1/cosh(%piexact*(w_var + _ch_a) / (2*_ch_b))),
                      concat("k*cos(at)/cosh(bt) -> k*pi/(2b)*(sech(pi(w-a)/(2b))+sech(pi(w+a)/(2b))), a=",
                             string(_ch_a), ", b=", string(_ch_b))]
        )
    ),

    /* ── f(t)/c -> FT(f(t))/c  (c constante en t, op="/") ──
       Handles Maxima's representation of k/c * f(t) as (k*f(t))/c.
       Delegates to FT_pattern_lookup on the numerator. */
    if is(res = false) and not atom(e) and is(op(e) = "/") then block(
        [_num_e, _den_e, _ft_num],
        _num_e: part(e, 1),
        _den_e: part(e, 2),
        if freeof(t_var, _den_e) then (
            _ft_num: FT_pattern_lookup(_num_e, t_var, w_var),
            if is(_ft_num # false) then
                res: [_ft_num[1] / _den_e,
                      concat("f(t)/c: c=", string(_den_e), ", ", _ft_num[2])]
        )
    ),

    /* ── scalar: k*f(t) -> k*FT(f(t))  (k constante en t) ──
       Separa el coeficiente constante de la parte t-dependiente.
       Solo activa cuando hay exactamente UN factor que depende de t
       (los productos multi-funcion los manejan los patrones anteriores). */
    if is(res = false) and not atom(e) and is(op(e) = "*") then block(
        [_factors, _const_k, _t_parts, _ft_core],
        _factors: args(e),
        _const_k: 1,
        _t_parts: [],
        for _fac in _factors do (
            if freeof(t_var, _fac)
            then _const_k: _const_k * _fac
            else _t_parts: cons(_fac, _t_parts)
        ),
        if length(_t_parts) = 1 then (
            _ft_core: FT_pattern_lookup(first(_t_parts), t_var, w_var),
            if is(_ft_core # false) then
                res: [_const_k * _ft_core[1],
                      concat("k*f(t): k=", string(_const_k), ", ", _ft_core[2])]
        )
    ),

    /* ── frequency-shift: e^{i*w0*t} * g(t) -> G(w - w0) ──
       Frequency-shift theorem: FT[e^{iw0t} f(t)](w) = F(w-w0).
       Uses f_expr (NOT the expanded e) because expand() may absorb negative
       exponentials into the denominator: expand(e^{-2it}/(4+t^2)) gives
       1/(e^{2it}*(t^2+4)), hiding the exponential factor in the numerator.
       ratsimp(f_expr) normalizes without that problem.
       Handles: op="*" (e^{iw0t}*g) and op="/" (e^{iw0t}/h or k/(e^{iw0t}*h)).
       In Maxima exp(x) = %e^x, so the base must be %e (op="^", part 1 = %e). */
    if is(res = false) then block(
        [_fs_e, _fs_factors, _fs_denom, _exp_fac, _w0, _g_rest, _g_ft, _earg, _w0c],
        _fs_e: ratsimp(f_expr),
        _exp_fac: false, _w0: false, _g_rest: 1,
        if not atom(_fs_e) and (is(op(_fs_e) = "*") or is(op(_fs_e) = "/")) then (
            /* Collect numerator factors; keep denominator separate */
            _fs_denom: if is(op(_fs_e) = "/") then part(_fs_e, 2) else 1,
            _fs_factors: block([_n: if is(op(_fs_e) = "/") then part(_fs_e, 1)
                                    else _fs_e],
                if not atom(_n) and is(op(_n) = "*") then args(_n) else [_n]),
            for _fac in _fs_factors do (
                if is(_exp_fac = false) and not atom(_fac)
                   and is(op(_fac) = "^") and is(part(_fac, 1) = %e) then (
                    _earg: part(_fac, 2),
                    _w0c: errcatch(ratsimp(_earg / (%i * t_var))),
                    if _w0c # [] and freeof(t_var, first(_w0c))
                       and not equal(first(_w0c), 0)
                       and ratsimp(_earg - %i * first(_w0c) * t_var) = 0 then (
                        _exp_fac: _fac,
                        _w0: first(_w0c)
                    ) else _g_rest: _g_rest * _fac
                ) else _g_rest: _g_rest * _fac
            ),
            if is(_exp_fac # false) then (
                _g_rest: _g_rest / _fs_denom,
                _g_ft: FT_pattern_lookup(_g_rest, t_var, w_var),
                if is(_g_ft # false) then
                    res: [subst(w_var = w_var - _w0, _g_ft[1]),
                          concat("freq-shift: e^{iw0t}*g(t)->G(w-w0), w0=", string(_w0),
                                 ", G=", _g_ft[2])]
            )
        )
    ),

    /* ── sin(bt)*f(t) -> (G(w-b) - G(w+b))/(2i)  (FT modulación por seno) ──
       Vía fórmula de Euler: sin(bt) = (e^{ibt} - e^{-ibt})/(2i)
       Combinado con freq-shift: FT[e^{±ibt}f(t)] = G(w∓b). */
    if is(res = false) then block(
        [_sm_numer_ft, _sm_denom_ft, _sin_fac_ft, _b_ft_s, _rest_ft_s,
         _nfacs_ft_s, _fac_ft_s, _sin_arg_ft_s, _b_ft_sc,
         _F_ft_s, _g_ft_s],
        _sin_fac_ft: false, _b_ft_s: false, _rest_ft_s: 1,
        if not atom(e) and (is(op(e) = "*") or is(op(e) = "/")) then (
            _sm_numer_ft: if is(op(e) = "/") then part(e, 1) else e,
            _sm_denom_ft: if is(op(e) = "/") then part(e, 2) else 1,
            _nfacs_ft_s: if not atom(_sm_numer_ft) and is(op(_sm_numer_ft) = "*")
                         then args(_sm_numer_ft) else [_sm_numer_ft],
            for _fac_ft_s in _nfacs_ft_s do (
                if is(_sin_fac_ft = false) and not atom(_fac_ft_s)
                   and is(op(_fac_ft_s) = 'sin) then (
                    _sin_arg_ft_s: part(_fac_ft_s, 1),
                    _b_ft_sc: errcatch(ratsimp(_sin_arg_ft_s / t_var)),
                    if _b_ft_sc # [] and freeof(t_var, first(_b_ft_sc))
                       and not equal(first(_b_ft_sc), 0)
                       and ratsimp(_sin_arg_ft_s - first(_b_ft_sc)*t_var) = 0 then (
                        _sin_fac_ft: _fac_ft_s,
                        _b_ft_s: first(_b_ft_sc)
                    ) else _rest_ft_s: _rest_ft_s * _fac_ft_s
                ) else _rest_ft_s: _rest_ft_s * _fac_ft_s
            ),
            if is(_sin_fac_ft # false) then (
                _F_ft_s: _rest_ft_s / _sm_denom_ft,
                _g_ft_s: FT_pattern_lookup(_F_ft_s, t_var, w_var),
                if is(_g_ft_s # false) then
                    res: [(subst(w_var = w_var - _b_ft_s, _g_ft_s[1])
                           - subst(w_var = w_var + _b_ft_s, _g_ft_s[1])) / (2*%i),
                          concat("sin(bt)*f(t)->(G(w-b)-G(w+b))/(2i), b=",
                                 string(_b_ft_s), ", FT[f]=", _g_ft_s[2])]
            )
        )
    ),

    /* ── cos(bt)*f(t) -> (G(w-b) + G(w+b))/2  (FT modulación por coseno) ──
       Vía fórmula de Euler: cos(bt) = (e^{ibt} + e^{-ibt})/2. */
    if is(res = false) then block(
        [_cm_numer_ft, _cm_denom_ft, _cos_fac_ft, _b_ft_c, _rest_ft_c,
         _nfacs_ft_c, _fac_ft_c, _cos_arg_ft_c, _b_ft_cc,
         _F_ft_c, _g_ft_c],
        _cos_fac_ft: false, _b_ft_c: false, _rest_ft_c: 1,
        if not atom(e) and (is(op(e) = "*") or is(op(e) = "/")) then (
            _cm_numer_ft: if is(op(e) = "/") then part(e, 1) else e,
            _cm_denom_ft: if is(op(e) = "/") then part(e, 2) else 1,
            _nfacs_ft_c: if not atom(_cm_numer_ft) and is(op(_cm_numer_ft) = "*")
                         then args(_cm_numer_ft) else [_cm_numer_ft],
            for _fac_ft_c in _nfacs_ft_c do (
                if is(_cos_fac_ft = false) and not atom(_fac_ft_c)
                   and is(op(_fac_ft_c) = 'cos) then (
                    _cos_arg_ft_c: part(_fac_ft_c, 1),
                    _b_ft_cc: errcatch(ratsimp(_cos_arg_ft_c / t_var)),
                    if _b_ft_cc # [] and freeof(t_var, first(_b_ft_cc))
                       and not equal(first(_b_ft_cc), 0)
                       and ratsimp(_cos_arg_ft_c - first(_b_ft_cc)*t_var) = 0 then (
                        _cos_fac_ft: _fac_ft_c,
                        _b_ft_c: first(_b_ft_cc)
                    ) else _rest_ft_c: _rest_ft_c * _fac_ft_c
                ) else _rest_ft_c: _rest_ft_c * _fac_ft_c
            ),
            if is(_cos_fac_ft # false) then (
                _F_ft_c: _rest_ft_c / _cm_denom_ft,
                _g_ft_c: FT_pattern_lookup(_F_ft_c, t_var, w_var),
                if is(_g_ft_c # false) then
                    res: [(subst(w_var = w_var - _b_ft_c, _g_ft_c[1])
                           + subst(w_var = w_var + _b_ft_c, _g_ft_c[1])) / 2,
                          concat("cos(bt)*f(t)->(G(w-b)+G(w+b))/2, b=",
                                 string(_b_ft_c), ", FT[f]=", _g_ft_c[2])]
            )
        )
    ),

    /* ── trig power reduction: sin^n(f(t)) / cos^n(f(t))  (n >= 2) ──
       trigreduce reduces sin(x)^n and cos(x)^n to sums of sin/cos of
       multiples of x for any integer n, e.g. sin(t)^2 -> (1-cos(2t))/2.
       Works for any argument f(t), including shifts like sin(t-a)^n.
       Only activates when op="^", base is sin or cos, exponent is integer >= 2
       and the result differs from the input (trigreduce did something). */
    if is(res = false) and not atom(e) and is(op(e) = "^") then block(
        [_tp_base, _tp_exp, _tp_reduced, _tp_ft],
        _tp_base: part(e, 1),
        _tp_exp:  part(e, 2),
        if not atom(_tp_base)
           and (is(op(_tp_base) = 'sin) or is(op(_tp_base) = 'cos))
           and integerp(_tp_exp) and _tp_exp >= 2 then (
            _tp_reduced: errcatch(trigreduce(e)),
            if _tp_reduced # [] then (
                _tp_reduced: first(_tp_reduced),
                /* Guard: trigreduce must have changed op away from "^" —
                   if it still returns a power we'd recurse infinitely. */
                if atom(_tp_reduced) or not is(op(_tp_reduced) = "^") then (
                    _tp_ft: FT_pattern_lookup(_tp_reduced, t_var, w_var),
                    if is(_tp_ft # false) then
                        res: [_tp_ft[1],
                              concat("sin/cos^n -> trigreduce -> ", _tp_ft[2])]
                )
            )
        )
    ),

    /* ── Generic time-shift: FT[k·h(α·t − t₀)](ω) = (k/|α|)·e^{−iω·t₀}·FT[h(α·t)](ω) ──
       Applies the time-shift (and optional scaling) theorem to expressions whose
       t_var-dependence is entirely contained within a single affine argument.
       Covers: k*f(α·t+β),  k/f(α·t+β),  k*f(α·t+β)/g(β)  etc.

       Strategy:
         1. Extract from expression e a "core" sub-expression h(arg) where h is a
            1-argument function and arg is linear in t_var with a nonzero constant.
            Also extract the constant multiplier k  (everything else in e is free of t).
            Cases handled:
              • e = f(arg)               → k=1,   h=f
              • e = k*f(arg)             → k=k,   h=f   (product, one t-dependent factor)
              • e = k_num/f(arg)         → k=k_num, h=f, sign flips (numerator)
              • e = k_num/(c*f(arg))     → as above with c absorbed into k
         2. Linearity check: arg must be α·t_var + β with α≠0, β≠0.
         3. t₀ = −β/α.  Centered form: h_c(t_var) = h(α·t_var).
         4. Delegate to FT_pattern_lookup for the centered form h_c.
         5. Apply shift + scaling: FT[h_c(t_var)](ω/α)/|α| * e^{−iω·t₀} * k.

       Guard: centered arg has no constant offset, so this handler won't re-fire.
    */
    if is(res = false) then block(
        [_sh_k, _sh_func, _sh_arg, _sh_alpha, _sh_beta,
         _sh_t0, _sh_centered, _sh_ft_g, _sh_ft_val, _sh_w_scaled],
        _sh_k: 1,
        _sh_func: false,

        /* Case A: e itself is a 1-arg function  f(arg) */
        if not atom(e) and length(args(e)) = 1 then _sh_func: e

        /* Case B: product  k * f(arg)  — one t-dependent 1-arg factor, rest constant */
        else if not atom(e) and is(op(e) = "*") then block(
            [_sh_facs, _sh_residual, _sh_nfuncs],
            _sh_facs: args(e),
            _sh_residual: false,
            _sh_nfuncs: 0,
            for _sh_f in _sh_facs do (
                if freeof(t_var, _sh_f) then _sh_k: _sh_k * _sh_f
                else if not atom(_sh_f) and length(args(_sh_f)) = 1 and _sh_nfuncs = 0
                then (_sh_residual: _sh_f, _sh_nfuncs: _sh_nfuncs + 1)
                else _sh_nfuncs: _sh_nfuncs + 10   /* >1 t-dependent factor → bail */
            ),
            if _sh_nfuncs = 1 then _sh_func: _sh_residual
        )

        /* Case C: ratio  k_num / f(arg)  or  k_num / (c * f(arg))
           After normalization, sech(t-t0) = 1/cosh(t-t0) lands here. */
        else if not atom(e) and is(op(e) = "/") then block(
            [_sh_num, _sh_den, _sh_den_func, _sh_den_c],
            _sh_num: part(e, 1),
            _sh_den: part(e, 2),
            if freeof(t_var, _sh_num) then (
                /* denominator is either f(arg) or c*f(arg) */
                if not atom(_sh_den) and length(args(_sh_den)) = 1 then (
                    /* k_num / f(arg) */
                    _sh_k: _sh_num,
                    _sh_func: _sh_den
                ) else if not atom(_sh_den) and is(op(_sh_den) = "*") then (
                    /* k_num / (c * f(arg))  — split constant and function factors */
                    _sh_den_func: false,
                    _sh_den_c: 1,
                    for _sh_df in args(_sh_den) do (
                        if freeof(t_var, _sh_df) then _sh_den_c: _sh_den_c * _sh_df
                        else if not atom(_sh_df) and length(args(_sh_df)) = 1
                                and is(_sh_den_func = false)
                        then _sh_den_func: _sh_df
                        else _sh_den_func: false   /* >1 t-dep → bail */
                    ),
                    if is(_sh_den_func # false) then (
                        _sh_k: _sh_num / _sh_den_c,
                        _sh_func: _sh_den_func
                    )
                )
            )
        ),

        /* Step 2: verify argument is linear in t_var with nonzero constant offset */
        if is(_sh_func # false) then (
            _sh_arg: part(_sh_func, 1),
            _sh_alpha: errcatch(ratsimp(diff(_sh_arg, t_var))),
            _sh_beta:  errcatch(ratsimp(subst(t_var = 0, _sh_arg))),
            if _sh_alpha # [] and _sh_beta # []
               and freeof(t_var, first(_sh_alpha)) and not equal(first(_sh_alpha), 0)
               and freeof(t_var, first(_sh_beta))  and not equal(first(_sh_beta), 0)
               /* Verify arg is truly linear: no higher-order terms */
               and ratsimp(_sh_arg - first(_sh_alpha)*t_var - first(_sh_beta)) = 0
            then (
                _sh_alpha: first(_sh_alpha),
                _sh_beta:  first(_sh_beta),
                /* Step 3: t₀ = −β/α */
                _sh_t0: ratsimp(-_sh_beta / _sh_alpha),

                /* Step 4: build centered form by substituting the argument.
                   h_c(t_var) = h(α·t_var): same function, centered argument. */
                _sh_centered: subst(_sh_arg = _sh_alpha * t_var, _sh_func),

                /* Step 5: delegate to FT_pattern_lookup for centered form.
                   For ratio case (Case C), wrap back as k_orig / _sh_centered. */
                if not is(op(e) = "/") or not freeof(t_var, part(e, 1)) then
                    _sh_ft_g: errcatch(FT_pattern_lookup(_sh_k * _sh_centered, t_var, w_var))
                else
                    _sh_ft_g: errcatch(FT_pattern_lookup(_sh_k / _sh_centered, t_var, w_var)),
                if _sh_ft_g # [] then _sh_ft_g: first(_sh_ft_g),

                /* Step 6: apply shift: multiply by e^{-iω·t₀} */
                if not is(_sh_ft_g = false) and not is(_sh_ft_g = []) then (
                    _sh_ft_val: ratsimp(
                        _sh_ft_g[1] * exp(-%i * w_var * _sh_t0)
                    ),
                    res: [_sh_ft_val,
                          concat("time-shift: t₀=", string(_sh_t0),
                                 ", α=", string(_sh_alpha), " → ", _sh_ft_g[2])]
                )
            )
        )
    ),

    /* ── linearity: FT(f+g+...) = FT(f)+FT(g)+... ──
       Handles unary minus terms: Maxima represents -(k*f) with op="-",
       not as (-k)*f. We negate the FT of the inner expression. */
    if is(res = false) and not atom(e) and is(op(e) = "+") then block(
        [_terms, _all_ok, _F_sum, _ft_i, _inner],
        _terms: args(e),
        _all_ok: true,
        _F_sum: 0,
        for _term in _terms while _all_ok do (
            if not atom(_term) and is(op(_term) = "-") then (
                _inner: first(args(_term)),
                _ft_i: FT_pattern_lookup(_inner, t_var, w_var),
                if is(_ft_i = false) then _all_ok: false
                else _F_sum: _F_sum - _ft_i[1]
            ) else (
                _ft_i: FT_pattern_lookup(_term, t_var, w_var),
                if is(_ft_i = false) then _all_ok: false
                else _F_sum: _F_sum + _ft_i[1]
            )
        ),
        if _all_ok then block(
            [_simplified, _dm],
            /* Simplify the accumulated sum.
               Try demoivre to collapse imaginary exponentials to trig form:
               e.g. (exp(iw)-exp(-iw))/(iw) -> 2*sin(w)/w.
               demoivre must come BEFORE ratsimp — ratsimp first changes the
               exp form in a way that blocks later trig simplification.
               Only accept the demoivre result if it eliminated all %e terms
               (freeof(%e, result)). This guards against accidentally expanding
               real-decaying phase factors like exp(-at0)*exp(-iw*t0) into
               trig, which would give a messier (not simpler) form. */
            if not freeof(%e, _F_sum) and not freeof(%i, _F_sum) then (
                _dm: errcatch(ratsimp(demoivre(_F_sum))),
                if _dm # [] and freeof(%e, first(_dm))
                then _simplified: first(_dm)
                else _simplified: ratsimp(_F_sum)
            ) else _simplified: ratsimp(_F_sum),
            res: [_simplified, "linearity: FT(f+g+...) = FT(f)+FT(g)+..."]
        )
    ),

    res
)$

/* ────────────────────────────────────────────────────────────────
   IFT_PATTERN_LOOKUP
   Patrones cubiertos:
     1, delta(w-a), 2pi*delta(w-a)
     1/(iw), pi*delta(w)+1/(iw)
     k/(iw+a)
     k/(iw+a)^2         — detecta forma expandida
     b/((iw+a)^2+b^2)
     (iw+a)/((iw+a)^2+b^2)
     (pi/a)*e^{-a|w|}
   ──────────────────────────────────────────────────────────────── */
IFT_pattern_lookup(F_expr, w_var, t_var) := block(
    [e, er, dm, k, a, b, s, has_delta, has_iw, res],
    res: false,

    /* ── loop defensivo PRIMERO, antes de rat() y expand() ── */
    FT_declare_params(F_expr, [w_var, t_var]),

    /* Normalize sech/csch/coth → 1/cosh, 1/sinh, cosh/sinh so pattern matchers work */
    F_expr: FT_normalize_hyp(F_expr),

    e:  expand(F_expr),
    er: rat(F_expr),

    /* ── (sin(bw+c))^n / (dw+e)^n → sinc(bw+c)^n — normalize before matchers ── */
    block([_sinc_rewrite],
        _sinc_rewrite: FT_sinpow_to_sinc(e, w_var),
        if is(_sinc_rewrite # false) then (
            e: expand(_sinc_rewrite),
            er: rat(_sinc_rewrite)
        )
    ),

    /* ── 1 -> delta(t) ── */
    if is(res = false) then (
        if e = 1 then res: [delta(t_var), "1 -> delta(t)"]
    ),

    /* ── delta(w-a) -> e^{iat}/(2pi) ── */
    if is(res = false) then (
        dm: FT_match_delta(e, w_var),
        if is(dm # false) then (
            k: dm[1],  a: dm[2],
            if a = 0
            then res: [k/(2*%pi), "delta(w) -> 1/(2pi)"]
            else res: [k*exp(%i*a*t_var)/(2*%pi),
                    concat("delta(w-a) -> e^{iat}/(2pi), a=", string(a))]
        )
    ),

    /* ── suma de k*delta(w-a) -> suma de k*e^{iat}/(2pi) ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "+") then block(
            [terms, dm_i, k_i, a_i, result_sum, all_delta, raw, simplified, et],
            terms: args(e),
            all_delta: true,
            result_sum: 0,
            for term in terms do (
                dm_i: FT_match_delta(term, w_var),
                if is(dm_i = false) then all_delta: false
                else (
                    k_i: dm_i[1],
                    a_i: dm_i[2],
                    result_sum: result_sum + k_i * exp(%i * a_i * t_var) / (2*%pi)
                )
            ),
            if all_delta then (
                raw: ratsimp(result_sum),
                et: errcatch(trigreduce(trigsimp(rectform(raw)))),
                simplified: if et # [] then ratsimp(first(et)) else raw,
                et: errcatch(factor(simplified)),
                simplified: if et # [] then first(et) else simplified,
                res: [simplified, "sum of k*delta(w-a) -> sum of k*e^{iat}/(2pi)"]
            )
        )
    ),

    /* ── 2pi*delta(w-a) -> e^{iat} ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then (
            block(
                [has_2pi, rest, dm2],
                has_2pi: false,
                rest: 1,
                for s in args(e) do (
                    if ratsimp(s - 2*%pi) = 0
                    then has_2pi: true
                    else rest: rest * s
                ),
                if has_2pi then (
                    dm2: FT_match_delta(rest, w_var),
                    if is(dm2 # false) then (
                        k: dm2[1],  a: dm2[2],
                        res: [k * exp(%i*a*t_var),
                              concat("2pi*delta(w-a) -> e^{iat}, a=", string(a))]
                    )
                )
            )
        )
    ),

    /* ── k/(iw) -> k*sgn(t)/2
       Also handles k*exp(-iw*t0)/(iw) -> k*sgn(t-t0)/2  (time-shifted sgn).
       Strategy: compute ratsimp(e * i*w).
         Case 1: result free of w → plain k/(iw).
         Case 2: result = k*exp(-iw*t0), k free of w → displaced k*sgn(t-t0)/2.
       The exp factor is found by stripping all w-free factors from the product. ── */
    if is(res = false) then block(
        [_sg_prod, _sg_ef, _sg_er, _sg_t0],
        _sg_prod: errcatch(ratsimp(e * %i * w_var)),
        if _sg_prod # [] then (
            _sg_prod: first(_sg_prod),
            if freeof(w_var, _sg_prod) and _sg_prod # 0 then
                /* Case 1: plain k/(iw) */
                res: [_sg_prod * sgn(t_var) / 2,
                    concat("k/(iw) -> k*sgn(t)/2, k=", string(_sg_prod))]
            else (
                /* Case 2: k*exp(-iw*t0)/(iw) — factor out the exponential */
                _sg_ef: false, _sg_er: 1,
                /* handle division: k_const/something * exp */
                block([_sg_numer, _sg_denom, _sg_nd],
                    _sg_numer: _sg_prod,
                    _sg_denom: 1,
                    if not atom(_sg_prod) and is(op(_sg_prod) = "/") then (
                        _sg_numer: part(_sg_prod, 1),
                        _sg_denom: part(_sg_prod, 2)
                    ),
                    if freeof(w_var, _sg_denom) then (
                        /* strip unary minus from numerator */
                        if not atom(_sg_numer) and is(op(_sg_numer) = "-") then (
                            _sg_er: -1/_sg_denom,
                            _sg_numer: first(args(_sg_numer))
                        ) else _sg_er: 1/_sg_denom,
                        /* numerator is exp(-iw*t0) or k*exp(-iw*t0) */
                        if not atom(_sg_numer) and is(op(_sg_numer) = "*") then (
                            for _sf3 in args(_sg_numer) do (
                                if not atom(_sf3) and is(op(_sf3) = "^")
                                   and not freeof(%i, _sf3) and not freeof(w_var, _sf3)
                                then _sg_ef: _sf3
                                else _sg_er: _sg_er * _sf3
                            )
                        ) else if not atom(_sg_numer) and is(op(_sg_numer) = "^")
                                  and not freeof(%i, _sg_numer) then (
                            _sg_ef: _sg_numer
                        )
                    ) else (
                        /* denom has w: not the pattern we handle */
                        _sg_ef: false
                    )
                ),
                if is(_sg_ef # false) and freeof(w_var, _sg_er) and _sg_er # 0 then (
                    _sg_t0: ratsimp(part(_sg_ef, 2) / (-%i * w_var)),
                    if freeof(w_var, _sg_t0) and not equal(_sg_t0, 0) then
                        res: [_sg_er * sgn(t_var - _sg_t0) / 2,
                            concat("k*exp(-iwt0)/(iw) -> k*sgn(t-t0)/2, k=",
                                   string(_sg_er), ", t0=", string(_sg_t0))]
                )
            )
        )
    ),

    /* ── k/wⁿ  (n ≥ 2 entero)  — forma compacta
       IFT[1/wⁿ] = iⁿ / (2*(n-1)!) * sgn(t) * |t|^{n-1}
       Válida en sentido distribucional (valor principal de Cauchy en w=0).
       Verificado: n=1→i*sgn(t)/2, n=2→-|t|/2, n=3→-i*t*|t|/4, n=4→t²*|t|/12.
       El handler itera n=2..8; si ratsimp(e*wⁿ) es libre de w, activa.
       También cubre k*exp(-iw*t0)/wⁿ por desplazamiento temporal.        ── */
    if is(res = false) then block(
        [_wn_n, _wn_k, _wn_val, _wn_ef, _wn_er, _wn_t0, _wn_prod, _wn_s],
        /* IFT[1/w^n] en tiempo tv.
           Par n=2m:   iⁿ/(2(n-1)!) * |tv|^(n-1)           (resultado par, sin sgn)
           Impar n=2m+1: iⁿ/(2(n-1)!) * |tv|^(n-1) * sgn(tv) (resultado impar, con sgn) */
        _wn_f: lambda([n, tv],
            ratsimp(if evenp(n)
                then  %i^n / (2*(n-1)!) * abs(tv)^(n-1)
                else  %i^n / (2*(n-1)!) * abs(tv)^(n-1) * sgn(tv))),
        /* detectar exponente n: ratsimp(e * w^n) libre de w */
        _wn_n: false,
        for _wn_try: 2 thru 12 while is(_wn_n = false) do (
            _wn_prod: errcatch(ratsimp(e * w_var^_wn_try)),
            if _wn_prod # [] then (
                _wn_prod: first(_wn_prod),
                if freeof(w_var, _wn_prod) and _wn_prod # 0
                then (_wn_n: _wn_try, _wn_k: _wn_prod)
            )
        ),
        if is(_wn_n # false) then
            res: [ratsimp(_wn_k * _wn_f(_wn_n, t_var)),
                  concat("k/w^n, n=", string(_wn_n), ", k=", string(_wn_k))]
        else (
            /* k*exp(-iw*t0)/w^n — extraer factor exponencial */
            _wn_ef: false, _wn_er: 1, _wn_n: false,
            for _wn_try: 2 thru 12 while is(_wn_n = false) do (
                _wn_prod: errcatch(ratsimp(e * w_var^_wn_try)),
                if _wn_prod # [] then (
                    _wn_prod: first(_wn_prod),
                    if not atom(_wn_prod) and is(op(_wn_prod) = "*") then (
                        _wn_ef: false, _wn_er: 1,
                        for _wn_s in args(_wn_prod) do (
                            if not atom(_wn_s) and is(op(_wn_s) = "^")
                               and not freeof(%i, _wn_s) and not freeof(w_var, _wn_s)
                            then _wn_ef: _wn_s
                            else _wn_er: _wn_er * _wn_s
                        ),
                        if is(_wn_ef # false) and freeof(w_var, _wn_er) and _wn_er # 0
                        then _wn_n: _wn_try
                    ) else if not atom(_wn_prod) and is(op(_wn_prod) = "^")
                               and not freeof(%i, _wn_prod)
                    then (_wn_ef: _wn_prod, _wn_er: 1, _wn_n: _wn_try)
                )
            ),
            if is(_wn_n # false) and is(_wn_ef # false) then (
                _wn_t0: ratsimp(part(_wn_ef, 2) / (-%i * w_var)),
                if freeof(w_var, _wn_t0) and not equal(_wn_t0, 0) then
                    res: [ratsimp(_wn_er * _wn_f(_wn_n, t_var - _wn_t0)),
                          concat("k*exp(-iwt0)/w^n, n=", string(_wn_n),
                                 ", t0=", string(_wn_t0))]
            )
        )
    ),

    /* ── exp(-i*w*t0) -> delta(t-t0)  y  exp(+i*w*t0) -> delta(t+t0) ──
    Cubre: exp(-i*w*t0), k*exp(-i*w*t0), exp(i*w*t0), k*exp(i*w*t0)
    Guard: t0 must be real — a complex t0 (e.g. exp((i+1)*w) gives t0=-1+i)
    would produce delta with a complex argument, which is meaningless. */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "^") then block(
            [exp_arg, t0],
            exp_arg: part(e, 2),
            /* caso exp(-i*w*t0) -> delta(t-t0) */
            t0: ratsimp(exp_arg / (-%i * w_var)),
            if freeof(w_var, t0) and is(ratsimp(imagpart(t0)) = 0) then
                res: [delta(t_var - t0),
                    concat("exp(-i*w*t0) -> delta(t-t0), t0=", string(t0))]
            else (
                /* caso exp(+i*w*t0) -> delta(t+t0) */
                t0: ratsimp(exp_arg / (%i * w_var)),
                if freeof(w_var, t0) and is(ratsimp(imagpart(t0)) = 0) then
                    res: [delta(t_var + t0),
                        concat("exp(i*w*t0) -> delta(t+t0), t0=", string(t0))]
            )
        )
    ),

    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [exp_part, coef_k, exp_arg, t0],
            exp_part: false,
            coef_k: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = "^")
                and not freeof(%i, s)
                and not freeof(w_var, s)
                then exp_part: s
                else coef_k: coef_k * s
            ),
            if is(exp_part # false) then (
                exp_arg: part(exp_part, 2),
                /* caso k*exp(-i*w*t0) -> k*delta(t-t0) */
                t0: ratsimp(exp_arg / (-%i * w_var)),
                if freeof(w_var, t0) and is(ratsimp(imagpart(t0)) = 0) then
                    res: [coef_k * delta(t_var - t0),
                        concat("k*exp(-i*w*t0) -> k*delta(t-t0), t0=", string(t0))]
                else (
                    /* caso k*exp(+i*w*t0) -> k*delta(t+t0) */
                    t0: ratsimp(exp_arg / (%i * w_var)),
                    if freeof(w_var, t0) and is(ratsimp(imagpart(t0)) = 0) then
                        res: [coef_k * delta(t_var + t0),
                            concat("k*exp(i*w*t0) -> k*delta(t+t0), t0=", string(t0))]
                )
            )
        )
    ),

    /* ── cos(b*w + theta) -> (e^{itheta}*delta(t+b) + e^{-itheta}*delta(t-b))/2 ──
       IFT analog of FT(cos(w0*t+theta)) = pi*[e^{itheta}*delta(w-w0)+...].
       b = rate of change of argument w.r.t. w_var; theta = phase at w=0.
       Simple case theta=0: IFT(cos(b*w)) = (delta(t+b) + delta(t-b))/2.         */
    if is(res = false) then (
        if not atom(e) and is(op(e) = 'cos) then block(
            [_ict_arg, _ict_b, _ict_theta],
            _ict_arg: part(e, 1),
            _ict_b: ratsimp(diff(_ict_arg, w_var)),
            _ict_theta: ratsimp(subst(w_var=0, _ict_arg)),
            if freeof(w_var, _ict_b) and freeof(w_var, _ict_theta)
            and not equal(_ict_b, 0) then (
                if _ict_theta = 0
                then res: [(delta(t_var + _ict_b) + delta(t_var - _ict_b))/2,
                           concat("cos(bw)->(delta(t+b)+delta(t-b))/2, b=",
                                  string(_ict_b))]
                else res: [(exp(%i*_ict_theta)*delta(t_var + _ict_b)
                           + exp(-%i*_ict_theta)*delta(t_var - _ict_b))/2,
                           concat("cos(bw+theta)->(e^{itheta}*delta(t+b)+e^{-itheta}*delta(t-b))/2, b=",
                                  string(_ict_b), ", theta=", string(_ict_theta))]
            )
        )
    ),

    /* ── sin(b*w + theta) -> (e^{itheta}*delta(t+b) - e^{-itheta}*delta(t-b))/(2i) ──
       Simple case theta=0: IFT(sin(b*w)) = (i/2)*(delta(t-b) - delta(t+b)).    */
    if is(res = false) then (
        if not atom(e) and is(op(e) = 'sin) then block(
            [_ist_arg, _ist_b, _ist_theta],
            _ist_arg: part(e, 1),
            _ist_b: ratsimp(diff(_ist_arg, w_var)),
            _ist_theta: ratsimp(subst(w_var=0, _ist_arg)),
            if freeof(w_var, _ist_b) and freeof(w_var, _ist_theta)
            and not equal(_ist_b, 0) then (
                if _ist_theta = 0
                then res: [(%i/2)*(delta(t_var - _ist_b) - delta(t_var + _ist_b)),
                           concat("sin(bw)->(i/2)*(delta(t-b)-delta(t+b)), b=",
                                  string(_ist_b))]
                else res: [(exp(%i*_ist_theta)*delta(t_var + _ist_b)
                           - exp(-%i*_ist_theta)*delta(t_var - _ist_b))/(2*%i),
                           concat("sin(bw+theta)->(e^{itheta}*delta(t+b)-e^{-itheta}*delta(t-b))/(2i), b=",
                                  string(_ist_b), ", theta=", string(_ist_theta))]
            )
        )
    ),

    /* ── pi*delta(w) + 1/(iw) -> u(t) ── */
    if is(res = false) then (
        if not freeof('delta, e) and not freeof(w_var, e) then (
            has_delta: false,
            has_iw: false,
            for s in (if is(op(e) = "+") then args(e) else [e]) do (
                if not freeof('delta, s) then has_delta: true,
                if ratsimp(s - 1/(%i*w_var)) = 0 then has_iw: true
            ),
            if has_delta and has_iw then
                res: [u(t_var), "pi*delta(w)+1/(iw) -> u(t)"]
        )
    ),

   /* ── IFT de sin(w0t)*u(t) y cos(w0t)*u(t) ──
   sin: k/(w0^2-w^2) + c*(delta(w-w0)-delta(w+w0)) con k=w0, c=-i*pi/2
   cos: i*w/(w0^2-w^2) + c*(delta(w-w0)+delta(w+w0)) con c=pi/2       */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "+") then block(
            [terms, delta_terms, rat_terms,
            rat, denom_r, c2r, c0r, w0_r,
            dm1, dm2, k1, a1, k2, a2, w0_d,
            num_r, c1n, c0n, k_rat],
            terms: args(e),
            delta_terms: [],
            rat_terms: [],
            for term in terms do (
                if not freeof('delta, term)
                then delta_terms: append(delta_terms, [term])
                else rat_terms: append(rat_terms, [term])
            ),
            if length(delta_terms) = 2 and length(rat_terms) = 1 then (
                rat: rat_terms[1],
                if not atom(rat) and is(op(rat) = "/") then (
                    denom_r: rat(expand(part(rat, 2))),
                    c2r: ratsimp(coeff(denom_r, w_var, 2)),
                    c0r: ratsimp(subst(w_var=0, denom_r)),
                    if is(c2r < 0) and is(c0r > 0) then (
                        w0_r: sqrt(ratsimp(c0r / (-c2r))),
                        dm1: FT_match_delta(delta_terms[1], w_var),
                        dm2: FT_match_delta(delta_terms[2], w_var),
                        if is(dm1 # false) and is(dm2 # false) then (
                            k1: dm1[1],  a1: dm1[2],
                            k2: dm2[1],  a2: dm2[2],
                            if ratsimp(a1 + a2) = 0 then (
                                w0_d: abs(a1),
                                if ratsimp(w0_d - w0_r) = 0 then (
                                    num_r: rat(expand(part(rat, 1))),
                                    c1n: ratsimp(diff(num_r, w_var)),
                                    c0n: ratsimp(subst(w_var=0, num_r)),

                                    /* ── patron sin: numerador constante k=w0 ── */
                                    if freeof(w_var, num_r) then (
                                        k_rat: ratsimp(num_r / (-c2r)),
                                        if ratsimp(k_rat - w0_r) = 0
                                        and ratsimp(k1 + k2) = 0 then
                                            res: [sin(w0_r*t_var)*u(t_var),
                                                concat("sin(w0t)*u(t) round-trip, w0=",
                                                        string(w0_r))]
                                    ),

                                    /* ── patron cos: numerador i*w ── */
                                    if is(res = false) then (
                                        if ratsimp(c1n - %i) = 0
                                        and ratsimp(c0n) = 0
                                        and ratsimp(k1 - k2) = 0
                                        and ratsimp(k1 - %pi/2) = 0 then
                                            res: [cos(w0_r*t_var)*u(t_var),
                                                concat("cos(w0t)*u(t) round-trip, w0=",
                                                        string(w0_r))]
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── k/(iw+a)^n -> k*t^(n-1)/(n-1)! * e^{-at}*u(t)  (a>0, n>=1 entero) ──
       Denominador expandido: (iw+a)^n tiene grado n en w.
       Permite un escalar real s en el denominador: denom = s*(iw+a)^n,
       lo que absorbe términos como 1/(2*(iw+3)) de fracciones parciales.
       Algoritmo:
         1. Extraer grado n y coef líder cn = s*(%i)^n  →  s = cn/%i^n
         2. Extraer aa = (c0/s)^(1/n)  (constante real positiva)
         3. Verificar denom = s*expand((iw+aa)^n)
         4. k_eff = num/s;  resultado = k_eff*t^(n-1)/(n-1)!*e^{-aa*t}*u(t)
       Reemplaza los dos handlers separados para n=1 y n=2.               */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [_np_num, _np_den, _np_n, _np_cn, _np_c0, _np_s, _np_aa, _np_kk, _np_ok],
            _np_num: expand(part(er, 1)),
            _np_den: rat(expand(part(er, 2))),
            _np_n: hipow(_np_den, w_var),
            if _np_n >= 1 then (
                _np_cn: ratsimp(coeff(_np_den, w_var, _np_n)),
                _np_c0: ratsimp(coeff(_np_den, w_var, 0)),
                /* escalar real s = cn / %i^n */
                _np_s: errcatch(ratsimp(_np_cn / %i^_np_n)),
                if _np_s # [] then (
                    _np_s: first(_np_s),
                    if freeof(w_var, _np_s) and freeof(%i, _np_s)
                       and is(_np_s # 0) and freeof(w_var, _np_c0)
                       and freeof(%i, _np_c0) then (
                        /* a = (c0/s)^(1/n), debe ser real positivo */
                        _np_aa: errcatch(ratsimp((_np_c0 / _np_s)^(1/_np_n))),
                        if _np_aa # [] then (
                            _np_aa: first(_np_aa),
                            if freeof(w_var, _np_aa) and freeof(%i, _np_aa)
                               and is(_np_aa > 0) then (
                                /* verificar denom = s*(iw+aa)^n exactamente */
                                _np_ok: errcatch(ratsimp(
                                    _np_den - _np_s*expand((%i*w_var+_np_aa)^_np_n))),
                                if _np_ok # [] and first(_np_ok) = 0 then (
                                    /* k efectiva absorbe el escalar s del denom */
                                    _np_kk: errcatch(ratsimp(_np_num / _np_s)),
                                    if _np_kk # [] and freeof(w_var, first(_np_kk)) then (
                                        _np_kk: first(_np_kk),
                                        res: [_np_kk * t_var^(_np_n-1) / (_np_n-1)!
                                                   * exp(-_np_aa*t_var) * u(t_var),
                                              concat("k/(iw+a)^n -> k*t^(n-1)/(n-1)!*e^{-at}*u(t), n=",
                                                     string(_np_n), ", a=", string(_np_aa))]
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── ANTI-CAUSAL: k/(a-iw)^n -> (-1)^(n-1)*k*t^(n-1)/(n-1)!*e^{at}*u(-t)  (a>0, n>=1 entero)
       Mirror of the causal handler: denominator root is at w = -ia (lower half-plane).
       Detection: expand (a-iw)^n, check leading coeff of w^n = (-i)^n.
       Then _ac_s = _ac_cn / (-i)^n, _ac_aa = (c_0/_ac_s)^(1/n) > 0.
       Result: IFT[k/(a-iw)^n](t) = (-1)^(n-1) * k_eff * t^(n-1)/(n-1)! * e^{at} * u(-t).
       NOTE: use `e` (expand form) not `er` (rat form), because rat() canonicalizes
       1/(a-iw) → -(1/(iw-a)) which changes op from "/" to "-".
       ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "/") then block(
            [_ac_num, _ac_den, _ac_n, _ac_cn, _ac_c0, _ac_s, _ac_aa, _ac_kk, _ac_ok],
            _ac_num: part(e, 1),
            _ac_den: rat(expand(part(e, 2))),
            if freeof(w_var, _ac_num) and not freeof(w_var, _ac_den) then (
                /* degree of denominator in w */
                _ac_n: hipow(_ac_den, w_var),
                if _ac_n >= 1 then (
                    /* leading coeff of w^n: should be (-i)^n */
                    _ac_cn: ratsimp(coeff(_ac_den, w_var, _ac_n)),
                    /* constant term: c0 = a^n * (-i)^n * (-1)^n ... simpler: s*a^n */
                    _ac_c0: ratsimp(subst(w_var=0, _ac_den)),
                    /* s = leading / (-i)^n  →  (a-iw)^n = s * (a-iw)^n  */
                    _ac_s: errcatch(ratsimp(_ac_cn / (-%i)^_ac_n)),
                    if _ac_s # [] then (
                        _ac_s: first(_ac_s),
                        /* a = (c0/s)^(1/n), must be real positive */
                        _ac_aa: errcatch(ratsimp((_ac_c0 / _ac_s)^(1/_ac_n))),
                        if _ac_aa # [] then (
                            _ac_aa: first(_ac_aa),
                            if freeof(w_var, _ac_aa) and freeof(%i, _ac_aa)
                               and is(_ac_aa > 0) then (
                                /* verify denom = s*(a-iw)^n exactly */
                                _ac_ok: errcatch(ratsimp(
                                    _ac_den - _ac_s*expand((_ac_aa - %i*w_var)^_ac_n))),
                                if _ac_ok # [] and first(_ac_ok) = 0 then (
                                    _ac_kk: errcatch(ratsimp(_ac_num / _ac_s)),
                                    if _ac_kk # [] and freeof(w_var, first(_ac_kk)) then (
                                        _ac_kk: first(_ac_kk),
                                        /* IFT[k/(a-iw)^n](t) = (-1)^(n-1)*k*t^(n-1)/(n-1)!*e^{at}*u(-t)
                                           The sign (-1)^(n-1) arises because the pole at w=-ia
                                           is in the lower half-plane; contour closes downward for t<0. */
                                        res: [(-1)^(_ac_n-1) * _ac_kk * t_var^(_ac_n-1) / (_ac_n-1)!
                                                   * exp(_ac_aa*t_var) * u(-t_var),
                                              concat("k/(a-iw)^n -> (-1)^(n-1)*k*t^(n-1)/(n-1)!*e^{at}*u(-t), n=",
                                                     string(_ac_n), ", a=", string(_ac_aa))]
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── b/((iw+a)^2+b^2) -> e^{-at}*sin(bt)*u(t)  (a,b > 0) ── */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [numer4, denom4, c2, c1, c0, aa, bb],
            numer4: part(er, 1),
            denom4: rat(expand(part(er, 2))),
            if freeof(w_var, numer4) and not freeof(w_var, denom4) then (
                c2: ratsimp(diff(denom4, w_var, 2) / 2),
                if ratsimp(c2 - 1) = 0 then (
                    c1: ratsimp(diff(denom4, w_var) - 2*w_var),
                    c0: ratsimp(subst(w_var=0, denom4)),
                    aa: ratsimp(c1 / (2*%i)),
                    if freeof(w_var, aa) and is(aa > 0) then (
                        bb: sqrt(ratsimp(c0 + aa^2)),
                        if freeof(w_var, bb) and is(bb > 0)
                           and ratsimp(numer4 - bb) = 0 then
                            res: [exp(-aa*t_var) * sin(bb*t_var) * u(t_var),
                                  concat("b/((iw+a)^2+b^2) -> e^{-at}sin(bt)u(t), a=",
                                         string(aa), ", b=", string(bb))]
                    )
                )
            )
        )
    ),

    /* ── (iw+a)/((iw+a)^2+b^2) -> e^{-at}*cos(bt)*u(t)  (a,b > 0) ── */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [numer5, denom5, nc1, nc0, c2, c1, c0, aa, bb],
            numer5: rat(expand(part(er, 1))),
            denom5: rat(expand(part(er, 2))),
            if not freeof(w_var, numer5) and not freeof(w_var, denom5) then (
                nc1: ratsimp(diff(numer5, w_var)),
                nc0: ratsimp(subst(w_var=0, numer5)),
                if ratsimp(nc1 - %i) = 0 and freeof(w_var, nc0) then (
                    aa: nc0,
                    if is(aa > 0) then (
                        c2: ratsimp(diff(denom5, w_var, 2) / 2),
                        if ratsimp(c2 - 1) = 0 then (
                            c1: ratsimp(diff(denom5, w_var) - 2*w_var),
                            c0: ratsimp(subst(w_var=0, denom5)),
                            if ratsimp(c1 / (2*%i) - aa) = 0 then (
                                bb: sqrt(ratsimp(c0 + aa^2)),
                                if freeof(w_var, bb) and is(bb > 0) then
                                    res: [exp(-aa*t_var) * cos(bb*t_var) * u(t_var),
                                          concat("(iw+a)/((iw+a)^2+b^2) -> e^{-at}cos(bt)u(t), a=",
                                                 string(aa), ", b=", string(bb))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── k/((iw+a)^2+b^2) -> k*e^{-at}*sin(bt)*u(t)/b  (a,b > 0) ──
       La expansión real de (iw+a)^2+b^2 = -w^2 + 2iaw + a^2+b^2
       tiene coeficiente -1 para w^2, no +1 como asumen los patrones
       anteriores. Estos patrones correctos cubren el caso simbólico. */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [num6, den6, d2_6, d1_6, d0_6, aa6, bb6sq, bb6, kk6],
            num6: part(er, 1),
            den6: rat(expand(part(er, 2))),
            if freeof(w_var, num6) and not freeof(w_var, den6) then (
                d2_6: ratsimp(diff(den6, w_var, 2) / 2),
                /* coef de w^2 debe ser -1 */
                if ratsimp(d2_6 + 1) = 0 then (
                    d1_6: ratsimp(diff(den6, w_var) + 2*w_var),
                    d0_6: ratsimp(subst(w_var=0, den6)),
                    aa6: ratsimp(d1_6 / (2*%i)),
                    if freeof(w_var, aa6) and is(aa6 > 0) then (
                        bb6sq: ratsimp(d0_6 - aa6^2),
                        if is(bb6sq > 0) then (
                            bb6: sqrt(bb6sq),
                            if freeof(w_var, bb6) and is(bb6 > 0) then (
                                kk6: ratsimp(num6 / bb6),
                                res: [kk6 * exp(-aa6*t_var) * sin(bb6*t_var) * u(t_var),
                                      concat("k/((iw+a)^2+b^2) -> k*e^{-at}sin(bt)u(t)/b, a=",
                                             string(aa6), ", b=", string(bb6))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── (iw+a)/((iw+a)^2+b^2) -> e^{-at}*cos(bt)*u(t)  (a,b > 0) ──
       Misma corrección: coef -1 para w^2 en el denominador.          */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [num7, den7, nc1_7, nc0_7, d2_7, d1_7, d0_7, aa7, bb7sq, bb7, kk7],
            num7: rat(expand(part(er, 1))),
            den7: rat(expand(part(er, 2))),
            if not freeof(w_var, num7) and not freeof(w_var, den7) then (
                nc1_7: ratsimp(diff(num7, w_var)),
                nc0_7: ratsimp(subst(w_var=0, num7)),
                if ratsimp(nc1_7 - %i) = 0 and freeof(w_var, nc0_7) then (
                    aa7: nc0_7,
                    if is(aa7 > 0) then (
                        d2_7: ratsimp(diff(den7, w_var, 2) / 2),
                        if ratsimp(d2_7 + 1) = 0 then (
                            d1_7: ratsimp(diff(den7, w_var) + 2*w_var),
                            d0_7: ratsimp(subst(w_var=0, den7)),
                            if ratsimp(d1_7 / (2*%i) - aa7) = 0 then (
                                bb7sq: ratsimp(d0_7 - aa7^2),
                                if is(bb7sq > 0) then (
                                    bb7: sqrt(bb7sq),
                                    if freeof(w_var, bb7) and is(bb7 > 0) then
                                        res: [exp(-aa7*t_var) * cos(bb7*t_var) * u(t_var),
                                              concat("(iw+a)/((iw+a)^2+b^2) -> e^{-at}cos(bt)u(t), a=",
                                                     string(aa7), ", b=", string(bb7))]
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── ANTI-CAUSAL: -b/((a-iw)^2+b^2) -> e^{at}*sin(bt)*u(-t)  (a,b > 0) ──
       Mirror of the causal sin handler: denominator = (a-iw)^2+b^2, numerator = -b (constant).
       IFT[−b/((a−iw)²+b²)](t) = e^{at}·sin(bt)·u(−t).
       Detection via coeff of w^2 = -1 and c1 from -2*i*a term.
       In Maxima, -b/denom is represented as -(b/denom) with op="-".
       We detect this by: if op="-", extract the inner b/denom expression,
       check denominator structure, numerator = b (positive), then result has u(-t).
       ── */
    if is(res = false) then block(
        [_as_inner, _as_num, _as_den, _as_d2, _as_d1, _as_d0, _as_aa, _as_bbsq, _as_bb],
        _as_inner: false,
        if not atom(F_expr) and is(op(F_expr) = "-") then (
            _as_inner: errcatch(part(F_expr, 1)),
            if _as_inner # [] then _as_inner: first(_as_inner) else _as_inner: false
        ),
        if is(_as_inner # false) and not atom(_as_inner) and is(op(_as_inner) = "/") then (
            _as_num: part(_as_inner, 1),
            _as_den: rat(expand(part(_as_inner, 2))),
            if freeof(w_var, _as_num) and not freeof(w_var, _as_den) then (
                _as_d2: ratsimp(diff(_as_den, w_var, 2) / 2),
                /* coeff of w^2 must be -1 */
                if ratsimp(_as_d2 + 1) = 0 then (
                    _as_d1: ratsimp(diff(_as_den, w_var) + 2*w_var),
                    _as_d0: ratsimp(subst(w_var=0, _as_den)),
                    /* For (a-iw)^2+b^2: diff/dw + 2w = -2ia → aa = _as_d1 / (-2*i) */
                    _as_aa: ratsimp(_as_d1 / (-2*%i)),
                    if freeof(w_var, _as_aa) and is(_as_aa > 0) then (
                        _as_bbsq: ratsimp(_as_d0 - _as_aa^2),
                        if is(_as_bbsq > 0) then (
                            _as_bb: sqrt(_as_bbsq),
                            if freeof(w_var, _as_bb) and is(_as_bb > 0)
                               /* inner numerator must be +bb (the minus is in the outer "-") */
                               and ratsimp(_as_num - _as_bb) = 0 then
                                res: [exp(_as_aa*t_var) * sin(_as_bb*t_var) * u(-t_var),
                                      concat("-b/((a-iw)^2+b^2) -> e^{at}sin(bt)u(-t), a=",
                                             string(_as_aa), ", b=", string(_as_bb))]
                        )
                    )
                )
            )
        )
    ),

    /* ── ANTI-CAUSAL: (a-iw)/((a-iw)^2+b^2) -> e^{at}*cos(bt)*u(-t)  (a,b > 0) ──
       Numerator = (a-iw): d/dw = -i, constant term = a.
       Denominator same as above with coeff(w^2)=-1, coeff(w)=-2ia.
       Uses F_expr (pre-expand) to handle the numerator correctly.
       ── */
    if is(res = false) then (
        if not atom(F_expr) and is(op(F_expr) = "/") then block(
            [_ac2_num, _ac2_den, _ac2_nc1, _ac2_nc0, _ac2_d2, _ac2_d1, _ac2_d0, _ac2_aa, _ac2_bbsq, _ac2_bb],
            _ac2_num: rat(expand(part(F_expr, 1))),
            _ac2_den: rat(expand(part(F_expr, 2))),
            if not freeof(w_var, _ac2_num) and not freeof(w_var, _ac2_den) then (
                _ac2_nc1: ratsimp(diff(_ac2_num, w_var)),
                _ac2_nc0: ratsimp(subst(w_var=0, _ac2_num)),
                /* numerator = a-iw: d/dw = -i, constant = a > 0 */
                if ratsimp(_ac2_nc1 + %i) = 0 and freeof(w_var, _ac2_nc0) then (
                    _ac2_aa: _ac2_nc0,
                    if is(_ac2_aa > 0) then (
                        _ac2_d2: ratsimp(diff(_ac2_den, w_var, 2) / 2),
                        if ratsimp(_ac2_d2 + 1) = 0 then (
                            _ac2_d1: ratsimp(diff(_ac2_den, w_var) + 2*w_var),
                            _ac2_d0: ratsimp(subst(w_var=0, _ac2_den)),
                            if ratsimp(_ac2_d1 / (-2*%i) - _ac2_aa) = 0 then (
                                _ac2_bbsq: ratsimp(_ac2_d0 - _ac2_aa^2),
                                if is(_ac2_bbsq > 0) then (
                                    _ac2_bb: sqrt(_ac2_bbsq),
                                    if freeof(w_var, _ac2_bb) and is(_ac2_bb > 0) then
                                        res: [exp(_ac2_aa*t_var) * cos(_ac2_bb*t_var) * u(-t_var),
                                              concat("(a-iw)/((a-iw)^2+b^2) -> e^{at}cos(bt)u(-t), a=",
                                                     string(_ac2_aa), ", b=", string(_ac2_bb))]
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── ANTI-CAUSAL: k/((a-iw)^2+b^2) -> -k*e^{at}*sin(bt)*u(-t)/b  (a,b > 0) ──
       Generalisation with scalar numerator k: result = -k/b * e^{at}*sin(bt)*u(-t).
       Negative sign because residue closes below (t<0) with opposite orientation.
       Uses F_expr (pre-expand) to keep numerator as constant.
       ── */
    if is(res = false) then (
        if not atom(F_expr) and is(op(F_expr) = "/") then block(
            [_ak_num, _ak_den, _ak_d2, _ak_d1, _ak_d0, _ak_aa, _ak_bbsq, _ak_bb, _ak_kk],
            _ak_num: part(F_expr, 1),
            _ak_den: rat(expand(part(F_expr, 2))),
            if freeof(w_var, _ak_num) and not freeof(w_var, _ak_den) then (
                _ak_d2: ratsimp(diff(_ak_den, w_var, 2) / 2),
                if ratsimp(_ak_d2 + 1) = 0 then (
                    _ak_d1: ratsimp(diff(_ak_den, w_var) + 2*w_var),
                    _ak_d0: ratsimp(subst(w_var=0, _ak_den)),
                    _ak_aa: ratsimp(_ak_d1 / (-2*%i)),
                    if freeof(w_var, _ak_aa) and is(_ak_aa > 0) then (
                        _ak_bbsq: ratsimp(_ak_d0 - _ak_aa^2),
                        if is(_ak_bbsq > 0) then (
                            _ak_bb: sqrt(_ak_bbsq),
                            if freeof(w_var, _ak_bb) and is(_ak_bb > 0) then (
                                _ak_kk: ratsimp(_ak_num / _ak_bb),
                                res: [- _ak_kk * exp(_ak_aa*t_var) * sin(_ak_bb*t_var) * u(-t_var),
                                      concat("k/((a-iw)^2+b^2) -> -k*e^{at}sin(bt)u(-t)/b, a=",
                                             string(_ak_aa), ", b=", string(_ak_bb))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── (pi/a)*e^{-a|w|} -> 1/(a^2+t^2)  (a > 0) ── */
    if is(res = false) then (
        if not atom(e) and is(op(e) = "*") then block(
            [exp_part, coef5, exp_arg, aa],
            exp_part: false,
            coef5: 1,
            for s in args(e) do (
                if not atom(s) and is(op(s) = "^")
                   and not freeof('abs, s)
                then exp_part: s
                else coef5: coef5 * s
            ),
            if is(exp_part # false) then (
                exp_arg: part(exp_part, 2),
                aa: ratsimp(exp_arg / (-abs(w_var))),
                if freeof(w_var, aa) and is(aa > 0)
                   and ratsimp(coef5 - %pi/aa) = 0 then
                    res: [1/(aa^2 + t_var^2),
                          concat("(pi/a)*e^{-a|w|} -> 1/(a^2+t^2), a=", string(aa))]
            )
        )
    ),

    /* ── exp(-a*|w+w0|) -> (a/pi)*e^{-iw0*t}/(a^2+t^2)  (a>0, w0 real) ──
       Maxima representa el exponente como negación unaria: -(c*abs(w+w0)).
       Solo activa para op="^" puro; el coeficiente k lo cubre el scalar handler. */
    if is(res = false) and not atom(e) and is(op(e) = "^")
       and not freeof('abs, e) then block(
        [_exp_arg, _inner, _abs_part, _aa_raw, _aa, _w0, _abs_arg],
        _exp_arg: part(e, 2),
        _abs_part: false,
        _aa_raw: false,
        /* El exponente siempre llega como -(c*abs(w+w0)), op="-" */
        if not atom(_exp_arg) and is(op(_exp_arg) = "-") then (
            _inner: first(args(_exp_arg)),
            if not atom(_inner) and is(op(_inner) = 'abs) then (
                /* exp(-abs(w+w0)): coef = 1 */
                _abs_part: _inner,
                _aa_raw: 1
            ) else if not atom(_inner) and is(op(_inner) = "*") then (
                /* exp(-(c*abs(w+w0))): extraer c y abs */
                _aa_raw: 1,
                for _s in args(_inner) do (
                    if not atom(_s) and is(op(_s) = 'abs)
                    then _abs_part: _s
                    else _aa_raw: _aa_raw * _s
                )
            )
        ),
        if is(_abs_part # false) and is(_aa_raw # false) then (
            _abs_arg: part(_abs_part, 1),
            _w0: ratsimp(_abs_arg - w_var),
            _aa: ratsimp(_aa_raw),
            if freeof(w_var, _w0) and freeof(w_var, _aa) and is(_aa > 0) then
                res: [(_aa/%pi) * exp(-%i*_w0*t_var) / (_aa^2 + t_var^2),
                      concat("exp(-a|w+w0|) -> (a/pi)*e^{-iw0t}/(a^2+t^2), a=",
                             string(_aa), ", w0=", string(_w0))]
        )
    ),

    /* ── k/(a²+w²) -> k*e^{-a|t|}/(2a)  (a > 0) ──
       Desde FT[e^{-a|t|}] = 2a/(a²+w²) */
    /* ── k*w/(w²+a²)  ->  -i/2 * sgn(t) * e^{-a|t|}  (a > 0) ──
       ── k*i*w/(w²+a²) ->   1/2 * sgn(t) * e^{-a|t|}  (a > 0) ──
       Dual del par k/(w²+a²): numerador es k*w o k*i*w (lineal en w).
       Verificamos denominador = w²+a² y numerador proporcional a w o i*w. */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [_n_wq, _d_wq, _c2_wq, _c0_wq, _a_wq,
             _cn1_wq, _cn0_wq, _ki_wq, _k_wq],
            _n_wq: part(er, 1),
            _d_wq: rat(expand(part(er, 2))),
            if not freeof(w_var, _d_wq) and freeof('abs, _d_wq)
               and freeof(%e, _d_wq) then (
                _c2_wq: ratsimp(diff(_d_wq, w_var, 2) / 2),
                _c0_wq: ratsimp(subst(w_var=0, _d_wq)),
                /* denominator must be exactly w^2 + a^2 */
                if ratsimp(_c2_wq - 1) = 0 and is(_c0_wq > 0)
                   and ratsimp(_d_wq - (w_var^2 + _c0_wq)) = 0 then (
                    _a_wq: sqrt(ratdisrep(rat(_c0_wq))),
                    if freeof(w_var, _a_wq) and is(_a_wq > 0) then (
                        /* numerator: check proportional to w or i*w */
                        _cn1_wq: errcatch(ratsimp(rat(_n_wq) / w_var)),
                        _cn0_wq: errcatch(ratsimp(subst(w_var=0, rat(_n_wq)))),
                        if _cn1_wq # [] and _cn0_wq # []
                           and freeof(w_var, first(_cn1_wq))
                           and ratsimp(first(_cn0_wq)) = 0 then (
                            _ki_wq: first(_cn1_wq),
                            /* split: k*w case (ki real) vs k*i*w case (ki = k*i) */
                            if freeof(%i, _ki_wq) then (
                                /* k*w/(w^2+a^2) -> +i*k/2 * sgn(t) * e^{-a|t|} */
                                res: [%i * _ki_wq / 2
                                          * sgn(t_var) * exp(-_a_wq*abs(t_var)),
                                      concat("k*w/(w^2+a^2)->ik/2*sgn(t)*e^{-a|t|}, a=",
                                             string(_a_wq))]
                            ) else (
                                /* check ki = k*i, extract real k */
                                _k_wq: errcatch(ratsimp(_ki_wq / %i)),
                                if _k_wq # [] and freeof(%i, first(_k_wq)) then (
                                    _k_wq: first(_k_wq),
                                    /* k*i*w/(w^2+a^2) -> -k/2 * sgn(t) * e^{-a|t|} */
                                    res: [-_k_wq / 2
                                              * sgn(t_var) * exp(-_a_wq*abs(t_var)),
                                          concat("k*iw/(w^2+a^2)->-k/2*sgn(t)*e^{-a|t|}, a=",
                                                 string(_a_wq))]
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── k/(w²+a²) -> k*exp(-a|t|)/(2a)  (a > 0) ── */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [_n_ltz, _d_ltz, _c2_ltz, _c0_ltz, _a_ltz, _k_ltz],
            _n_ltz: part(er, 1),
            _d_ltz: rat(expand(part(er, 2))),
            if freeof(w_var, _n_ltz) and not freeof(w_var, _d_ltz)
               and freeof('abs, _d_ltz) and freeof(%e, _d_ltz) then (
                _c2_ltz: ratsimp(diff(_d_ltz, w_var, 2) / 2),
                _c0_ltz: ratsimp(subst(w_var=0, _d_ltz)),
                if ratsimp(_c2_ltz - 1) = 0 and is(_c0_ltz > 0)
                   and ratsimp(_d_ltz - (w_var^2 + _c0_ltz)) = 0 then (
                    _a_ltz: sqrt(ratdisrep(rat(_c0_ltz))),
                    if freeof(w_var, _a_ltz) and is(_a_ltz > 0) then (
                        _k_ltz: ratsimp(_n_ltz),
                        if freeof(w_var, _k_ltz) then
                            res: [_k_ltz * exp(-_a_ltz * abs(t_var)) / (2 * _a_ltz),
                                  concat("k/(a^2+w^2) -> k*exp(-a|t|)/(2a), a=",
                                         string(_a_ltz))]
                    )
                )
            )
        )
    ),

    /* ── k/(Aw²+Bw+C) -> k/(2Aa)*e^{-a|t|}*e^{iω₀t}  (A>0, 4AC-B²>0) ──
       Generaliza k/(a²+w²) al caso con término lineal completando el cuadrado.
       Aw²+Bw+C = A[(w-ω₀)²+a²]  con  ω₀=-B/(2A),  a=sqrt(4AC-B²)/(2A).
       IFT[(k/A)/(a²+(w-ω₀)²)] = freq-shift de IFT[k/A/(a²+w²)]
                                = k/(2Aa) * e^{-a|t|} * e^{iω₀t}
       Solo activa cuando B≠0 (B=0 lo cubre el handler k/(a²+w²) anterior). */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [_n_gl, _d_gl, _A_gl, _B_gl, _C_gl, _disc_gl, _a_gl, _om0_gl, _k_gl],
            _n_gl: part(er, 1),
            _d_gl: rat(expand(part(er, 2))),
            if freeof(w_var, _n_gl) and not freeof(w_var, _d_gl)
               and freeof('abs, _d_gl) and freeof(%e, _d_gl) then (
                _A_gl: ratsimp(diff(_d_gl, w_var, 2) / 2),
                _B_gl: ratsimp(subst(w_var=0, diff(_d_gl, w_var))),
                _C_gl: ratsimp(subst(w_var=0, _d_gl)),
                /* Solo cuadráticos puros (A>0 real, B≠0, reconstrucción exacta) */
                if freeof(w_var, _A_gl) and freeof(w_var, _B_gl)
                   and freeof(w_var, _C_gl)
                   and is(_A_gl > 0) and not equal(_B_gl, 0)
                   and ratsimp(_d_gl - (_A_gl*w_var^2 + _B_gl*w_var + _C_gl)) = 0 then (
                    _disc_gl: 4*_A_gl*_C_gl - _B_gl^2,
                    /* Accept numeric positive OR symbolic free of w_var */
                    if errcatch(is(_disc_gl > 0)) = [true]
                       or (not numberp(_disc_gl) and freeof(w_var, _disc_gl)) then (
                        _a_gl: sqrt(ratdisrep(rat(_disc_gl / (4*_A_gl^2)))),
                        _om0_gl: ratsimp(-_B_gl / (2*_A_gl)),
                        if freeof(w_var, _a_gl)
                           and (errcatch(is(_a_gl > 0)) = [true] or not numberp(_a_gl))
                           and freeof(w_var, _om0_gl) then (
                            _k_gl: ratsimp(_n_gl),
                            if freeof(w_var, _k_gl) then block(
                                [_had_pos_gl, _had_neg_gl, _expr_gl],
                                _had_pos_gl: errcatch(is(t_var > 0)) = [true],
                                _had_neg_gl: errcatch(is(t_var < 0)) = [true],
                                forget(t_var > 0), forget(t_var < 0),
                                _expr_gl: _k_gl / (2*_A_gl*_a_gl)
                                              * exp(-_a_gl*abs(t_var))
                                              * exp(%i*_om0_gl*t_var),
                                if _had_pos_gl then assume(t_var > 0),
                                if _had_neg_gl then assume(t_var < 0),
                                res: [_expr_gl,
                                      concat("k/(Aw²+Bw+C) -> k/(2Aa)*e^{-a|t|}e^{iω₀t}, ω₀=",
                                             string(_om0_gl), ", a=", string(_a_gl))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── k/sqrt(iw+a) -> k*e^{-at}/sqrt(pi*t)*u(t)  (a > 0) ──
       Detecta denominador sqrt(iw+a) o s*sqrt(iw+a) (s real).
       Usa F_expr directamente — rat() y expand() preservan sqrt aquí,
       pero la estructura op='sqrt' no es "^", hay que verificar explícitamente. */
    if is(res = false) and not atom(F_expr) and is(op(F_expr) = "/") then block(
        [_sq_num, _sq_den, _sq_base, _sq_s, _sq_c1, _sq_c0, _sq_aa, _sq_kk],
        _sq_num: part(F_expr, 1),
        _sq_den: part(F_expr, 2),
        /* denominador: sqrt(base)  o  s * sqrt(base) */
        if not atom(_sq_den) then (
            if is(op(_sq_den) = 'sqrt) then (
                _sq_base: part(_sq_den, 1),
                _sq_s: 1
            ) else if is(op(_sq_den) = "*") then (
                /* buscar el factor sqrt que contiene w_var */
                _sq_base: false, _sq_s: 1,
                for _f in args(_sq_den) do (
                    if not atom(_f) and is(op(_f) = 'sqrt)
                       and not freeof(w_var, part(_f, 1))
                    then _sq_base: part(_f, 1)
                    else _sq_s: _sq_s * _f
                )
            ),
            if is(_sq_base # false) and freeof('delta, _sq_base)
               and not freeof(w_var, _sq_base) then (
                /* base debe ser lineal en w: expand -> c1*w + c0, c1=i, c0 real>0 */
                _sq_c1: errcatch(ratsimp(diff(expand(_sq_base), w_var))),
                _sq_c0: errcatch(ratsimp(subst(w_var=0, expand(_sq_base)))),
                if _sq_c1 # [] and _sq_c0 # [] then (
                    _sq_c1: first(_sq_c1),
                    _sq_c0: first(_sq_c0),
                    if ratsimp(_sq_c1 - %i) = 0
                       and freeof(w_var, _sq_c0) and freeof(%i, _sq_c0)
                       and is(_sq_c0 > 0) then (
                        _sq_aa: _sq_c0,
                        /* k_eff = num / s  (absorbe el escalar del denominador) */
                        _sq_kk: errcatch(ratsimp(_sq_num / _sq_s)),
                        if _sq_kk # [] and freeof(w_var, first(_sq_kk)) then (
                            _sq_kk: first(_sq_kk),
                            res: [_sq_kk * exp(-_sq_aa*t_var)
                                      / (sqrt(%pi) * sqrt(t_var)) * u(t_var),
                                  concat("k/sqrt(iw+a)->k*e^{-at}/sqrt(pi*t)*u(t), a=",
                                         string(_sq_aa))]
                        )
                    )
                )
            )
        )
    ),

    /* ── k/(w*(iw+a)) -> (ik/a)*(sgn(t)/2 - e^{-at}*u(t))  (a > 0) ──
       Via fracciones parciales: 1/(w*(iw+a)) = (1/a)/w - (i/a)/(iw+a) */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [_n_wa, _d_wa, _c2_wa, _c1_wa, _c0_wa, _aa_wa, _k_wa],
            _n_wa: part(er, 1),
            _d_wa: rat(expand(part(er, 2))),
            if freeof(w_var, _n_wa) and not freeof(w_var, _d_wa)
               and freeof('abs, _d_wa) and freeof(%e, _d_wa) then (
                _c2_wa: ratsimp(diff(_d_wa, w_var, 2) / 2),
                _c1_wa: ratsimp(subst(w_var=0, diff(_d_wa, w_var))),
                _c0_wa: ratsimp(subst(w_var=0, _d_wa)),
                /* denominador = %i*w^2 + a*w  =>  c2=%i, c0=0 */
                if ratsimp(_c2_wa - %i) = 0 and ratsimp(_c0_wa) = 0 then (
                    _aa_wa: _c1_wa,
                    if freeof(w_var, _aa_wa) and is(_aa_wa > 0)
                       and ratsimp(_d_wa - (%i*w_var^2 + _aa_wa*w_var)) = 0 then (
                        _k_wa: ratsimp(_n_wa),
                        if freeof(w_var, _k_wa) then
                            res: [%i * _k_wa / _aa_wa
                                      * (sgn(t_var)/2 - exp(-_aa_wa*t_var)*u(t_var)),
                                  concat("k/(w*(iw+a)) -> ik/a*(sgn(t)/2-e^{-at}u(t)), a=",
                                         string(_aa_wa))]
                    )
                )
            )
        )
    ),

    /* ── [e^{it0w}] * c * w^m * sgn(w) -> k/(t-t0)^n  (distribucional, V.P.) ──
       Inversa del par FT[k/t^n](w) = k*(-i)^n*pi/((n-1)!) * w^(n-1) * sgn(w).
       Despejando k: k = c * m! * i^(m+1) / pi  (debe ser real).
       También acepta una variante desplazada con factor e^{it0*w} opcional.
       Maneja unary minus: -(A*B) tiene op="-" después de expand(), se normaliza. ── */
    if is(res = false) then block(
        [_ds_facs, _ds_has_sgn, _ds_m, _ds_rest, _ds_n, _ds_k,
         _ds_exp, _ds_t0, _ds_ok, _ds_f, _ds_e],
        _ds_has_sgn: false, _ds_m: 0, _ds_rest: 1, _ds_exp: false, _ds_ok: true,
        /* Step 1: normalize — expand() may produce -(A) with op="-"
           or (A)/c with op="/" when a constant denominator is present.
           Strip both, folding the factors into _ds_rest.                */
        _ds_e: e,
        if not atom(_ds_e) and is(op(_ds_e) = "-") then (
            _ds_rest: -1, _ds_e: first(args(_ds_e))
        ),
        if not atom(_ds_e) and is(op(_ds_e) = "/")
           and freeof(w_var, part(_ds_e, 2)) then (
            _ds_rest: _ds_rest / part(_ds_e, 2),
            _ds_e: part(_ds_e, 1),
            if not atom(_ds_e) and is(op(_ds_e) = "-") then (
                _ds_rest: -_ds_rest, _ds_e: first(args(_ds_e))
            )
        ),
        /* Step 2: walk factors, classify each one */
        if not atom(_ds_e) and is(op(_ds_e) = "*") then (
            _ds_facs: args(_ds_e),
            for _ds_f in _ds_facs while _ds_ok do (
                if not atom(_ds_f) and is(op(_ds_f) = 'sgn)
                   and ratsimp(_ds_f - sgn(w_var)) = 0 then (
                    /* sgn(w) */
                    if is(_ds_has_sgn = false) then _ds_has_sgn: true
                    else _ds_ok: false
                ) else if is(_ds_f = w_var) then (
                    /* w^1 */
                    _ds_m: _ds_m + 1
                ) else if not atom(_ds_f) and is(op(_ds_f) = "^")
                          and is(part(_ds_f, 1) = w_var)
                          and integerp(part(_ds_f, 2)) and is(part(_ds_f, 2) >= 2) then (
                    /* w^m, m>=2 */
                    _ds_m: _ds_m + part(_ds_f, 2)
                ) else if not atom(_ds_f) and is(op(_ds_f) = "^")
                          and not freeof(%i, _ds_f) and not freeof(w_var, _ds_f) then (
                    /* e^{i*theta*w} — optional time-shift factor */
                    if is(_ds_exp = false) then _ds_exp: _ds_f
                    else _ds_ok: false
                ) else if freeof(w_var, _ds_f) then (
                    /* constant coefficient */
                    _ds_rest: _ds_rest * _ds_f
                ) else _ds_ok: false
            ),
            if _ds_ok and _ds_has_sgn then (
                _ds_n: _ds_m + 1,
                /* k = c * m! * i^(m+1) / pi */
                _ds_k: errcatch(ratsimp(_ds_rest * factorial(_ds_m) * %i^(_ds_m+1) / %pi)),
                if _ds_k # [] then (
                    _ds_k: first(_ds_k),
                    if freeof(w_var, _ds_k) and freeof(%i, _ds_k) then (
                        if is(_ds_exp = false) then
                            /* base case: k/t^n */
                            res: [_ds_k / t_var^_ds_n,
                                  concat("c*w^m*sgn(w)->k/t^n, n=", string(_ds_n),
                                         ", k=", string(_ds_k))]
                        else (
                            /* time-shifted: e^{it0w} → shift t→t+t0, giving k/(t-(-t0))^n */
                            _ds_t0: errcatch(ratsimp(part(_ds_exp, 2) / (%i * w_var))),
                            if _ds_t0 # [] and freeof(w_var, first(_ds_t0)) then (
                                _ds_t0: first(_ds_t0),
                                res: [_ds_k / (t_var - _ds_t0)^_ds_n,
                                      concat("e^{it0w}*c*w^m*sgn(w)->k/(t-t0)^n, n=",
                                             string(_ds_n), ", t0=", string(_ds_t0),
                                             ", k=", string(_ds_k))]
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── time-shift: e^{it0*w}*G(w) -> IFT[G](t+t0) ──
       Simétrico al freq-shift de FT. Usa F_expr (no expand) para que
       el exponente no sea absorbido al denominador. */
    if is(res = false) then block(
        [_ts_e, _ts_numer, _ts_denom, _ts_factors,
         _exp_fac_ts, _t0_ts, _g_rest_ts, _g_ift_ts, _earg_ts, _t0c_ts],
        /* Use F_expr directly — ratsimp can change op from "/" to "-",
           breaking the structural check below.                        */
        _ts_e: F_expr,
        _exp_fac_ts: false, _t0_ts: false, _g_rest_ts: 1,
        if not atom(_ts_e) and (is(op(_ts_e) = "*") or is(op(_ts_e) = "/")) then (
            _ts_denom: if is(op(_ts_e) = "/") then part(_ts_e, 2) else 1,
            _ts_numer: if is(op(_ts_e) = "/") then part(_ts_e, 1) else _ts_e,
            _ts_factors: if not atom(_ts_numer) and is(op(_ts_numer) = "*")
                         then args(_ts_numer) else [_ts_numer],
            for _fac in _ts_factors do (
                if is(_exp_fac_ts = false) and not atom(_fac)
                   and is(op(_fac) = "^") and is(part(_fac, 1) = %e) then (
                    _earg_ts: part(_fac, 2),
                    _t0c_ts: errcatch(ratsimp(_earg_ts / (%i * w_var))),
                    if _t0c_ts # [] and freeof(w_var, first(_t0c_ts))
                       and not equal(first(_t0c_ts), 0)
                       and ratsimp(_earg_ts - %i * first(_t0c_ts) * w_var) = 0 then (
                        _exp_fac_ts: _fac,
                        _t0_ts: first(_t0c_ts)
                    ) else _g_rest_ts: _g_rest_ts * _fac
                ) else _g_rest_ts: _g_rest_ts * _fac
            ),
            if is(_exp_fac_ts # false) then (
                _g_rest_ts: _g_rest_ts / _ts_denom,
                _g_ift_ts: IFT_pattern_lookup(_g_rest_ts, w_var, t_var),
                if is(_g_ift_ts # false) then
                    res: [subst(t_var = t_var + _t0_ts, _g_ift_ts[1]),
                          concat("time-shift: e^{it0w}*G(w)->IFT[G](t+t0), t0=",
                                 string(_t0_ts), ", G=", _g_ift_ts[2])]
            )
        )
    ),

    /* ── freq-shift: F(w-w0) -> e^{+iw0*t}*f(t) ──
       IFT convention: IFT[F(w-w0)] = e^{+iw0*t} * f(t).
       Detect a rational/exponential F_expr whose denominator, when expanded,
       has a complex constant term — extract w0 = -Im(c0)/Im(c1) so that
       substituting w -> w+w0 removes the imaginary shift from the denom.
       Must use F_expr (not er) to avoid rat() absorbing exponentials.      */
    if is(res = false) and not atom(F_expr)
       and (is(op(F_expr) = "/") or is(op(F_expr) = "*")) then block(
        [_fs_den, _fs_lin, _fs_dexp, _fs_c1, _fs_c0, _fs_im_c1, _fs_im_c0,
         _fs_w0, _fs_G, _fs_ift_G],
        /* extract denominator; if it is L(w)^n, use the base L(w) */
        _fs_den: if is(op(F_expr) = "/") then part(F_expr, 2) else false,
        if is(_fs_den # false) and freeof('delta, _fs_den) then (
            /* unwrap power: den = base^n -> extract linear base; else use den itself */
            _fs_lin: if not atom(_fs_den) and is(op(_fs_den) = "^")
                     then part(_fs_den, 1)
                     else _fs_den,
            _fs_dexp: expand(_fs_lin),
            _fs_c1: errcatch(ratsimp(diff(_fs_dexp, w_var))),
            _fs_c0: errcatch(ratsimp(subst(w_var=0, _fs_dexp))),
            if _fs_c1 # [] and _fs_c0 # [] then (
                _fs_c1: first(_fs_c1),
                _fs_c0: first(_fs_c0),
                /* require linear factor (in w) with imaginary parts */
                if freeof(w_var, _fs_c1) and freeof(w_var, _fs_c0)
                   and not freeof(%i, _fs_c0) then (
                    _fs_im_c1: errcatch(ratsimp(imagpart(_fs_c1))),
                    _fs_im_c0: errcatch(ratsimp(imagpart(_fs_c0))),
                    if _fs_im_c1 # [] and _fs_im_c0 # [] then (
                        _fs_im_c1: first(_fs_im_c1),
                        _fs_im_c0: first(_fs_im_c0),
                        if freeof(w_var, _fs_im_c1) and freeof(w_var, _fs_im_c0)
                           and not equal(_fs_im_c1, 0) and not equal(_fs_im_c0, 0) then (
                            _fs_w0: errcatch(ratsimp(-_fs_im_c0 / _fs_im_c1)),
                            if _fs_w0 # [] then (
                                _fs_w0: first(_fs_w0),
                                if freeof(w_var, _fs_w0) and freeof(%i, _fs_w0)
                                   and not equal(_fs_w0, 0) then (
                                    /* substitute w -> w+w0 to unshift.
                                       Use subst only — ratsimp inside IFT_pattern_lookup
                                       can expand negative exponentials into the denominator
                                       due to internal rat() context, hiding the exp factor. */
                                    _fs_G: errcatch(subst(w_var = w_var + _fs_w0, F_expr)),
                                    if _fs_G # [] then (
                                        _fs_G: first(_fs_G),
                                        _fs_ift_G: IFT_pattern_lookup(_fs_G, w_var, t_var),
                                        if is(_fs_ift_G # false) then
                                            res: [exp(+%i*_fs_w0*t_var) * _fs_ift_G[1],
                                                  concat("freq-shift: F(w-w0)->e^{iw0t}*f(t), w0=",
                                                         string(_fs_w0), ", IFT[G]=", _fs_ift_G[2])]
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── sin(b*w)*F(w) -> (IFT[F](t+b) - IFT[F](t-b))/(2i) ──
       Via fórmula de Euler: sin(bw) = (e^{ibw} - e^{-ibw})/(2i) */
    if is(res = false) then block(
        [_sm_numer, _sm_denom, _sin_fac_sm, _b_sm, _rest_sm,
         _nfacs_sm, _fac_sm, _sin_arg_sm, _b_sm_c,
         _F_sm, _f_ift_sm],
        _sin_fac_sm: false, _b_sm: false, _rest_sm: 1,
        if not atom(e) and (is(op(e) = "*") or is(op(e) = "/")) then (
            _sm_numer: if is(op(e) = "/") then part(e, 1) else e,
            _sm_denom: if is(op(e) = "/") then part(e, 2) else 1,
            _nfacs_sm: if not atom(_sm_numer) and is(op(_sm_numer) = "*")
                       then args(_sm_numer) else [_sm_numer],
            for _fac_sm in _nfacs_sm do (
                if is(_sin_fac_sm = false) and not atom(_fac_sm)
                   and is(op(_fac_sm) = 'sin) then (
                    _sin_arg_sm: part(_fac_sm, 1),
                    _b_sm_c: errcatch(ratsimp(_sin_arg_sm / w_var)),
                    if _b_sm_c # [] and freeof(w_var, first(_b_sm_c))
                       and not equal(first(_b_sm_c), 0)
                       and ratsimp(_sin_arg_sm - first(_b_sm_c) * w_var) = 0 then (
                        _sin_fac_sm: _fac_sm,
                        _b_sm: first(_b_sm_c)
                    ) else _rest_sm: _rest_sm * _fac_sm
                ) else _rest_sm: _rest_sm * _fac_sm
            ),
            if is(_sin_fac_sm # false) then (
                _F_sm: _rest_sm / _sm_denom,
                /* Clear t sign assumptions so inner lookup preserves abs(t) form.
                   forget() returns its arg unconditionally — use is() to check first. */
                block([_had_pos_sm, _had_neg_sm],
                    _had_pos_sm: errcatch(is(t_var > 0)) = [true],
                    _had_neg_sm: errcatch(is(t_var < 0)) = [true],
                    forget(t_var > 0), forget(t_var < 0),
                    _f_ift_sm: IFT_pattern_lookup(_F_sm, w_var, t_var),
                    if _had_pos_sm then assume(t_var > 0),
                    if _had_neg_sm then assume(t_var < 0)
                ),
                if is(_f_ift_sm # false) then
                    res: [(subst(t_var = t_var + _b_sm, _f_ift_sm[1])
                           - subst(t_var = t_var - _b_sm, _f_ift_sm[1])) / (2*%i),
                          concat("sin(bw)*F(w)->(f(t+b)-f(t-b))/(2i), b=",
                                 string(_b_sm), ", IFT[F]=", _f_ift_sm[2])]
            )
        )
    ),

    /* ── k*sin(c*(w-w0))/(w-w0) -> k*e^{-iw0*t}*(u(t+c)-u(t-c))/2 ──
       Sinc desplazado en frecuencia.
       IFT[sin(c*(w-w0))/(w-w0)] = e^{-iw0*t} * (u(t+c)-u(t-c))/2
       Detecta denominador lineal (w-w0) y numerador k*sin(c*(w-w0)).
       La normalización extra _c1_ss recoge el coef de w en el denom. */
    if is(res = false) then (
        if not atom(er) and is(op(er) = "/") then block(
            [_nss, _dss, _c2_ss, _c1_ss, _c0_ss, _w0_ss,
             _sin_f_ss, _sin_arg_ss, _cc_ss, _kk_ss],
            _nss: part(er, 1),
            _dss: rat(expand(part(er, 2))),
            _c2_ss: ratsimp(coeff(_dss, w_var, 2)),
            _c1_ss: ratsimp(coeff(_dss, w_var, 1)),
            _c0_ss: ratsimp(coeff(_dss, w_var, 0)),
            if ratsimp(_c2_ss) = 0 and freeof(w_var, _c1_ss)
               and freeof(w_var, _c0_ss) and freeof(%i, _c1_ss)
               and not equal(_c1_ss, 0) then (
                _w0_ss: ratsimp(-_c0_ss / _c1_ss),
                if freeof(w_var, _w0_ss) and freeof(%i, _w0_ss) then (
                    _sin_f_ss: false, _kk_ss: 1,
                    if not atom(_nss) and is(op(_nss) = "*") then (
                        for _sf in args(_nss) do (
                            if is(_sin_f_ss = false) and not atom(_sf)
                               and is(op(_sf) = 'sin)
                            then _sin_f_ss: _sf
                            else _kk_ss: _kk_ss * _sf
                        )
                    ) else if not atom(_nss) and is(op(_nss) = 'sin) then (
                        _sin_f_ss: _nss, _kk_ss: 1
                    ),
                    if is(_sin_f_ss # false) then (
                        _sin_arg_ss: part(_sin_f_ss, 1),
                        _cc_ss: errcatch(ratsimp(_sin_arg_ss / (w_var - _w0_ss))),
                        if _cc_ss # [] and freeof(w_var, first(_cc_ss))
                           and freeof(%i, first(_cc_ss))
                           and not equal(first(_cc_ss), 0)
                           and ratsimp(_sin_arg_ss - first(_cc_ss)*(w_var - _w0_ss)) = 0 then (
                            _cc_ss: first(_cc_ss),
                            if is(_cc_ss > 0) and freeof(w_var, _kk_ss) then
                                res: [_kk_ss * _c1_ss * exp(+%i*_w0_ss*t_var)
                                           * (u(t_var + _cc_ss) - u(t_var - _cc_ss)) / 2,
                                      concat("k*sin(c*(w-w0))/(w-w0)->k*e^{+iw0t}*(u(t+c)-u(t-c))/2, c=",
                                             string(_cc_ss), ", w0=", string(_w0_ss))]
                        )
                    )
                )
            )
        )
    ),

    /* ── cos(b*w)*F(w) -> (IFT[F](t+b) + IFT[F](t-b))/2 ──
       Via fórmula de Euler: cos(bw) = (e^{ibw} + e^{-ibw})/2 */
    if is(res = false) then block(
        [_cm_numer, _cm_denom, _cos_fac_cm, _b_cm, _rest_cm,
         _nfacs_cm, _fac_cm, _cos_arg_cm, _b_cm_c,
         _F_cm, _f_ift_cm],
        _cos_fac_cm: false, _b_cm: false, _rest_cm: 1,
        if not atom(e) and (is(op(e) = "*") or is(op(e) = "/")) then (
            _cm_numer: if is(op(e) = "/") then part(e, 1) else e,
            _cm_denom: if is(op(e) = "/") then part(e, 2) else 1,
            _nfacs_cm: if not atom(_cm_numer) and is(op(_cm_numer) = "*")
                       then args(_cm_numer) else [_cm_numer],
            for _fac_cm in _nfacs_cm do (
                if is(_cos_fac_cm = false) and not atom(_fac_cm)
                   and is(op(_fac_cm) = 'cos) then (
                    _cos_arg_cm: part(_fac_cm, 1),
                    _b_cm_c: errcatch(ratsimp(_cos_arg_cm / w_var)),
                    if _b_cm_c # [] and freeof(w_var, first(_b_cm_c))
                       and not equal(first(_b_cm_c), 0)
                       and ratsimp(_cos_arg_cm - first(_b_cm_c) * w_var) = 0 then (
                        _cos_fac_cm: _fac_cm,
                        _b_cm: first(_b_cm_c)
                    ) else _rest_cm: _rest_cm * _fac_cm
                ) else _rest_cm: _rest_cm * _fac_cm
            ),
            if is(_cos_fac_cm # false) then (
                _F_cm: _rest_cm / _cm_denom,
                /* Clear t sign assumptions so inner lookup preserves abs(t) form.
                   forget() returns its arg unconditionally — use is() to check first. */
                block([_had_pos_cm, _had_neg_cm],
                    _had_pos_cm: errcatch(is(t_var > 0)) = [true],
                    _had_neg_cm: errcatch(is(t_var < 0)) = [true],
                    forget(t_var > 0), forget(t_var < 0),
                    _f_ift_cm: IFT_pattern_lookup(_F_cm, w_var, t_var),
                    if _had_pos_cm then assume(t_var > 0),
                    if _had_neg_cm then assume(t_var < 0)
                ),
                if is(_f_ift_cm # false) then
                    res: [(subst(t_var = t_var + _b_cm, _f_ift_cm[1])
                           + subst(t_var = t_var - _b_cm, _f_ift_cm[1])) / 2,
                          concat("cos(bw)*F(w)->(f(t+b)+f(t-b))/2, b=",
                                 string(_b_cm), ", IFT[F]=", _f_ift_cm[2])]
            )
        )
    ),

    /* ── scalar: k*F(w) -> k*IFT(F(w))  (k constante en w) ── */
    if is(res = false) and not atom(e) and is(op(e) = "*") then block(
        [_factors, _const_k, _w_parts, _ift_core],
        _factors: args(e),
        _const_k: 1,
        _w_parts: [],
        for _fac in _factors do (
            if freeof(w_var, _fac)
            then _const_k: _const_k * _fac
            else _w_parts: cons(_fac, _w_parts)
        ),
        if length(_w_parts) = 1 then (
            _ift_core: IFT_pattern_lookup(first(_w_parts), w_var, t_var),
            if is(_ift_core # false) then
                res: [_const_k * _ift_core[1],
                      concat("k*F(w): k=", string(_const_k), ", ", _ift_core[2])]
        )
    ),

    /* ── (alpha*w + beta)/(w^2+a^2) -> combined causal/anti-causal result ──
       Handles F_expr = k*(alpha*w + beta)/(w^2+a^2) directly, without expanding,
       to avoid linearity splitting it into two terms that can't recombine.
       IFT[(alpha*w+beta)/(w^2+a^2)]
         = alpha*i/2*sgn(t)*e^{-a|t|} + beta/(2a)*e^{-a|t|}
         = e^{-a|t|} * (alpha*i*a + beta) / (2a)
       When alpha*i*a = +beta: coeff = beta/a, result = beta/a*e^{-at}*u(t) (causal)
       When alpha*i*a = -beta: coeff = -beta/a, result = -beta/a*e^{-at}*u(-t) (anti-causal)
       Uses F_expr (not er) so that negation/scalar outside the fraction is preserved. */
    if is(res = false) and not atom(F_expr)
       and (is(op(F_expr) = "/") or is(op(F_expr) = "*")
            or is(op(F_expr) = "-")) then block(
        [_lq_num, _lq_den, _lq_c2, _lq_c0, _lq_a,
         _lq_nc1, _lq_nc0, _lq_alpha, _lq_beta, _lq_check, _lq_k],
        /* Normalize: extract outer scalar k so core = _lq_num/_lq_den */
        _lq_k: 1,
        _lq_num: false, _lq_den: false,
        block([_lq_tmp],
            _lq_tmp: F_expr,
            /* absorb unary minus */
            if not atom(_lq_tmp) and is(op(_lq_tmp) = "-") then (
                _lq_k: -1, _lq_tmp: first(args(_lq_tmp))
            ),
            /* absorb outer scalar in product  k * (numer/denom) */
            if not atom(_lq_tmp) and is(op(_lq_tmp) = "*") then (
                for _lf in args(_lq_tmp) do (
                    if freeof(w_var, _lf) then _lq_k: _lq_k * _lf
                    else if not atom(_lf) and is(op(_lf) = "/")
                    then (_lq_num: part(_lf, 1), _lq_den: part(_lf, 2))
                )
            ) else if not atom(_lq_tmp) and is(op(_lq_tmp) = "/") then (
                _lq_num: part(_lq_tmp, 1),
                _lq_den: part(_lq_tmp, 2)
            )
        ),
        if is(_lq_num # false) and is(_lq_den # false)
           and not freeof(w_var, _lq_num)  /* numerator must depend on w */
           and not freeof(w_var, _lq_den)
           and freeof(%e, _lq_den) and freeof('abs, _lq_den)
           and freeof('delta, _lq_den) then (
            _lq_c2: errcatch(ratsimp(diff(rat(expand(_lq_den)), w_var, 2) / 2)),
            _lq_c0: errcatch(ratsimp(subst(w_var=0, rat(expand(_lq_den))))),
            if _lq_c2 # [] and _lq_c0 # []
               and ratsimp(first(_lq_c2) - 1) = 0   /* coeff w^2 = 1 */
               and is(first(_lq_c0) > 0)
               and ratsimp(rat(expand(_lq_den)) - (w_var^2 + first(_lq_c0))) = 0 then (
                _lq_a: sqrt(ratdisrep(rat(first(_lq_c0)))),
                if freeof(w_var, _lq_a) and is(_lq_a > 0) then (
                    _lq_nc1: errcatch(ratsimp(diff(rat(expand(_lq_num)), w_var))),
                    _lq_nc0: errcatch(ratsimp(subst(w_var=0, rat(expand(_lq_num))))),
                    if _lq_nc1 # [] and _lq_nc0 # []
                       and freeof(w_var, first(_lq_nc1))
                       and freeof(w_var, first(_lq_nc0))
                       and ratsimp(rat(expand(_lq_num))
                                   - (first(_lq_nc1)*w_var + first(_lq_nc0))) = 0 then (
                        _lq_alpha: first(_lq_nc1),
                        _lq_beta:  first(_lq_nc0),
                        /* check causal: alpha*i*a = beta  =>  result k*beta/a*e^{-at}*u(t) */
                        _lq_check: errcatch(ratsimp(_lq_alpha * %i * _lq_a - _lq_beta)),
                        if _lq_check # [] and ratsimp(first(_lq_check)) = 0 then (
                            res: [_lq_k * (_lq_beta / _lq_a) * exp(-_lq_a*t_var) * u(t_var),
                                  concat("(alphaW+beta)/(w^2+a^2)->causal, a=",
                                         string(_lq_a))]
                        ) else (
                            /* check anti-causal: alpha*i*a = -beta */
                            _lq_check: errcatch(ratsimp(_lq_alpha * %i * _lq_a + _lq_beta)),
                            if _lq_check # [] and ratsimp(first(_lq_check)) = 0 then
                                res: [_lq_k * (-_lq_beta / _lq_a)
                                          * exp(-_lq_a*t_var) * u(-t_var),
                                      concat("(alphaW+beta)/(w^2+a^2)->anti-causal, a=",
                                             string(_lq_a))]
                        )
                    )
                )
            )
        )
    ),

    /* ── k*rect(a*w+b) -> k*sin(W*t/2)/(pi*t) * exp(i*w0*t)  (W=1/|a|, w0=-b/a) ──
       IFT[rect(a*(w-w0))](t) = (1/2pi)*integral_{w0-W/2}^{w0+W/2} e^{iwt} dw
                               = sin(W*t/2)/(pi*t) * exp(i*w0*t).
       rect se trata simbólicamente — el mismo FT_match_rect sirve aquí
       con el rol de variable intercambiado (w en lugar de t). */
    if is(res = false) then block(
        [_rm, _rk, _ra, _rb, _rw0, _rW, _raw_res],
        _rm: FT_match_rect(e, w_var),
        if is(_rm # false) then (
            _rk: _rm[1],
            _ra: _rm[2],
            _rb: _rm[3],
            _rw0: ratsimp(-_rb / _ra),
            _rW:  ratsimp(1 / abs(_ra)),
            _raw_res: _rk * sin(_rW * t_var / 2) / (%pi * t_var) * exp(%i * _rw0 * t_var),
            /* si no hay desplazamiento, el resultado es real — simplificar */
            if ratsimp(_rw0) = 0 then
                _raw_res: _rk * sin(_rW * t_var / 2) / (%pi * t_var),
            res: [_raw_res,
                  concat("k*rect(a*w+b)->k*sin(Wt/2)/(pi*t)*exp(iw0t), W=", string(_rW),
                         ", w0=", string(_rw0))]
        )
    ),

    /* ── k*sinc(a*w+b) -> k*(1/(2|a|))*rect(t/(2a)) * exp(i*w0*t)  (w0=-b/a) ──
       IFT[sinc(a*w)](t) = (1/2pi)*∫ sin(aw)/(aw) * e^{iwt} dw = (1/(2|a|))*rect(t/(2a)).
       sinc(x)=sin(x)/x no normalizada; el rect resultante tiene ancho 2|a| en t.
       Desplazamiento w0=-b/a genera e^{iw0t} (frequency-shift → modulation). */
    if is(res = false) then block(
        [_sm, _sk, _sa, _sb, _sw0, _raw_sinc_ift],
        _sm: FT_match_sinc(e, w_var),
        if is(_sm # false) then (
            _sk: _sm[1],
            _sa: _sm[2],
            _sb: _sm[3],
            _sw0: ratsimp(-_sb / _sa),
            _raw_sinc_ift: _sk / (2 * abs(_sa)) * rect(t_var / (2 * _sa)),
            if not equal(ratsimp(_sw0), 0) then
                _raw_sinc_ift: _raw_sinc_ift * exp(%i * _sw0 * t_var),
            res: [_raw_sinc_ift,
                  concat("k*sinc(a*w+b)->k/(2|a|)*rect(t/(2a))*exp(iw0t), w0=",
                         string(_sw0))]
        )
    ),

    /* ── k*sinc(a*w+b)^n (n≥2) — IFT via B-spline formula (dual of FT case) ──
       IFT[sinc^n(aw)](t) = (1/2π) * FT_sincpow_formula(a, 0, n, t)
       = 1/(2π) * (π/(2^n*(n-1)!)) * Σ C(n,k)*(-1)^k*(n-2k-t/a)^(n-1)*sgn(n-2k-t/a) / |a|
       Frequency-shift w0=-b/a generates e^{i*w0*t} modulation. */
    if is(res = false) then block(
        [_spm, _spk, _spa, _spb, _spn, _spw0, _raw_sp_ift],
        _spm: FT_match_sinc_pow(e, w_var),
        if is(_spm # false) then (
            _spk: _spm[1],
            _spa: _spm[2],
            _spb: _spm[3],
            _spn: _spm[4],
            _spw0: ratsimp(-_spb / _spa),
            /* IFT formula: (1/2π) * FT_sincpow_formula evaluated at t_var */
            _raw_sp_ift: _spk / (2 * %pi) * FT_sincpow_formula(_spa, 0, _spn, t_var),
            if not equal(ratsimp(_spw0), 0) then
                _raw_sp_ift: _raw_sp_ift * exp(%i * _spw0 * t_var),
            res: [_raw_sp_ift,
                  concat("k*sinc^n(a*w+b) IFT B-spline, n=", string(_spn),
                         ", a=", string(_spa), ", w0=", string(_spw0))]
        )
    ),

    /* ── k*tri(a*w+b)^n (n=2..4) — IFT table formula (dual of FT case) ──
       IFT[tri(w)^n](t) = (1/2π) * FT_tripow_formula(a, 0, n, t)
       because IFT[F(w)](t) = (1/2π)*FT[F(-w)](t) and tri is even.
       Frequency-shift w0=-b/a generates e^{i*w0*t} modulation. */
    if is(res = false) then block(
        [_tpm, _tpk, _tpa, _tpb, _tpn, _tpw0, _raw_tp_ift],
        _tpm: FT_match_tri_pow(e, w_var),
        if is(_tpm # false) then (
            _tpk: _tpm[1],
            _tpa: _tpm[2],
            _tpb: _tpm[3],
            _tpn: _tpm[4],
            _tpw0: ratsimp(-_tpb / _tpa),
            _raw_tp_ift: errcatch(_tpk / (2*%pi) * FT_tripow_formula(_tpa, 0, _tpn, t_var)),
            if _raw_tp_ift # [] and first(_raw_tp_ift) # false then (
                _raw_tp_ift: first(_raw_tp_ift),
                if not equal(ratsimp(_tpw0), 0) then
                    _raw_tp_ift: _raw_tp_ift * exp(%i * _tpw0 * t_var),
                res: [_raw_tp_ift,
                      concat("k*tri^n(a*w+b) IFT table, n=", string(_tpn),
                             ", a=", string(_tpa), ", w0=", string(_tpw0))]
            )
        )
    ),

    /* ── k*tri(a*w+b) -> k*(2/W)*sin²(W*t/2)/(pi²*t²) * exp(i*w0*t)  (W=1/|a|, w0=-b/a) ──
       IFT[tri(w/W)](t) = (1/2pi)*integral_{-W}^{W} (1-|w|/W) e^{iwt} dw
                        = W/(2pi) * sinc²(Wt/(2pi)) = 2*sin²(Wt/2)/(pi²*t²*W).
       Para desplazamiento w0: multiplicar por e^{i*w0*t} (frequency-shift → time modulation).
       tri se trata simbólicamente — FT_match_tri con variable w. */
    if is(res = false) then block(
        [_tm, _tk, _ta, _tb, _tw0, _tW, _raw_tri_ift],
        _tm: FT_match_tri(e, w_var),
        if is(_tm # false) then (
            _tk: _tm[1],
            _ta: _tm[2],
            _tb: _tm[3],
            _tw0: ratsimp(-_tb / _ta),
            _tW:  ratsimp(1 / abs(_ta)),
            _raw_tri_ift: _tk * 2 * sin(_tW * t_var / 2)^2 / (%pi^2 * t_var^2 * _tW) * (2 * %pi),
            /* simplificacion: 2*sin²(Wt/2)/(pi²*t²*W) * 2*pi = 4*sin²(Wt/2)/(pi*t²*W)... */
            /* usar forma compacta directamente */
            _raw_tri_ift: _tk * _tW * sin(_tW * t_var / 2)^2 / (2 * %pi * (_tW * t_var / 2)^2),
            /* = k*W/(2pi) * sinc²(Wt/2) con sinc no-normalizado */
            /* si no hay desplazamiento, resultado real */
            if not equal(ratsimp(_tw0), 0) then
                _raw_tri_ift: _raw_tri_ift * exp(%i * _tw0 * t_var),
            res: [_raw_tri_ift,
                  concat("k*tri(a*w+b)->k*W*sinc²(Wt/2)/(2pi)*exp(iw0t), W=", string(_tW),
                         ", w0=", string(_tw0))]
        )
    ),

    /* ── IFT of tanh pair: k*(tanh(p*(w+a)) + tanh(p*(w-a))) → k*sin(at)/sinh(bt)
       Inverse of FT[sin(at)/sinh(bt)] = (kπ/(2b))*(tanh(π(a-w)/2b)+tanh(π(a+w)/2b)).
       After expand(), F becomes coef*tanh(p*w+q) - coef*tanh(p*w-q)  (op="+", t2 has op="-").
       Helper FT_extract_tanh_term extracts (coef, arg) from a term of the form
       (const * tanh(linear)) or (const * tanh(linear)) / denom. */
    if is(res = false) and not freeof('tanh, F_expr) then block(
        [_th_e, _th_t1, _th_t2, _th_inner2, _th_sign2, _th_c1, _th_c2, _th_arg1, _th_arg2,
         _th_p1, _th_q1, _th_p2, _th_q2, _th_aa, _th_bb, _th_kk],
        _th_e: expand(F_expr),
        if not atom(_th_e) and is(op(_th_e) = "+") and length(args(_th_e)) = 2 then (
            _th_t1: args(_th_e)[1],
            _th_t2: args(_th_e)[2],
            /* t2 typically has op="-" (unary minus); strip it and record sign */
            if not atom(_th_t2) and is(op(_th_t2) = "-") then (
                _th_inner2: part(_th_t2, 1),
                _th_sign2: -1
            ) else (
                _th_inner2: _th_t2,
                _th_sign2: 1
            ),
            /* Extract (coef, tanh-arg) from a term of form coef*tanh(arg)/denom */
            _th_c1: 1,  _th_arg1: false,
            block([_tt: _th_t1, _denom: 1],
                if not atom(_tt) and is(op(_tt) = "/") then (_denom: part(_tt,2), _tt: part(_tt,1)),
                if not atom(_tt) and is(op(_tt) = 'tanh) then (
                    _th_arg1: part(_tt, 1), _th_c1: 1 / _denom
                ) else if not atom(_tt) and is(op(_tt) = "*") then (
                    for _s in args(_tt) do (
                        if not atom(_s) and is(op(_s) = 'tanh) then _th_arg1: part(_s, 1)
                        else _th_c1: _th_c1 * _s
                    ),
                    if _th_arg1 # false then _th_c1: _th_c1 / _denom
                )
            ),
            _th_c2: 1,  _th_arg2: false,
            block([_tt: _th_inner2, _denom: 1],
                if not atom(_tt) and is(op(_tt) = "/") then (_denom: part(_tt,2), _tt: part(_tt,1)),
                if not atom(_tt) and is(op(_tt) = 'tanh) then (
                    _th_arg2: part(_tt, 1), _th_c2: 1 / _denom
                ) else if not atom(_tt) and is(op(_tt) = "*") then (
                    for _s in args(_tt) do (
                        if not atom(_s) and is(op(_s) = 'tanh) then _th_arg2: part(_s, 1)
                        else _th_c2: _th_c2 * _s
                    ),
                    if _th_arg2 # false then _th_c2: _th_c2 / _denom
                )
            ),
            /* Apply sign from outer unary minus on t2 */
            _th_c2: _th_c2 * _th_sign2,
            if _th_arg1 # false and _th_arg2 # false
               and ratsimp(_th_c1 + _th_c2) = 0 then (
                /* arg1 = p*w + q,  arg2 = p*w - q  (q = p*a > 0) */
                _th_p1: ratsimp(coeff(_th_arg1, w_var, 1)),
                _th_q1: ratsimp(coeff(_th_arg1, w_var, 0)),
                _th_p2: ratsimp(coeff(_th_arg2, w_var, 1)),
                _th_q2: ratsimp(coeff(_th_arg2, w_var, 0)),
                if ratsimp(_th_p1 - _th_p2) = 0 and ratsimp(_th_q1 + _th_q2) = 0
                   and is(_th_p1 > 0) and is(_th_q1 > 0) then (
                    _th_aa: ratsimp(_th_q1 / _th_p1),
                    _th_bb: ratsimp(%pi / (2 * _th_p1)),
                    _th_kk: ratsimp(_th_c1 * (2 * _th_bb) / %pi),
                    if freeof(w_var, _th_aa) and freeof(w_var, _th_bb)
                       and freeof(w_var, _th_kk)
                       and is(_th_aa > 0) and is(_th_bb > 0) then
                        res: [_th_kk * sin(_th_aa * t_var) / sinh(_th_bb * t_var),
                              concat("IFT tanh-pair -> k*sin(at)/sinh(bt), a=",
                                     string(_th_aa), ", b=", string(_th_bb))]
                )
            )
        )
    ),

    /* ── IFT of single sech: k/cosh(p*w) → (k*b/π) * sech(b*t)  [= (kb/π)/cosh(bt)]
       Inverse of FT[sech(bt)](ω) = (π/b)*sech(πω/(2b)) = (π/b)/cosh(πω/(2b)).
       Recognition: F_expr = coef / cosh(p*w)  with constant offset q=0 and p>0.
       Recovers: b = π/(2p),  k = coef * b / π  so that IFT = k/cosh(bt).
       Placed BEFORE the sech-pair handler to catch the single-term case first. */
    if is(res = false) and not freeof(cosh, F_expr) then block(
        [_ss_e, _ss_coef, _ss_arg, _ss_p, _ss_q, _ss_bb, _ss_kk],
        _ss_e: errcatch(expand(F_expr)),
        _ss_e: if _ss_e # [] then first(_ss_e) else F_expr,
        _ss_coef: false,  _ss_arg: false,
        /* Accept only a single fraction coef/cosh(p*w), no addition */
        if not atom(_ss_e) and is(op(_ss_e) = "/") then block(
            [_num: part(_ss_e, 1), _den: part(_ss_e, 2)],
            if not atom(_den) and is(op(_den) = 'cosh)
            then (_ss_coef: _num, _ss_arg: part(_den, 1))
            else if not atom(_den) and is(op(_den) = "*") then (
                _ss_coef: _num,
                for _s in args(_den) do (
                    if not atom(_s) and is(op(_s) = 'cosh) then _ss_arg: part(_s, 1)
                    else _ss_coef: _ss_coef / _s
                )
            )
        ),
        if _ss_coef # false and _ss_arg # false
           and freeof(w_var, _ss_coef) then (
            _ss_p: ratsimp(coeff(_ss_arg, w_var, 1)),
            _ss_q: ratsimp(coeff(_ss_arg, w_var, 0)),
            /* Require linear in w with zero constant offset (pure sech centered at 0) */
            if freeof(w_var, _ss_p) and ratsimp(_ss_q) = 0 and is(_ss_p > 0) then (
                _ss_bb: ratsimp(%pi / (2 * _ss_p)),
                _ss_kk: ratsimp(_ss_coef * _ss_bb / %pi),
                if freeof(w_var, _ss_bb) and freeof(w_var, _ss_kk) and is(_ss_bb > 0) then
                    res: [_ss_kk / cosh(_ss_bb * t_var),
                          concat("IFT single-sech: k/cosh(pw) -> (kb/π)/cosh(bt), b=",
                                 string(_ss_bb))]
            )
        )
    ),

    /* ── IFT of sech/1-cosh pair: k*(1/cosh(p*(w+a)) + 1/cosh(p*(w-a))) → k*cos(at)/cosh(bt)
       Inverse of FT[cos(at)/cosh(bt)] = (kπ/(2b))*(1/cosh(π(w-a)/2b)+1/cosh(π(w+a)/2b)).
       After expand(), F becomes coef/cosh(p*w+q) + coef/cosh(p*w-q)  (op="+", both positive).
       Recovers: a = |q/p|,  b = π/(2p),  k from coef.                           */
    if is(res = false) and not freeof(cosh, F_expr) then block(
        [_sc_e, _sc_t1, _sc_t2, _sc_c1, _sc_c2, _sc_arg1, _sc_arg2,
         _sc_p1, _sc_q1, _sc_p2, _sc_q2, _sc_aa, _sc_bb, _sc_kk],
        _sc_e: expand(F_expr),
        if not atom(_sc_e) and is(op(_sc_e) = "+") and length(args(_sc_e)) = 2 then (
            _sc_t1: args(_sc_e)[1],
            _sc_t2: args(_sc_e)[2],
            /* Extract (coef, cosh-arg) from term of form coef/cosh(arg) or coef/(k*cosh(arg)) */
            _sc_c1: false,  _sc_arg1: false,
            if not atom(_sc_t1) and is(op(_sc_t1) = "/") then block(
                [_num: part(_sc_t1,1), _den: part(_sc_t1,2)],
                if not atom(_den) and is(op(_den) = 'cosh)
                then (_sc_c1: _num, _sc_arg1: part(_den,1))
                else if not atom(_den) and is(op(_den) = "*") then (
                    _sc_c1: _num,
                    for _s in args(_den) do (
                        if not atom(_s) and is(op(_s) = 'cosh) then _sc_arg1: part(_s,1)
                        else _sc_c1: _sc_c1 / _s
                    )
                )
            ),
            _sc_c2: false,  _sc_arg2: false,
            if not atom(_sc_t2) and is(op(_sc_t2) = "/") then block(
                [_num: part(_sc_t2,1), _den: part(_sc_t2,2)],
                if not atom(_den) and is(op(_den) = 'cosh)
                then (_sc_c2: _num, _sc_arg2: part(_den,1))
                else if not atom(_den) and is(op(_den) = "*") then (
                    _sc_c2: _num,
                    for _s in args(_den) do (
                        if not atom(_s) and is(op(_s) = 'cosh) then _sc_arg2: part(_s,1)
                        else _sc_c2: _sc_c2 / _s
                    )
                )
            ),
            if _sc_c1 # false and _sc_arg1 # false
               and _sc_c2 # false and _sc_arg2 # false
               and ratsimp(_sc_c1 - _sc_c2) = 0 then (
                _sc_p1: ratsimp(coeff(_sc_arg1, w_var, 1)),
                _sc_q1: ratsimp(coeff(_sc_arg1, w_var, 0)),
                _sc_p2: ratsimp(coeff(_sc_arg2, w_var, 1)),
                _sc_q2: ratsimp(coeff(_sc_arg2, w_var, 0)),
                if ratsimp(_sc_p1 - _sc_p2) = 0 and ratsimp(_sc_q1 + _sc_q2) = 0
                   and is(_sc_p1 > 0) then (
                    _sc_aa: ratsimp(abs(_sc_q1) / _sc_p1),
                    _sc_bb: ratsimp(%pi / (2 * _sc_p1)),
                    _sc_kk: ratsimp(_sc_c1 * (2 * _sc_bb) / %pi),
                    if freeof(w_var, _sc_aa) and freeof(w_var, _sc_bb)
                       and freeof(w_var, _sc_kk) and is(_sc_bb > 0) then
                        res: [_sc_kk * cos(_sc_aa * t_var) / cosh(_sc_bb * t_var),
                              concat("IFT sech-pair -> k*cos(at)/cosh(bt), a=",
                                     string(_sc_aa), ", b=", string(_sc_bb))]
                )
            )
        )
    ),

    /* ── linearity: IFT(F+G+...) = IFT(F)+IFT(G)+... ──
       Handles unary minus terms (op="-") by negating the inner IFT.
       Placed AFTER tanh-pair and sech-pair handlers so those compound patterns
       are not prematurely split into individual tanh/sech terms. */
    if is(res = false) and not atom(e) and is(op(e) = "+") then block(
        [_terms, _all_ok, _f_sum, _ift_i, _inner],
        _terms: args(e),
        _all_ok: true,
        _f_sum: 0,
        for _term in _terms while _all_ok do (
            if not atom(_term) and is(op(_term) = "-") then (
                _inner: first(args(_term)),
                _ift_i: IFT_pattern_lookup(_inner, w_var, t_var),
                if is(_ift_i = false) then _all_ok: false
                else _f_sum: _f_sum - _ift_i[1]
            ) else (
                _ift_i: IFT_pattern_lookup(_term, w_var, t_var),
                if is(_ift_i = false) then _all_ok: false
                else _f_sum: _f_sum + _ift_i[1]
            )
        ),
        if _all_ok then res: [_f_sum, "linearity: IFT(F+G+...) = IFT(F)+IFT(G)+..."]
    ),

    /* ── partfrac: descomponer en fracciones parciales y aplicar linealidad ──
       Último recurso antes de devolver false.  Aplica partfrac(F_expr, w_var)
       al racional er; si el resultado es una suma, intenta IFT term a term.
       Cubre: 1/((iw+a)(iw+b)), (iw+c)/((iw+a)^2*(iw+b)), etc.
       Solo activa si er tiene op="/" (no sobre sumas ni deltas).           */
    if is(res = false) and not atom(er) and is(op(er) = "/")
       and freeof('delta, er) and not freeof(w_var, er) then block(
        [_pf_expr, _pf_terms, _pf_ok, _pf_sum, _pf_i, _pf_inner],
        _pf_expr: errcatch(partfrac(er, w_var)),
        if _pf_expr # [] then (
            _pf_expr: first(_pf_expr),
            /* solo útil si partfrac produjo una suma de términos */
            if not atom(_pf_expr) and is(op(_pf_expr) = "+") then (
                _pf_terms: args(_pf_expr),
                _pf_ok: true,
                _pf_sum: 0,
                for _pf_t in _pf_terms while _pf_ok do (
                    if not atom(_pf_t) and is(op(_pf_t) = "-") then (
                        _pf_inner: first(args(_pf_t)),
                        _pf_i: IFT_pattern_lookup(_pf_inner, w_var, t_var),
                        if is(_pf_i = false) then _pf_ok: false
                        else _pf_sum: _pf_sum - _pf_i[1]
                    ) else (
                        _pf_i: IFT_pattern_lookup(_pf_t, w_var, t_var),
                        if is(_pf_i = false) then _pf_ok: false
                        else _pf_sum: _pf_sum + _pf_i[1]
                    )
                ),
                if _pf_ok then
                    res: [_pf_sum, "partfrac -> linearity"]
            )
        )
    ),

    res
)$

/* ════════════════════════════════════════════════════════════════════
   BLOQUE 5 — FT principal (sin output, solo devuelve valores)

   El loop defensivo corre en FT() ANTES de la integracion por tramos
   para garantizar que parametros como 'a' esten declarados cuando
   integrate() los necesite, no solo cuando el lookup los usa.
   Esto resuelve el caso exp(-at) de [0,inf) que requiere a>0 para
   que la integral converja.
   ════════════════════════════════════════════════════════════════════ */

/* FT_is_periodic_nondecaying: true when expr is periodic in t_var and has
   no decaying envelope — meaning FT on (-inf,inf) does not exist as an
   ordinary function (only as a distribution).

   Periodic = contains sin or cos with a t_var-dependent argument, OR
   abs of such a function.

   Non-decaying = the denominator of the expression is free of t_var
   (ruling out sin(bt)/(a+t^n) style functions) AND there is no explicit
   exp(-a*t) factor with a > 0.

   This check is intentionally conservative: if in doubt, we return false
   and let the integrator try (it will fail, but safely). */
FT_is_periodic_nondecaying(expr, t_var) := block(
    [_e, _numer, _denom, _has_trig, _trig_uses_t,
     _has_decay, _facs, _f, _base, _exparg, _coeff, _sgn],
    _e: expr,
    /* Extract numerator and denominator */
    _numer: if not atom(_e) and is(op(_e) = "/") then part(_e, 1) else _e,
    _denom: if not atom(_e) and is(op(_e) = "/") then part(_e, 2) else 1,
    /* If denominator depends on t_var, the function decays → not periodic-nondecaying */
    if not freeof(t_var, _denom) then return(false),
    /* If expression contains u(...), the support is restricted → FT may exist */
    if not freeof('u, _e) then return(false),
    /* Check for trig content in numerator */
    _has_trig: not freeof('sin, _numer) or not freeof('cos, _numer),
    if not _has_trig then return(false),
    /* Verify trig argument actually depends on t_var */
    _trig_uses_t: false,
    if not atom(_numer) then
        for _sub in args(expand(_numer)) do (
            if not atom(_sub) and
               (is(op(_sub) = 'sin) or is(op(_sub) = 'cos) or
                (is(op(_sub) = 'abs) and not atom(first(args(_sub))) and
                 (is(op(first(args(_sub))) = 'sin) or is(op(first(args(_sub))) = 'cos)))) and
               not freeof(t_var, _sub) then
                _trig_uses_t: true
        ),
    if not _trig_uses_t then return(false),
    /* Check for exponential decay: e^{-a*t} or e^{-a*abs(t)} with a > 0.
       All vars declared at block level to avoid scope issues with return(). */
    _has_decay: false,
    _facs: if not atom(_numer) and is(op(_numer) = "*") then args(_numer) else [_numer],
    for _f in _facs while not _has_decay do (
        if not atom(_f) and is(op(_f) = "^") then (
            _base: part(_f, 1),
            _exparg: part(_f, 2),
            if is(_base = %e) and not freeof(t_var, _exparg) then (
                /* e^{-a*t}: exparg/t_var is a negative constant */
                _coeff: errcatch(ratsimp(_exparg / t_var)),
                if _coeff # [] and freeof(t_var, first(_coeff)) then (
                    _sgn: errcatch(is(first(_coeff) < 0)),
                    if _sgn # [] and first(_sgn) = true then _has_decay: true
                ),
                /* e^{-a*abs(t)}: exparg/abs(t_var) is a negative constant */
                if not _has_decay and not freeof('abs, _exparg) then (
                    _coeff: errcatch(ratsimp(_exparg / abs(t_var))),
                    if _coeff # [] and freeof(t_var, first(_coeff)) then (
                        _sgn: errcatch(is(first(_coeff) < 0)),
                        if _sgn # [] and first(_sgn) = true then _has_decay: true
                    )
                )
            )
        )
    ),
    if _has_decay then return(false),
    true
)$

FT(FUNC_INPUT, t_var, w_var) := block(
    [n_orig, expanded, pieces, F_acum, F,
     F_real, F_imag, exists, had_error, pattern, done,
     trozo, f_i, ai, bi, contrib, free_params,
     _ft_reserved, _input_params],

    exists: false,
    done: false,
    declare(w_var, real),
    _ft_reserved: [t_var, w_var],

    /* ── collect + declare free params from all pieces (expr and limits) ── */
    _input_params: [],
    for i : 1 thru length(FUNC_INPUT) do (
        FT_declare_params(FUNC_INPUT[i][1], _ft_reserved),
        FT_declare_params(FUNC_INPUT[i][2], _ft_reserved),
        FT_declare_params(FUNC_INPUT[i][3], _ft_reserved),
        _input_params: append(_input_params,
            listofvars(FUNC_INPUT[i][1]),
            listofvars(FUNC_INPUT[i][2]),
            listofvars(FUNC_INPUT[i][3]))
    ),

    n_orig : length(FUNC_INPUT),
    done   : false,

    /* ── intento de patron para intervalo completo ── */
    if n_orig = 1 then (
        block([tr],
            tr: FUNC_INPUT[1],
            if FT_is_minf(tr[2]) and FT_is_inf(tr[3]) then (
                pattern: FT_pattern_lookup(tr[1], t_var, w_var),
                if is(pattern # false) then (
                    F      : pattern[1],
                    F_real : if freeof(%i, F) then F else ratsimp(realpart(F)),
                    F_imag : if freeof(%i, F) then 0 else ratsimp(imagpart(F)),
                    exists : true,
                    done   : true
                ) else (
                    /* Pattern lookup failed. If the function is periodic and
                       non-decaying, its FT does not exist as an ordinary function
                       and integrate() would hang asking interactive sign questions.
                       Mark as non-existent immediately. */
                    if FT_is_periodic_nondecaying(tr[1], t_var) then (
                        F: false, F_real: false, F_imag: false,
                        exists: false, done: true
                    )
                )
            )
        )
    ),

    /* ── intento de patron para tramo [c, inf) ──
       Multiplica por u(t_var-c) para reutilizar los detectores
       que esperan u(t) explicito en intervalo completo.
       Si la expresion ya contiene u(t_var), no agrega otro.  */
    if n_orig = 1 and not done then (
        block([tr, t0_val, f_aug],
            tr: FUNC_INPUT[1],
            if FT_is_inf(tr[3]) and not FT_is_minf(tr[2]) then (
                t0_val: tr[2],
                f_aug: if freeof('u, tr[1]) then
                           tr[1] * u(t_var - t0_val)
                       else
                           tr[1],
                pattern: FT_pattern_lookup(f_aug, t_var, w_var),
                if is(pattern # false) then (
                    F      : pattern[1],
                    F_real : if freeof(%i, F) then F else ratsimp(realpart(F)),
                    F_imag : if freeof(%i, F) then 0 else ratsimp(imagpart(F)),
                    exists : true,
                    done   : true
                )
            )
        )
    ),

    /* ── convertir u(t-a)-u(t-b) a pulso e integrar en [a,b] ── */
    if n_orig = 1 and not done then (
        block([tr, fe, terms, u_terms, other_terms,
               k1, k2, ua1, ua2, s1, s2],
            tr: FUNC_INPUT[1],
            if FT_is_minf(tr[2]) and FT_is_inf(tr[3]) then (
                fe: expand(tr[1]),
                if not freeof('u, fe) and not atom(fe) and is(op(fe) = "+") then (
                    terms: args(fe),
                    u_terms: sublist(terms, lambda([x], not freeof('u, x))),
                    other_terms: sublist(terms, lambda([x], freeof('u, x))),
                    if length(u_terms) = 2 then block(
                        [t1, t2, u1, u2, c1, c2],
                        t1: u_terms[1],
                        t2: u_terms[2],

                        /* funcion auxiliar para extraer [coef, u_expr] de un termino
                           maneja: u(t-a), k*u(t-a), -u(t-a), -k*u(t-a),
                                   k*u/n, -(k*u/n)                          */
                        block([extract],
                            extract: lambda([term],
                                if is(op(term) = 'u) then [1, term]
                                else if is(op(term) = "*") then block(
                                    [cc: 1, uu: false],
                                    for ss in args(term) do (
                                        if not atom(ss) and is(op(ss) = 'u)
                                        then uu: ss
                                        else cc: cc * ss
                                    ),
                                    if is(uu # false) then [cc, uu] else false
                                )
                                else if is(op(term) = "-") then block(
                                    [inner: part(term, 1)],
                                    if is(op(inner) = 'u) then [-1, inner]
                                    else if is(op(inner) = "*") then block(
                                        [cc: 1, uu: false],
                                        for ss in args(inner) do (
                                            if not atom(ss) and is(op(ss) = 'u)
                                            then uu: ss
                                            else cc: cc * ss
                                        ),
                                        if is(uu # false) then [-cc, uu] else false
                                    )
                                    /* caso: -(k*u/n) */
                                    else if is(op(inner) = "/") then block(
                                        [num_i, den_i, inner_r2],
                                        num_i: part(inner, 1),
                                        den_i: part(inner, 2),
                                        if freeof('u, den_i) then (
                                            inner_r2:
                                                if is(op(num_i) = 'u) then [1, num_i]
                                                else if is(op(num_i) = "*") then block(
                                                    [cc: 1, uu: false],
                                                    for ss in args(num_i) do (
                                                        if not atom(ss) and is(op(ss) = 'u)
                                                        then uu: ss
                                                        else cc: cc * ss
                                                    ),
                                                    if is(uu # false) then [cc, uu] else false
                                                )
                                                else false,
                                            if is(inner_r2 # false)
                                            then [-inner_r2[1]/den_i, inner_r2[2]]
                                            else false
                                        )
                                        else false
                                    )
                                    else false
                                )
                                else if is(op(term) = "/") then block(
                                    [num_t, den_t],
                                    num_t: part(term, 1),
                                    den_t: part(term, 2),
                                    if freeof('u, den_t) then block(
                                        [inner_r],
                                        inner_r:
                                            if is(op(num_t) = 'u) then [1, num_t]
                                            else if is(op(num_t) = "*") then block(
                                                [cc: 1, uu: false],
                                                for ss in args(num_t) do (
                                                    if not atom(ss) and is(op(ss) = 'u)
                                                    then uu: ss
                                                    else cc: cc * ss
                                                ),
                                                if is(uu # false) then [cc, uu] else false
                                            )
                                            else if is(op(num_t) = "-") then block(
                                                [inner2: part(num_t, 1)],
                                                if is(op(inner2) = 'u) then [-1, inner2]
                                                else if is(op(inner2) = "*") then block(
                                                    [cc: 1, uu: false],
                                                    for ss in args(inner2) do (
                                                        if not atom(ss) and is(op(ss) = 'u)
                                                        then uu: ss
                                                        else cc: cc * ss
                                                    ),
                                                    if is(uu # false) then [-cc, uu] else false
                                                )
                                                else false
                                            )
                                            else false,
                                        if is(inner_r # false)
                                        then [inner_r[1]/den_t, inner_r[2]]
                                        else false
                                    )
                                    else false
                                )
                                else false
                            ),
                            block([r1, r2],
                                r1: extract(t1),
                                r2: extract(t2),
                                if is(r1 # false) and is(r2 # false) then (
                                    c1: r1[1],  u1: r1[2],
                                    c2: r2[1],  u2: r2[2],
                                    if ratsimp(c1 + c2) = 0 then block(
                                        [a_lim, b_lim, f_base, contrib_p],
                                        s1: ratsimp(subst(t_var=0, part(u1, 1))),
                                        s2: ratsimp(subst(t_var=0, part(u2, 1))),
                                        if is(ratsimp(s2-s1) > 0)
                                        then (a_lim: s1, b_lim: s2, f_base: c1)
                                        else (a_lim: s2, b_lim: s1, f_base: c2),
                                        if length(other_terms) > 0 then
                                            f_base: f_base + apply("+", other_terms),
                                        contrib_p: FT_raw(f_base, t_var, w_var, a_lim, b_lim),
                                        if contrib_p # 'failed then (
                                            F: errcatch(FT_simplify(contrib_p)),
                                            F: if F = [] then contrib_p else first(F),
                                            F_real: if freeof(%i,F) then F
                                                    else ratsimp(realpart(F)),
                                            F_imag: if freeof(%i,F) then 0
                                                    else ratsimp(imagpart(F)),
                                            exists: FT_exists(F),
                                            done: true
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    ),

    /* ── tramos [c,inf) con constante -> usar lookup de u(t-c) ──
       Maneja funciones por tramos con tramos semi-infinitos.       */
    if not done then block(
        [F_acum2, all_ok, processed],
        F_acum2: 0,
        all_ok: true,
        processed: 0,
        for i: 1 thru n_orig do block(
            [tr, f_tr, a_tr, b_tr, pat, contrib2],
            tr: FUNC_INPUT[i],
            f_tr: tr[1],
            a_tr: tr[2],
            b_tr: tr[3],
            if FT_is_inf(b_tr) and not FT_is_minf(a_tr)
            and freeof(t_var, f_tr) and not equal(f_tr, 0) then (
                pat: FT_pattern_lookup(f_tr * u(t_var - a_tr), t_var, w_var),
                if is(pat # false)
                then (F_acum2: F_acum2 + pat[1], processed: processed + 1)
                else all_ok: false
            )
            else if FT_is_minf(a_tr) and not FT_is_inf(b_tr)
            and freeof(t_var, f_tr) and not equal(f_tr, 0) then (
                all_ok: false
            )
            else if not FT_is_inf(b_tr) and not FT_is_minf(a_tr) then (
                /* Si el tramo contiene abs(), expandirlo antes de integrar.
                   FT_raw no puede integrar abs(t) directamente y devuelve
                   una integral sin evaluar (no el sentinel 'failed), lo que
                   falsamente marca el tramo como procesado.                 */
                if not freeof('abs, f_tr) then block(
                    [abs_pieces, ok_abs],
                    abs_pieces: FT_expand_abs([f_tr, a_tr, b_tr], t_var),
                    ok_abs: true,
                    for piece in abs_pieces do block(
                        [c3],
                        c3: FT_raw(piece[1], t_var, w_var, piece[2], piece[3]),
                        if c3 = 'failed or not FT_exists(c3)
                        then ok_abs: false
                        else F_acum2: F_acum2 + c3
                    ),
                    if ok_abs then processed: processed + 1
                    else all_ok: false
                )
                else (
                    contrib2: FT_raw(f_tr, t_var, w_var, a_tr, b_tr),
                    if contrib2 = 'failed or not FT_exists(contrib2)
                    then all_ok: false
                    else (F_acum2: F_acum2 + contrib2, processed: processed + 1)
                )
            )
            /* tramos con f=0 cuentan como procesados */
            else if equal(f_tr, 0) then processed: processed + 1
        ),
        /* solo aceptar si procesamos TODOS los tramos */
        if all_ok and processed = n_orig then (
            F: errcatch(FT_simplify(F_acum2)),
            F: if F = [] then F_acum2 else first(F),
            F_real: if freeof(%i,F) then F else ratsimp(realpart(F)),
            F_imag: if freeof(%i,F) then 0 else ratsimp(imagpart(F)),
            exists: FT_exists(F),
            done: true
        )
    ),

    /* ── integracion por tramos si no hubo patron ── */
    if not done then (
        expanded : [],
        for i : 1 thru n_orig do
            expanded : append(expanded, FT_expand_abs(FUNC_INPUT[i], t_var)),

        pieces    : length(expanded),
        F_acum    : 0,
        had_error : false,

        for i : 1 thru pieces do (
            trozo   : expanded[i],
            f_i     : trozo[1],
            ai      : trozo[2],
            bi      : trozo[3],
            contrib : FT_raw(f_i, t_var, w_var, ai, bi),
            if contrib = 'failed
            then (
                had_error : true,
                F_acum : F_acum + 'integrate(
                    f_i * exp(-%i * w_var * t_var), t_var, ai, bi)
            )
            else F_acum : F_acum + contrib
        ),

        F : errcatch(FT_simplify(F_acum)),
        F : if F = [] then F_acum else first(F),

        if not freeof('expintegral_shi, F) or
           not freeof('expintegral_chi, F) then (
            F : errcatch(simplify_expint(F)),
            F : if F = [] then F else first(F)
        ),

        exists : FT_exists(F) and not had_error,

        F_real : errcatch(ratsimp(realpart(F))),
        F_real : if F_real = [] then 'unknown else first(F_real),
        F_imag : errcatch(ratsimp(imagpart(F))),
        F_imag : if F_imag = [] then 'unknown else first(F_imag)
    ),

    /* Union of params from result F and from input limits/exprs.
       Catches params that appear only in limits and cancel out of F. */
    block([_reserved: append(_ft_reserved, ['u, 'delta, 'sgn]), _fp_result, _fp_input, _sym],
        _fp_result: FT_free_params(F, _reserved),
        _fp_input: [],
        for _sym in _input_params do (
            if not numberp(_sym) and not member(_sym, _reserved)
               and not member(_sym, _fp_input) then
                _fp_input: append(_fp_input, [_sym])
        ),
        free_params: listify(setify(append(_fp_result, _fp_input)))
    ),

    [F, F_real, F_imag, if done then exists else exists, free_params]
)$

/* ════════════════════════════════════════════════════════════════════
   BLOQUE 6 — IFT principal (sin output, solo devuelve valores)

   Mismo patron que FT: loop defensivo antes de integrar.
   ════════════════════════════════════════════════════════════════════ */

IFT(FUNC_INPUT, w_var, t_var) := block(
    [n_orig, expanded, pieces, f_acum, f,
     f_real, f_imag, exists, had_error, pattern, done,
     trozo, F_i, ai, bi, contrib,
     _ift_reserved],

    declare(t_var, real),
    _ift_reserved: [w_var, t_var],

    /* ── declarar parametros libres de todos los tramos (expresion y limites) ── */
    for i : 1 thru length(FUNC_INPUT) do (
        FT_declare_params(FUNC_INPUT[i][1], _ift_reserved),
        FT_declare_params(FUNC_INPUT[i][2], _ift_reserved),
        FT_declare_params(FUNC_INPUT[i][3], _ift_reserved)
    ),

    n_orig : length(FUNC_INPUT),
    done   : false,

    /* ── intento de patron para intervalo completo ── */
    if n_orig = 1 then (
        block([tr],
            tr: FUNC_INPUT[1],
            if FT_is_minf(tr[2]) and FT_is_inf(tr[3]) then (
                pattern: IFT_pattern_lookup(tr[1], w_var, t_var),
                if is(pattern # false) then (
                    f      : pattern[1],
                    f_real : if freeof(%i, f) then f else ratsimp(realpart(f)),
                    f_imag : if freeof(%i, f) then 0 else ratsimp(imagpart(f)),
                    done   : true
                )
            )
        )
    ),

    /* ── integracion por tramos si no hubo patron ── */
    if not done then (
        expanded : [],
        for i : 1 thru n_orig do
            expanded : append(expanded, IFT_expand_abs(FUNC_INPUT[i], w_var)),

        pieces    : length(expanded),
        f_acum    : 0,
        had_error : false,

        for i : 1 thru pieces do (
            trozo   : expanded[i],
            F_i     : trozo[1],
            ai      : trozo[2],
            bi      : trozo[3],
            contrib : IFT_raw(F_i, w_var, t_var, ai, bi),
            if contrib = 'failed
            then (
                had_error : true,
                f_acum : f_acum + (1/(2*%pi)) * 'integrate(
                    F_i * exp(%i * w_var * t_var), w_var, ai, bi)
            )
            else f_acum : f_acum + contrib
        ),

        f : errcatch(IFT_simplify(f_acum)),
        f : if f = [] then f_acum else first(f),

        if not freeof('expintegral_shi, f) or
           not freeof('expintegral_chi, f) then (
            f : errcatch(simplify_expint(f)),
            f : if f = [] then f else first(f)
        ),

        exists : IFT_exists(f) and not had_error,

        f_real : errcatch(ratsimp(realpart(f))),
        f_real : if f_real = [] then 'unknown else first(f_real),
        f_imag : errcatch(ratsimp(imagpart(f))),
        f_imag : if f_imag = [] then 'unknown else first(f_imag)
    ),

    [f, f_real, f_imag, if done then true else exists]
)$

/* ════════════════════════════════════════════════════════════════════
   BLOQUE 7 — IFT_bilateral
   ════════════════════════════════════════════════════════════════════ */

IFT_bilateral(FUNC_INPUT, w_var, t_var) := block(
    [rp, rn, f_pos, f_neg, f_combined, fn_flip, dcheck, same_branch,
     eq_pos, eq_neg,
     free_params, _ift_reserved, _ift_ref,
     _pre_pat, _input_params],

    /* ── Pre-check: pattern lookup without any assumptions ──────────────────
       Handlers that embed abs(t) or sgn(t) in their result already encode
       the full bilateral form.  Calling them under assume(t>0/t<0) partially
       evaluates abs() but leaves sgn() unresolved, making the merge below
       fail.  We detect this early and return the bilateral formula directly,
       e.g. IFT(ω/(a²+ω²)) = (i/2)·sgn(t)·e^{-a|t|}.                      */
    _pre_pat: if length(FUNC_INPUT) = 1
                 and FT_is_minf(FUNC_INPUT[1][2])
                 and FT_is_inf(FUNC_INPUT[1][3])
              then IFT_pattern_lookup(FUNC_INPUT[1][1], w_var, t_var)
              else false,
    if is(_pre_pat # false)
       and (not freeof('abs, _pre_pat[1]) or not freeof('sgn, _pre_pat[1])) then (
        _ift_reserved: [t_var, w_var, 'u, 'delta, 'sgn],
        free_params: FT_free_params(_pre_pat[1], _ift_reserved),
        return([_pre_pat[1], _pre_pat[1], _pre_pat[1], free_params])
    ),

    assume(t_var > 0),
    rp    : IFT(FUNC_INPUT, w_var, t_var),
    f_pos : first(rp),
    forget(t_var > 0),

    assume(t_var < 0),
    rn    : IFT(FUNC_INPUT, w_var, t_var),
    f_neg : first(rn),
    forget(t_var < 0),

    fn_flip: ratsimp(subst(t_var = -t_var, f_neg)),
    dcheck:  ratsimp(fn_flip - f_pos),
    same_branch: ratsimp(f_pos - f_neg),

        /*
            Robust bilateral merge:
            - compare f_pos(t) with mirrored branch f_neg(-t)
            - enforce assumptions in each valid region to simplify abs/branching
        */
        assume(t_var > 0),
        eq_pos: errcatch(fullratsimp(ratsimp(subst(t_var = -t_var, f_neg) - f_pos))),
        forget(t_var > 0),
        eq_pos: if eq_pos = [] then false else first(eq_pos),

        assume(t_var < 0),
        eq_neg: errcatch(fullratsimp(ratsimp(subst(t_var = -t_var, f_pos) - f_neg))),
        forget(t_var < 0),
        eq_neg: if eq_neg = [] then false else first(eq_neg),

        f_combined: if same_branch = 0
        then f_pos
                else if eq_pos = 0 and eq_neg = 0
                then ratsimp(subst(t_var = abs(t_var), f_pos))
        else if dcheck = 0
        then ratsimp(subst(t_var = abs(t_var), f_pos))
        /* ── odd-function case: f_pos(t) = -f_neg(-t)  =>  fn_flip + f_pos = 0
           Combined form: sgn(t) * f_pos(|t|), e.g. IFT(ω/(a²+ω²)) = (i/2)·sgn(t)·e^{-a|t|} */
        else if ratsimp(fn_flip + f_pos) = 0
        then ratsimp(sgn(t_var) * subst(t_var = abs(t_var), f_pos))
        else if ratsimp(f_neg) = 0 then f_pos * u(t_var)
        /* f_pos = 0: signal is non-zero only for t < 0 (anti-causal).
           Combined form must gate on t < 0, i.e. u(-t), NOT u(t). */
        else if ratsimp(f_pos) = 0 then f_neg * u(-t_var)
        else false,

    _ift_reserved: [t_var, w_var, 'u, 'delta, 'sgn],
    _ift_ref: if f_combined # false then f_combined else f_pos + f_neg,

    /* Collect params from input limits/exprs to catch params that cancel out of result */
    _input_params: [],
    for _ii : 1 thru length(FUNC_INPUT) do (
        _input_params: append(_input_params,
            listofvars(FUNC_INPUT[_ii][1]),
            listofvars(FUNC_INPUT[_ii][2]),
            listofvars(FUNC_INPUT[_ii][3]))
    ),
    block([_fp_result, _fp_input, _sym],
        _fp_result: FT_free_params(_ift_ref, _ift_reserved),
        _fp_input: [],
        for _sym in _input_params do (
            if not numberp(_sym) and not member(_sym, _ift_reserved)
               and not member(_sym, _fp_input) then
                _fp_input: append(_fp_input, [_sym])
        ),
        free_params: listify(setify(append(_fp_result, _fp_input)))
    ),

    [f_pos, f_neg, f_combined, free_params]
)$