/* ═══════════════════════════════════════════════════════════════
   Transformada Continua de Fourier
   Input:  FUNC_INPUT  → matrix con tramos [expr, a, b]
           INTVAR      → variable de integración (default t)
           TRANSVAR    → variable de transformada (default w)
   Convención de ingeniería: F(w) = integral f(t)*exp(-i*w*t)dt
   ═══════════════════════════════════════════════════════════════ */

display2d: false$
%iargs: false$
/* Prevent Maxima from splitting sqrt(a*b) → sqrt(a)*sqrt(b).
   Without this, sqrt(2*%pi) renders as \sqrt{2}\,\sqrt{\pi} in TeX. */
radexpand: false$

load("CLEAN_INTEGRAL_PATH")$
load("LIB_PATH")$

/* FT_SCALE is injected by the service (e.g. 1, 1/sqrt(2*%pi)).
   Default to engineering convention (factor = 1) if not provided. */
if not(boundp('FT_SCALE)) then FT_SCALE: 1$

result : FT(FUNC_INPUT, INTVAR, TRANSVAR)$

/* Apply FT_SCALE and ratsimp.
   When delta is present, ratsimp merges rational+delta addends into a single
   fraction.  Instead, apply ratsimp separately to the rational part and scale
   the delta terms by ratsimp(FT_SCALE) to keep the table-form display. */
FT_apply_scale(e, sc) := block([_terms, _dt, _rt, _r],
    if e = false then return(false),
    if freeof('delta, e) then return(ratsimp(sc * e)),
    if sc = 1 then return(e),
    _terms : if atom(e) or not is(op(e) = "+") then [e] else args(e),
    _dt : [], _rt : [],
    for _t in _terms do (
        if freeof('delta, _t) then _rt : cons(_t, _rt)
        else _dt : cons(_t, _dt)
    ),
    _r : if _rt = [] then 0 else ratsimp(sc * apply("+", _rt)),
    _r + ratsimp(sc) * apply("+", _dt)
)$

F      : FT_apply_scale(result[1], FT_SCALE)$
F_real : FT_apply_scale(result[2], FT_SCALE)$
F_imag : FT_apply_scale(result[3], FT_SCALE)$
exists      : result[4]$
free_params : result[5]$

/* ── sech display: capture pre-ratsimp forms for expressions containing cosh.
   ratsimp merges 1/cosh(a)+1/cosh(b) into a single fraction, destroying the
   1/cosh pattern that FT_to_sech needs.  We store the sech-rewritten form
   here so it can be emitted as DISPLAY_F (shown in "Otras formas" in the UI)
   while F keeps the ratsimp'd 1/cosh form for numerical evaluation (plotter). */
F_sech_disp : if result[1] # false and not freeof(cosh, result[1])
              then errcatch(FT_to_sech(FT_SCALE * result[1]))
              else []$
F_sech_disp : if F_sech_disp # [] then first(F_sech_disp) else false$

F_real_sech_disp : if result[2] # false and not freeof(cosh, result[2])
                   then errcatch(FT_to_sech(FT_SCALE * result[2]))
                   else []$
F_real_sech_disp : if F_real_sech_disp # [] then first(F_real_sech_disp) else false$

F_imag_sech_disp : if result[3] # false and not freeof(cosh, result[3])
                   then errcatch(FT_to_sech(FT_SCALE * result[3]))
                   else []$
F_imag_sech_disp : if F_imag_sech_disp # [] then first(F_imag_sech_disp) else false$

/* ── tanh alt display: rewrite tanh(u) → sinh(2u)/(cosh(2u)+1) for "Otras formas".
   F keeps the canonical tanh form for the plotter; F_tanh_alt_disp holds the
   sinh/(cosh+1) alternative shown in the UI.  Unlike sech, ratsimp does not
   destroy tanh structure, so we apply FT_to_tanh_alt on the already-ratsimp'd F
   (no pre-ratsimp capture needed). */
F_tanh_alt_disp : if F # false and not freeof('tanh, F)
                  then errcatch(FT_to_tanh_alt(F))
                  else []$
F_tanh_alt_disp : if F_tanh_alt_disp # [] then first(F_tanh_alt_disp) else false$

F_real_tanh_alt_disp : if F_real # false and not freeof('tanh, F_real)
                       then errcatch(FT_to_tanh_alt(F_real))
                       else []$
F_real_tanh_alt_disp : if F_real_tanh_alt_disp # [] then first(F_real_tanh_alt_disp) else false$

F_imag_tanh_alt_disp : if F_imag # false and not freeof('tanh, F_imag)
                       then errcatch(FT_to_tanh_alt(F_imag))
                       else []$
F_imag_tanh_alt_disp : if F_imag_tanh_alt_disp # [] then first(F_imag_tanh_alt_disp) else false$

/* ── Real / imaginary parts of the input f(t) for post-calc plotting ── */
block([_i, _e, _a, _b, _gate],
        f_in_expr : 0,
        for _i : 1 thru length(FUNC_INPUT) do (
                _e : FUNC_INPUT[_i][1],
                _a : FUNC_INPUT[_i][2],
                _b : FUNC_INPUT[_i][3],
                _gate : if FT_is_minf(_a) and FT_is_inf(_b) then 1
                                else if FT_is_minf(_a) then u(_b-INTVAR)
                                else if FT_is_inf(_b) then u(INTVAR-_a)
                                else (u(INTVAR-_a)-u(INTVAR-_b)),
                f_in_expr : f_in_expr + _e*_gate
        )
)$

F_in_real_raw : if freeof(%i, f_in_expr) then f_in_expr else realpart(f_in_expr)$
F_in_imag_raw : if freeof(%i, f_in_expr) then 0 else imagpart(f_in_expr)$

F_in_real : errcatch(ratsimp(F_in_real_raw))$
F_in_real : if F_in_real = [] then false else first(F_in_real)$
F_in_imag : errcatch(ratsimp(F_in_imag_raw))$
F_in_imag : if F_in_imag = [] then false else first(F_in_imag)$

/* For results with a sech or tanh-alt form, use it directly as the display
   expression (bypassing FT_pick_display_expr).
   Priority: sech > tanh_alt > normal display pipeline.
   - sech: must bypass FT_pick_display_expr because ratsimp already merged
     1/cosh(a)+1/cosh(b) into a single fraction (captured pre-ratsimp above).
   - tanh_alt: F already has the canonical tanh form; tanh_alt is an explicit
     alternative for "Otras formas", so we use it directly rather than letting
     FT_pick_display_expr transform it (which would invert principal/alternate). */
block([_tmp_fd],
    if F_sech_disp # false then F_disp: F_sech_disp
    else if F_tanh_alt_disp # false then F_disp: F_tanh_alt_disp
    else (_tmp_fd: errcatch(FT_pick_display_expr(F)),
          F_disp: if _tmp_fd = [] then F else first(_tmp_fd)))$
block([_tmp_frd],
    if F_real_sech_disp # false then F_real_disp: F_real_sech_disp
    else if F_real_tanh_alt_disp # false then F_real_disp: F_real_tanh_alt_disp
    else (_tmp_frd: errcatch(FT_pick_display_expr(F_real)),
          F_real_disp: if _tmp_frd = [] then F_real else first(_tmp_frd)))$
block([_tmp_fid],
    if F_imag_sech_disp # false then F_imag_disp: F_imag_sech_disp
    else if F_imag_tanh_alt_disp # false then F_imag_disp: F_imag_tanh_alt_disp
    else (_tmp_fid: errcatch(FT_pick_display_expr(F_imag)),
          F_imag_disp: if _tmp_fid = [] then F_imag else first(_tmp_fid)))$
F_in_real_disp : errcatch(FT_pick_display_expr(F_in_real))$
F_in_real_disp : if F_in_real_disp = [] then F_in_real else first(F_in_real_disp)$
F_in_imag_disp : errcatch(FT_pick_display_expr(F_in_imag))$
F_in_imag_disp : if F_in_imag_disp = [] then F_in_imag else first(F_in_imag_disp)$

print("__EXISTS__")$       print(string(exists))$
print("__F_MAXIMA__")$     print(string(F))$
print("__F_TEX__")$        tex(F)$
print("__REAL_MAXIMA__")$  print(string(F_real))$
print("__REAL_TEX__")$     tex(F_real)$
print("__IMAG_MAXIMA__")$  print(string(F_imag))$
print("__IMAG_TEX__")$     tex(F_imag)$
print("__INPUT_REAL_MAXIMA__")$ print(string(F_in_real))$
print("__INPUT_REAL_TEX__")$    if F_in_real # false then tex(F_in_real) else print("")$
print("__INPUT_IMAG_MAXIMA__")$ print(string(F_in_imag))$
print("__INPUT_IMAG_TEX__")$    if F_in_imag # false then tex(F_in_imag) else print("")$
print("__DISPLAY_F_MAXIMA__")$      print(string(F_disp))$
print("__DISPLAY_F_TEX__")$         if F_disp # false and string(F_disp) # string(F) then tex(F_disp) else print("")$
print("__DISPLAY_REAL_MAXIMA__")$   print(string(F_real_disp))$
print("__DISPLAY_REAL_TEX__")$      if F_real_disp # false and string(F_real_disp) # string(F_real) then tex(F_real_disp) else print("")$
print("__DISPLAY_IMAG_MAXIMA__")$   print(string(F_imag_disp))$
print("__DISPLAY_IMAG_TEX__")$      if F_imag_disp # false and string(F_imag_disp) # string(F_imag) then tex(F_imag_disp) else print("")$
print("__DISPLAY_INPUT_REAL_MAXIMA__")$ print(string(F_in_real_disp))$
print("__DISPLAY_INPUT_REAL_TEX__")$    if F_in_real_disp # false and string(F_in_real_disp) # string(F_in_real) then tex(F_in_real_disp) else print("")$
print("__DISPLAY_INPUT_IMAG_MAXIMA__")$ print(string(F_in_imag_disp))$
print("__DISPLAY_INPUT_IMAG_TEX__")$    if F_in_imag_disp # false and string(F_in_imag_disp) # string(F_in_imag) then tex(F_in_imag_disp) else print("")$
print("__PARAMS__")$       print(string(free_params))$