/* laplace_direct.mac
   Computes F(s) = ∫ f(t) e^{-st} dt for a piecewise function.
   Strategy per segment:
     - finite [a,b]: direct integration  ∫_a^b expr·e^{-st} dt
     - [0,inf):       laplace(expr, t, s)  (no sign queries)
     - [a,inf) a≠0:   exp(-a·s) · laplace(expr(t+a), t, s)  (time-shift)
   Injected: FUNC_INPUT (matrix of [expr, a, b] rows), INTVAR (t), TRANSVAR (s)
*/
display2d: false$
%iargs:    false$
radexpand: false$
assume(TRANSVAR > 0)$

/* Normalize: substitute u() → heaviside() in the input matrix so both
   notations work. subst replaces the function symbol before evaluation. */
FUNC_INPUT: subst('u = 'heaviside, FUNC_INPUT)$

/* Declare free parameters so laplace() doesn't hang on sign queries.
   Variables named n, m, k are declared integer >= 0 (for t^n patterns).
   All other free params are assumed positive (covers a, b, etc.). */
block([_allvars, _reserved, _freevars],
  _allvars: listofvars(FUNC_INPUT),
  _reserved: [INTVAR, TRANSVAR],
  _freevars: sublist(_allvars, lambda([_v], not member(_v, _reserved))),
  for _v in _freevars do (
    if member(_v, [n, m, k]) then (
      declare(_v, integer),
      assume(_v >= 0)
    ) else
      assume(_v > 0)
  )
)$

/* Helper: L{expr} handling heaviside() by splitting the integral at the
   heaviside shift point instead of passing heaviside to laplace(). */
_laplace_seg(expr, t, s, a, b) := block(
  [_factors, _hw, _other, _shift, _lower, _fi, _terms, _acc, _term_fi, _failed],
  if freeof('heaviside, expr) then block(
    /* No heaviside — use regular laplace() for [0,inf), integrate otherwise */
    if b = inf and (a = 0 or a = 0.0) then
      errcatch(laplace(expr, t, s))
    else if b = inf then block(
      _shifted: subst(t = t + a, expr),
      _fi: errcatch(laplace(_shifted, t, s)),
      if _fi = [] then [] else [exp(-a*s) * first(_fi)]
    ) else
      errcatch(integrate(expr * exp(-s*t), t, a, b))
  ) elseif op(expr) = "-" then block(
    /* Unary negation (e.g. -10*heaviside(t-8), which Maxima represents as
       op="-" with a single positive-coefficient argument, NOT as op="*").
       Recurse on the negated term and flip the sign of the result — without
       this, the negated term fell through to the "else [expr]" branch below,
       treating "-10*heaviside(t-8)" as one indivisible factor and extracting
       a bogus shift point from it, silently producing F(s)=0. */
    _fi: _laplace_seg(-expr, t, s, a, b),
    if _fi = [] then [] else [-first(_fi)]
  ) elseif op(expr) = "+" then block(
    /* Sum of terms (e.g. 3 + 7*heaviside(t-5) - 10*heaviside(t-8)) — apply
       linearity: Laplace each summand independently (recursing so a summand
       that is itself a heaviside product is still handled below) and add.
       Without this, treating the whole sum as a single "factor" made the
       shift-point extraction below operate on the sum itself rather than on
       an individual heaviside(...) term, silently collapsing the result. */
    _terms: args(expr),
    _acc: 0,
    _failed: false,
    for _term in _terms do (
      if not _failed then (
        _term_fi: _laplace_seg(_term, t, s, a, b),
        if _term_fi = [] then _failed: true
        else _acc: _acc + first(_term_fi)
      )
    ),
    if _failed then [] else [_acc]
  ) else block(
    /* Has heaviside: decompose f(t)*heaviside(t-c) and integrate from c to b */
    _factors: if atom(expr) then [expr]
              else if op(expr) = "*" then args(expr) else [expr],
    _hw:    sublist(_factors, lambda([f], not freeof('heaviside, f))),
    _other: sublist(_factors, lambda([f], freeof('heaviside, f))),
    if length(_hw) = 0 then errcatch(integrate(expr*exp(-s*t), t, a, b))
    else block(
      _shift: first(args(first(_hw))),     /* t-c or t */
      _lower: -ratsimp(_shift - t),        /* c (= 0 when heaviside(t)) */
      _other: if length(_other) = 0 then 1 else apply("*", _other),
      /* effective lower bound is max(a, _lower) */
      _lower: if _lower > a then _lower else a,
      if b = inf then block(
        /* Prefer laplace() with a time-shift over a raw improper integral:
           integrate() on [_lower, inf) can hit Maxima sign queries it can't
           resolve on its own (e.g. (t-c)*exp(t-c) needs "is s-1 positive?"
           to confirm convergence, which errcatch can't answer, so it just
           fails). laplace() already carries the convergence conditions
           for the standard forms (t^n, exp(at), trig, products thereof)
           without asking, mirroring the no-heaviside branch above. */
        _shifted: subst(t = t + _lower, _other),
        _fi: errcatch(laplace(_shifted, t, s)),
        if _fi = [] or first(_fi) = false then
          /* Fall back to direct integration for forms laplace() can't match */
          errcatch(integrate(_other * exp(-s*t), t, _lower, b))
        else [exp(-_lower*s) * first(_fi)]
      ) else
        errcatch(integrate(_other * exp(-s*t), t, _lower, b))
    )
  )
)$

F_acc: 0$
for _i: 1 thru length(FUNC_INPUT) do block(
  [_e, _a, _b, _fi],
  _e: FUNC_INPUT[_i][1],
  _a: FUNC_INPUT[_i][2],
  _b: FUNC_INPUT[_i][3],

  /* Laplace integrates from 0 to inf — clamp lower bound */
  if _a = minf then _a: 0,

  _fi: _laplace_seg(_e, INTVAR, TRANSVAR, _a, _b),
  if _fi # [] then F_acc: F_acc + first(_fi)
)$

F_raw: errcatch(ratsimp(F_acc))$
F_raw: if F_raw = [] then false else first(F_raw)$

exists: is(F_raw # false)$

/* Extract free parameters (symbols other than INTVAR and TRANSVAR) */
free_params: []$
if exists then block([_vars, _reserved],
  _vars: listofvars(F_raw),
  _reserved: [INTVAR, TRANSVAR],
  free_params: sublist(_vars, lambda([_v], not member(_v, _reserved)))
)$

print("__EXISTS__")$   print(string(exists))$
print("__F_MAXIMA__")$ print(string(F_raw))$
print("__F_TEX__")$    if exists then tex(F_raw) else print("")$
print("__PARAMS__")$   print(string(free_params))$
